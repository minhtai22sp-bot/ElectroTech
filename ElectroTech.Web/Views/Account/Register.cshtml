@model Entities.ViewModel.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ElectroTech | Đăng ký</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { fontFamily: { sans: ['DM Sans', 'Inter', 'sans-serif'] } } }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #f0efed;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background-image: radial-gradient(circle, #d8d5d0 1px, transparent 1px);
                background-size: 28px 28px;
                opacity: .45;
                pointer-events: none;
                z-index: 0;
            }

        .input-field {
            width: 100%;
            height: 44px;
            background: #fff;
            border: 1.5px solid #e8e8e6;
            border-radius: 12px;
            padding: 0 14px;
            font-size: 14px;
            font-family: inherit;
            color: #111;
            outline: none;
            transition: border-color .18s, box-shadow .18s;
        }

            .input-field::placeholder {
                color: #bbb;
            }

            .input-field:focus {
                border-color: #f97316;
                box-shadow: 0 0 0 3px rgba(249,115,22,.1);
            }

        .field-error {
            font-size: 11px;
            color: #ef4444;
            margin-top: 4px;
            display: block;
        }

        .field-label {
            display: block;
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .16em;
            color: #aaa;
            margin-bottom: 6px;
        }
    </style>
</head>
<body>

    <main class="relative z-10 flex-grow flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-[520px]">

            <!-- Logo -->
            <div class="text-center mb-8">
                <a asp-controller="Home" asp-action="Index"
                   class="text-[1.6rem] font-black tracking-tight text-[#111] no-underline">
                    Electro<span class="text-orange-500">Tech</span>
                </a>
                <p class="text-[11px] font-bold uppercase tracking-[.26em] text-[#bbb] mt-1">
                    Premium Tech Store
                </p>
            </div>

            <!-- Card -->
            <div class="bg-white rounded-3xl border border-[#e8e8e6]
                    shadow-[0_24px_64px_rgba(0,0,0,.07)] overflow-hidden">

                <div class="h-1" style="background:linear-gradient(90deg,#f97316,#fb923c);"></div>

                <div class="px-8 py-8">

                    <!-- Header -->
                    <div class="mb-7">
                        <p class="text-[10px] font-black uppercase tracking-[.26em] text-orange-500 mb-1">
                            Tài khoản mới
                        </p>
                        <h1 class="text-[1.7rem] font-black tracking-tight text-[#111] leading-tight">
                            Tạo tài khoản<br />
                            <span class="text-orange-500">ElectroTech</span>
                        </h1>
                    </div>

                    @if (TempData["DebugError"] != null)
                    {
                        <div class="mb-5 p-3.5 rounded-xl flex items-start gap-2.5 bg-red-50 border border-red-200">
                            <span class="material-symbols-outlined text-red-400 shrink-0 mt-0.5" style="font-size:16px;">error</span>
                            <p class="text-[12px] text-red-600 font-semibold">@TempData["DebugError"]</p>
                        </div>
                    }

                    <form asp-action="Register" asp-controller="Account" method="post"
                          id="form-register" class="space-y-4">
                        @Html.AntiForgeryToken()

                        <!-- Full Name -->
                        <div>
                            <label asp-for="FullName" class="field-label">Họ và tên</label>
                            <input asp-for="FullName" class="input-field" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="FullName" class="field-error"></span>
                        </div>

                        <!-- Email -->
                        <div>
                            <label asp-for="Email" class="field-label">Email</label>
                            <input asp-for="Email" type="email" class="input-field" placeholder="ten@email.com" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>

                        <!-- Password + Confirm — 2 cols -->
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label asp-for="Password" class="field-label">Mật khẩu</label>
                                <input asp-for="Password" type="password" class="input-field" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="field-error"></span>
                            </div>
                            <div>
                                <label asp-for="ConfirmPassword" class="field-label">Xác nhận</label>
                                <input asp-for="ConfirmPassword" type="password" class="input-field" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                            </div>
                        </div>

                        <!-- Phone + Address — 2 cols -->
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label asp-for="PhoneNumber" class="field-label">Số điện thoại</label>
                                <input asp-for="PhoneNumber" type="tel" class="input-field" placeholder="0912 345 678" />
                                <span asp-validation-for="PhoneNumber" class="field-error"></span>
                            </div>
                            <div>
                                <label asp-for="Address" class="field-label">Địa chỉ</label>
                                <input asp-for="Address" type="text" class="input-field" placeholder="123 Nguyễn Huệ..." />
                                <span asp-validation-for="Address" class="field-error"></span>
                            </div>
                        </div>

                        <!-- Terms -->
                        <div class="flex items-start gap-2.5 pt-1">
                            <input type="checkbox" id="terms"
                                   class="w-4 h-4 mt-0.5 rounded accent-orange-500 cursor-pointer shrink-0" />
                            <label for="terms" class="text-[12px] text-gray-400 cursor-pointer leading-relaxed">
                                Tôi đồng ý với
                                <a href="#" class="text-orange-500 font-bold no-underline hover:text-orange-600">Điều khoản dịch vụ</a>
                                và
                                <a href="#" class="text-orange-500 font-bold no-underline hover:text-orange-600">Chính sách bảo mật</a>.
                            </label>
                        </div>

                        <!-- Submit -->
                        <button type="submit" id="btn-submit"
                                class="w-full h-[46px] rounded-[14px] bg-orange-500 text-white
                                   text-[14px] font-black tracking-wide
                                   shadow-[0_6px_20px_rgba(249,115,22,.35)]
                                   hover:bg-orange-600 hover:-translate-y-0.5
                                   active:scale-[.98] transition-all duration-200
                                   flex items-center justify-center gap-2 cursor-pointer border-none mt-2">
                            <span id="btn-text">Tạo tài khoản</span>
                            <span class="material-symbols-outlined" id="btn-icon" style="font-size:18px;">arrow_forward</span>
                        </button>

                    </form>

                    <!-- Divider -->
                    <div class="flex items-center gap-3 my-6">
                        <div class="flex-1 h-px bg-[#eeece9]"></div>
                        <span class="text-[10px] font-black uppercase tracking-widest text-[#ccc]">hoặc</span>
                        <div class="flex-1 h-px bg-[#eeece9]"></div>
                    </div>

                    <!-- Login link -->
                    <p class="text-center text-[13px] text-gray-400">
                        Đã có tài khoản?
                        <a asp-controller="Account" asp-action="Login"
                           class="font-black text-orange-500 no-underline hover:text-orange-600 transition-colors ml-1">
                            Đăng nhập →
                        </a>
                    </p>

                </div>
            </div>

            <!-- Back -->
            <div class="text-center mt-5">
                <a asp-controller="Home" asp-action="Index"
                   class="text-[12px] font-bold text-[#bbb] no-underline hover:text-orange-500 transition-colors">
                    ← Quay về trang chủ
                </a>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="relative z-10 border-t border-[#e8e8e6] py-5 px-6 bg-white/60 backdrop-blur-sm">
        <div class="max-w-[520px] mx-auto flex justify-between items-center">
            <span class="text-[11px] text-[#bbb]">© @DateTime.Now.Year ElectroTech</span>
            <div class="flex gap-5">
                <a href="#" class="text-[11px] text-[#bbb] no-underline hover:text-orange-500 transition-colors">Privacy</a>
                <a href="#" class="text-[11px] text-[#bbb] no-underline hover:text-orange-500 transition-colors">Terms</a>
            </div>
        </div>
    </footer>

    <script>
        document.getElementById('form-register').addEventListener('submit', function (e) {
            const terms = document.getElementById('terms');
            if (!terms.checked) {
                e.preventDefault();
                terms.style.outline = '2px solid #ef4444';
                terms.style.outlineOffset = '2px';
                setTimeout(() => { terms.style.outline = ''; terms.style.outlineOffset = ''; }, 2000);
                return false;
            }
            const btn = document.getElementById('btn-submit');
            const text = document.getElementById('btn-text');
            const icon = document.getElementById('btn-icon');
            text.textContent = 'Đang tạo tài khoản...';
            icon.textContent = 'hourglass_empty';
            btn.disabled = true;
            btn.style.opacity = '.75';
        });
    </script>
</body>
</html>
