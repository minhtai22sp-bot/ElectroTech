@model Entities.ViewModel.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ElectroTech | Đăng nhập</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { fontFamily: { sans: ['DM Sans', 'Inter', 'sans-serif'] } } }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #f0efed;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

            /* Subtle dot grid */
            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background-image: radial-gradient(circle, #d8d5d0 1px, transparent 1px);
                background-size: 28px 28px;
                opacity: .45;
                pointer-events: none;
                z-index: 0;
            }

        .input-field {
            width: 100%;
            height: 44px;
            background: #fff;
            border: 1.5px solid #e8e8e6;
            border-radius: 12px;
            padding: 0 14px;
            font-size: 14px;
            font-family: inherit;
            color: #111;
            outline: none;
            transition: border-color .18s, box-shadow .18s;
        }

            .input-field::placeholder {
                color: #bbb;
            }

            .input-field:focus {
                border-color: #f97316;
                box-shadow: 0 0 0 3px rgba(249,115,22,.1);
            }

        .field-error {
            font-size: 11px;
            color: #ef4444;
            margin-top: 4px;
            display: block;
        }
    </style>
</head>
<body>

    <main class="relative z-10 flex-grow flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-[420px]">

            <!-- Logo -->
            <div class="text-center mb-8">
                <a asp-controller="Home" asp-action="Index"
                   class="text-[1.6rem] font-black tracking-tight text-[#111] no-underline">
                    Electro<span class="text-orange-500">Tech</span>
                </a>
                <p class="text-[11px] font-bold uppercase tracking-[.26em] text-[#bbb] mt-1">
                    Premium Tech Store
                </p>
            </div>

            <!-- Card -->
            <div class="bg-white rounded-3xl border border-[#e8e8e6]
                    shadow-[0_24px_64px_rgba(0,0,0,.07)] overflow-hidden">

                <!-- Top accent -->
                <div class="h-1" style="background:linear-gradient(90deg,#f97316,#fb923c);"></div>

                <div class="px-8 py-8">

                    <!-- Header -->
                    <div class="mb-7">
                        <p class="text-[10px] font-black uppercase tracking-[.26em] text-orange-500 mb-1">
                            Tài khoản
                        </p>
                        <h1 class="text-[1.7rem] font-black tracking-tight text-[#111] leading-tight">
                            Chào mừng<br />trở lại!
                        </h1>
                    </div>

                    <!-- Server error -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="mb-5 p-3.5 rounded-xl flex items-start gap-2.5
                                bg-red-50 border border-red-200">
                            <span class="material-symbols-outlined text-red-400 shrink-0 mt-0.5"
                                  style="font-size:16px;">error</span>
                            <div>
                                @Html.ValidationSummary(false, "", new { @class = "text-[12px] text-red-600 font-semibold" })
                            </div>
                        </div>
                    }

                    <form asp-action="Login" asp-controller="Account" method="post"
                          class="space-y-5" id="form-login">
                        @Html.AntiForgeryToken()

                        <!-- Email -->
                        <div>
                            <label asp-for="Email"
                                   class="block text-[11px] font-black uppercase tracking-[.16em] text-[#aaa] mb-1.5">
                                Email
                            </label>
                            <input asp-for="Email" type="email"
                                   placeholder="ten@email.com"
                                   class="input-field" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>

                        <!-- Password -->
                        <div>
                            <label asp-for="Password"
                                   class="block text-[11px] font-black uppercase tracking-[.16em] text-[#aaa] mb-1.5">
                                Mật khẩu
                            </label>
                            <div class="relative">
                                <input asp-for="Password" type="password"
                                       id="passwordInput"
                                       placeholder="••••••••"
                                       class="input-field pr-11" />
                                <button type="button" onclick="togglePassword()"
                                        class="absolute right-3.5 top-1/2 -translate-y-1/2
                                           text-gray-300 hover:text-orange-500 transition-colors">
                                    <span class="material-symbols-outlined" id="eye-icon"
                                          style="font-size:18px;">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="field-error"></span>
                        </div>

                        <!-- Remember -->
                        <div class="flex items-center gap-2.5">
                            <input asp-for="Remember" type="checkbox"
                                   class="w-4 h-4 rounded accent-orange-500 cursor-pointer" />
                            <label asp-for="Remember"
                                   class="text-[12px] font-semibold text-gray-400 cursor-pointer">
                                Ghi nhớ đăng nhập
                            </label>
                        </div>

                        <!-- Submit -->
                        <button type="submit" id="btn-submit"
                                class="w-full h-[46px] rounded-[14px] bg-orange-500 text-white
                                   text-[14px] font-black tracking-wide
                                   shadow-[0_6px_20px_rgba(249,115,22,.35)]
                                   hover:bg-orange-600 hover:-translate-y-0.5
                                   active:scale-[.98] transition-all duration-200
                                   flex items-center justify-center gap-2 cursor-pointer border-none">
                            <span id="btn-text">Đăng nhập</span>
                            <span class="material-symbols-outlined" id="btn-icon" style="font-size:18px;">arrow_forward</span>
                        </button>

                    </form>

                    <!-- Divider -->
                    <div class="flex items-center gap-3 my-6">
                        <div class="flex-1 h-px bg-[#eeece9]"></div>
                        <span class="text-[10px] font-black uppercase tracking-widest text-[#ccc]">hoặc</span>
                        <div class="flex-1 h-px bg-[#eeece9]"></div>
                    </div>

                    <!-- Register -->
                    <p class="text-center text-[13px] text-gray-400">
                        Chưa có tài khoản?
                        <a asp-controller="Account" asp-action="Register"
                           class="font-black text-orange-500 no-underline hover:text-orange-600 transition-colors ml-1">
                            Đăng ký ngay →
                        </a>
                    </p>

                </div>
            </div>

            <!-- Back -->
            <div class="text-center mt-5">
                <a asp-controller="Home" asp-action="Index"
                   class="text-[12px] font-bold text-[#bbb] no-underline hover:text-orange-500 transition-colors">
                    ← Quay về trang chủ
                </a>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="relative z-10 border-t border-[#e8e8e6] py-5 px-6 bg-white/60 backdrop-blur-sm">
        <div class="max-w-[420px] mx-auto flex justify-between items-center">
            <span class="text-[11px] text-[#bbb]">© @DateTime.Now.Year ElectroTech</span>
            <div class="flex gap-5">
                <a href="#" class="text-[11px] text-[#bbb] no-underline hover:text-orange-500 transition-colors">Privacy</a>
                <a href="#" class="text-[11px] text-[#bbb] no-underline hover:text-orange-500 transition-colors">Terms</a>
            </div>
        </div>
    </footer>

    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('eye-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        document.getElementById('form-login').addEventListener('submit', () => {
            const btn = document.getElementById('btn-submit');
            const text = document.getElementById('btn-text');
            const icon = document.getElementById('btn-icon');
            text.textContent = 'Đang đăng nhập...';
            icon.textContent = 'hourglass_empty';
            btn.disabled = true;
            btn.style.opacity = '.75';
        });
    </script>
</body>
</html>
