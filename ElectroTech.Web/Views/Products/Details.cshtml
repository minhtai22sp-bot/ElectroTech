@model Entities.Product
@{
    ViewData["Title"] = Model.Name;
    var approvedCount = Model.Reviews?.Count(r => r.IsApproved) ?? 0;
    var showReviewForm = ViewBag.ShowReviewForm == true;
    var reviewOrderId = ViewBag.OrderId as int?;
}

@Html.AntiForgeryToken()

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .pd-root {
        background: #f7f6f3;
        min-height: 100vh;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #111;
    }

    /* Breadcrumb */
    .pd-crumb a {
        color: #bbb;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        transition: color .15s;
    }

        .pd-crumb a:hover {
            color: #111;
        }

    .pd-crumb .sep {
        color: #ddd;
        margin: 0 6px;
        font-size: 12px;
    }

    .pd-crumb .cur {
        color: #555;
        font-size: 12px;
        font-weight: 700;
    }

    /* Image gallery */
    .pd-img-main {
        background: #fff;
        border-radius: 24px;
        border: 1px solid #ebebeb;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px;
        overflow: hidden;
        cursor: zoom-in;
        transition: box-shadow .2s;
    }

        .pd-img-main:hover {
            box-shadow: 0 12px 40px rgba(0,0,0,.08);
        }

    .pd-img-thumb {
        background: #fff;
        border-radius: 12px;
        border: 2px solid #ebebeb;
        aspect-ratio: 1;
        cursor: pointer;
        padding: 5px;
        overflow: hidden;
        transition: border-color .18s, transform .15s;
    }

        .pd-img-thumb:hover {
            transform: translateY(-2px);
            border-color: #f97316;
        }

        .pd-img-thumb.active {
            border-color: #f97316;
            box-shadow: 0 0 0 3px rgba(249,115,22,.15);
        }

    /* Badges */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 100px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .badge-featured {
        background: #fff3e8;
        color: #f97316;
        border: 1px solid #fed7aa;
    }

    .badge-instock {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
    }

    .badge-outstock {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    /* Price box */
    .pd-price {
        background: #fff;
        border: 1px solid #ebebeb;
        border-radius: 18px;
        padding: 20px 22px;
    }

    /* Spec chips */
    .spec-chip {
        background: #fff;
        border: 1px solid #ebebeb;
        border-radius: 14px;
        padding: 12px 14px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        transition: border-color .18s, box-shadow .18s;
    }

        .spec-chip:hover {
            border-color: #f97316;
            box-shadow: 0 4px 16px rgba(249,115,22,.08);
        }

    /* Qty control */
    .qty-wrap {
        display: flex;
        align-items: center;
        background: #fff;
        border: 1.5px solid #e2e2e2;
        border-radius: 12px;
        overflow: hidden;
        transition: border-color .18s;
    }

        .qty-wrap:focus-within {
            border-color: #f97316;
        }

    .qty-btn {
        width: 40px;
        height: 40px;
        border: none;
        background: none;
        cursor: pointer;
        color: #bbb;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color .15s, background .15s;
    }

        .qty-btn:hover {
            color: #f97316;
            background: #fff3e8;
        }

        .qty-btn:disabled {
            opacity: .3;
            cursor: not-allowed;
        }

    .qty-num {
        width: 44px;
        text-align: center;
        font-weight: 900;
        font-size: 15px;
        color: #111;
        user-select: none;
    }

    /* CTA buttons */
    .btn-cart {
        flex: 1;
        padding: 15px 22px;
        border: none;
        border-radius: 14px;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: #f97316;
        color: #fff;
        transition: all .22s;
        box-shadow: 0 6px 20px rgba(249,115,22,.32);
    }

        .btn-cart:hover:not(:disabled) {
            background: #ea6600;
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(249,115,22,.42);
        }

        .btn-cart:disabled {
            background: #f0f0f0;
            color: #ccc;
            box-shadow: none;
            cursor: not-allowed;
        }

    .btn-wish {
        width: 52px;
        height: 52px;
        border: 1.5px solid #e2e2e2;
        border-radius: 14px;
        background: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ccc;
        transition: all .18s;
    }

        .btn-wish:hover {
            color: #ef4444;
            border-color: #fca5a5;
            background: #fff5f5;
        }

    /* Tabs */
    .tab-btn {
        padding: 11px 22px;
        border: none;
        background: none;
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
        color: #bbb;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        display: flex;
        align-items: center;
        gap: 7px;
        transition: all .18s;
        font-family: inherit;
    }

        .tab-btn.active {
            color: #f97316;
            border-bottom-color: #f97316;
        }

        .tab-btn:hover:not(.active) {
            color: #555;
        }

    /* Spec table */
    .spec-group {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #ebebeb;
    }

    .spec-group-head {
        background: #fff3e8;
        padding: 10px 22px;
        border-bottom: 1px solid #fed7aa;
    }

        .spec-group-head h3 {
            color: #f97316;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .18em;
            margin: 0;
        }

    .spec-row-even {
        background: #fff;
    }

    .spec-row-odd {
        background: #fafafa;
    }

    /* Review form */
    .review-form-wrap {
        background: #fff;
        border: 1px solid #ebebeb;
        border-radius: 20px;
        padding: 26px;
        margin-bottom: 24px;
    }

    .review-input {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #e2e2e2;
        border-radius: 11px;
        font-size: 13px;
        color: #111;
        outline: none;
        font-family: inherit;
        transition: border-color .18s;
        background: #fafafa;
    }

        .review-input:focus {
            border-color: #f97316;
            background: #fff;
        }

        .review-input::placeholder {
            color: #ccc;
        }

    /* Review cards */
    .review-card {
        background: #fff;
        border: 1px solid #ebebeb;
        border-radius: 16px;
        padding: 20px 22px;
    }

    /* Toast */
    #cartToast {
        position: fixed;
        bottom: 28px;
        right: 28px;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px 18px;
        border-radius: 18px;
        background: #fff;
        min-width: 290px;
        border: 1px solid #ebebeb;
        box-shadow: 0 16px 48px rgba(0,0,0,.1);
        opacity: 0;
        transform: translateY(14px);
        transition: all .3s cubic-bezier(.34,1.56,.64,1);
        pointer-events: none;
    }

    /* Eyebrow line */
    .eyebrow {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: #f97316;
    }

        .eyebrow::before {
            content: '';
            width: 24px;
            height: 2px;
            background: #f97316;
            flex-shrink: 0;
        }
</style>

<main class="pd-root pt-20 pb-24">
    <div style="max-width:1200px; margin:0 auto; padding:0 40px;">

        <!-- Breadcrumb -->
        <nav class="pd-crumb" style="display:flex; align-items:center; margin-bottom:32px; padding-top:24px;">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span class="sep">›</span>
            <a asp-controller="Products" asp-action="Index">Sản phẩm</a>
            <span class="sep">›</span>
            <span class="cur">@Model.Name</span>
        </nav>

        <!-- ══ MAIN GRID ══ -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:52px; margin-bottom:72px; align-items:start;">

            <!-- LEFT: Images -->
            <div>
                <div class="pd-img-main" style="margin-bottom:12px;">
                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                    {
                        <img id="mainImage" src="@Model.ThumbnailUrl" alt="@Model.Name"
                             style="width:100%; height:100%; object-fit:contain; transition:opacity .2s;" />
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size:72px; color:#ddd;">image_not_supported</span>
                    }
                </div>

                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                    <div style="display:grid; grid-template-columns:repeat(5,1fr); gap:8px;">
                        <div class="pd-img-thumb active" onclick="changeImage('@Model.ThumbnailUrl', this)">
                            <img src="@Model.ThumbnailUrl" alt="" style="width:100%; height:100%; object-fit:contain;" />
                        </div>
                        @foreach (var img in Model.ProductImages)
                        {
                            <div class="pd-img-thumb" onclick="changeImage('@img.ImageUrl', this)">
                                <img src="@img.ImageUrl" alt="" style="width:100%; height:100%; object-fit:contain;" />
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- RIGHT: Info -->
            <div style="display:flex; flex-direction:column; gap:18px;">

                <!-- Badges -->
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    @if (Model.IsFeatured)
                    {
                        <span class="badge badge-featured">⚡ Nổi bật</span>
                    }
                    @if (Model.Stock <= 0)
                    {
                        <span class="badge badge-outstock">Hết hàng</span>
                    }
                    else
                    {
                        <span class="badge badge-instock">
                            <span style="width:5px; height:5px; background:#16a34a; border-radius:50%; display:inline-block;"></span>
                            Còn hàng (@Model.Stock)
                        </span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Brand))
                {
                    <p class="eyebrow">@Model.Brand</p>
                }

                <h1 style="font-size:1.9rem; font-weight:900; color:#111; line-height:1.15; margin:0; letter-spacing:-.03em;">
                    @Model.Name
                </h1>

                @{
                    var approvedReviews = Model.Reviews?.Where(r => r.IsApproved).ToList() ?? new();
                    var displayRating = approvedReviews.Any()
                    ? Math.Round(approvedReviews.Average(r => (double)r.Rating), 1)
                    : 0.0;
                    var displayCount = approvedReviews.Count;
                }
                <div style="display:flex; align-items:center; gap:8px;">
                    <div style="display:flex; gap:2px;">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span style="font-size:14px; color:@(i<=(int)displayRating?"#f59e0b":"#e5e7eb");">★</span>
                        }
                    </div>
                    <span style="color:#aaa; font-size:12px; font-weight:600;">
                        @displayRating.ToString("0.0") · @displayCount đánh giá
                    </span>
                </div>

                <!-- Price -->
                <div class="pd-price">
                    <div style="display:flex; align-items:baseline; gap:12px; flex-wrap:wrap;">
                        <span style="font-size:2rem; font-weight:900; color:#f97316; letter-spacing:-.03em;">
                            @Model.Price.ToString("N0")₫
                        </span>
                        @if (Model.OriginalPrice.HasValue && Model.OriginalPrice > Model.Price)
                        {
                            var discount = (int)((1 - Model.Price / Model.OriginalPrice.Value) * 100);
                            <span style="font-size:14px; color:#ccc; text-decoration:line-through;">
                                @Model.OriginalPrice.Value.ToString("N0")₫
                            </span>
                            <span style="background:#111; color:#fff; font-size:10px; font-weight:900;
                                     padding:3px 10px; border-radius:100px;">−@discount%</span>
                        }
                    </div>
                </div>

                <!-- Highlight specs -->
                @if (Model.ProductSpecs != null && Model.ProductSpecs.Any())
                {
                    var highlight = new[] { "CPU", "RAM", "Storage", "Refresh Rate", "Rear Camera", "Battery Capacity", "Screen Size", "Processor" };
                    var icons = new Dictionary<string, string>
                {
                    ["CPU"] = "memory",
                    ["Processor"] = "memory",
                    ["RAM"] = "storage",
                    ["Storage"] = "database",
                    ["Screen Size"] = "monitor",
                    ["Refresh Rate"] = "refresh",
                    ["Rear Camera"] = "photo_camera",
                    ["Battery Capacity"] = "battery_full"
                };
                    var hs = Model.ProductSpecs.Where(s => highlight.Contains(s.SpecKey))
                    .OrderBy(s => s.DisplayOrder).Take(4).ToList();
                    if (hs.Any())
                    {
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                            @foreach (var spec in hs)
                            {
                                var ico = icons.ContainsKey(spec.SpecKey) ? icons[spec.SpecKey] : "info";
                                <div class="spec-chip">
                                    <span class="material-symbols-outlined"
                                          style="color:#f97316; font-size:18px; margin-top:1px;">@ico</span>
                                    <div>
                                        <p style="color:#bbb; font-size:9px; font-weight:800; text-transform:uppercase;
                                               letter-spacing:.14em; margin:0 0 3px;">@spec.SpecKey</p>
                                        <p style="color:#111; font-weight:800; font-size:13px; margin:0;">@spec.SpecValue</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p style="color:#888; font-size:13px; line-height:1.75; margin:0;">@Model.Description</p>
                }

                <!-- Quantity -->
                @if (Model.Stock > 0)
                {
                    <div style="display:flex; align-items:center; gap:12px;">
                        <span style="color:#bbb; font-size:11px; font-weight:800;
                                 text-transform:uppercase; letter-spacing:.14em;">Số lượng</span>
                        <div class="qty-wrap">
                            <button type="button" id="btnMinus" class="qty-btn" onclick="changeQty(-1)">
                                <span class="material-symbols-outlined" style="font-size:17px;">remove</span>
                            </button>
                            <span class="qty-num" id="qtyDisplay">1</span>
                            <button type="button" id="btnPlus" class="qty-btn" onclick="changeQty(1)">
                                <span class="material-symbols-outlined" style="font-size:17px;">add</span>
                            </button>
                        </div>
                        <span style="color:#bbb; font-size:12px;">
                            / <span style="color:#555; font-weight:700;">@Model.Stock</span> sản phẩm
                        </span>
                    </div>
                }

                <!-- CTA -->
                <div style="display:flex; gap:10px;">
                    <button id="addToCartBtn" class="btn-cart"
                            data-product-id="@Model.Id" data-max-stock="@Model.Stock"
                    @(Model.Stock <= 0 ? "disabled" : "")>
                        <span class="material-symbols-outlined" style="font-size:19px;">add_shopping_cart</span>
                        <span id="addBtnText">@(Model.Stock > 0 ? "Thêm vào giỏ" : "Hết hàng")</span>
                    </button>
                    <button class="btn-wish">
                        <span class="material-symbols-outlined" style="font-size:21px;">favorite_border</span>
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(Model.Code))
                {
                    <p style="color:#ccc; font-size:12px; margin:0;">
                        SKU: <span style="color:#aaa; font-family:monospace;">@Model.Code</span>
                    </p>
                }
            </div>
        </div>

        <!-- ══ TABS ══ -->
        <div style="margin-bottom:80px;">
            <div style="display:flex; border-bottom:1px solid #ebebeb; margin-bottom:28px;">
                <button id="tab-specs" class="tab-btn @(!showReviewForm ? "active" : "")"
                        onclick="switchTab('specs')">
                    <span class="material-symbols-outlined" style="font-size:17px;">tune</span>
                    Thông số kỹ thuật
                    @if (Model.ProductSpecs != null && Model.ProductSpecs.Any())
                    {
                        <span id="specsBadge"
                              style="background:#fff3e8; color:#f97316; font-size:10px; font-weight:800;
                                 padding:2px 8px; border-radius:100px;">@Model.ProductSpecs.Count</span>
                    }
                </button>
                <button id="tab-reviews" class="tab-btn @(showReviewForm ? "active" : "")"
                        onclick="switchTab('reviews')">
                    <span class="material-symbols-outlined" style="font-size:17px;">star</span>
                    Đánh giá
                    @if (approvedCount > 0)
                    {
                        <span id="reviewBadge"
                              style="background:#f0f0f0; color:#bbb; font-size:10px; font-weight:800;
                                 padding:2px 8px; border-radius:100px;">@approvedCount</span>
                    }
                </button>
            </div>

            <!-- Panel: Thông số -->
            <div id="panel-specs" style="display:@(!showReviewForm ? "block" : "none");">
                @if (Model.ProductSpecs != null && Model.ProductSpecs.Any())
                {
                    var groups = Model.ProductSpecs.OrderBy(s => s.DisplayOrder)
                    .GroupBy(s => string.IsNullOrEmpty(s.GroupName) ? "Thông số chung" : s.GroupName);
                    <div style="display:flex; flex-direction:column; gap:10px;">
                        @foreach (var grp in groups)
                        {
                            var specList = grp.ToList();
                            <div class="spec-group">
                                <div class="spec-group-head"><h3>@grp.Key</h3></div>
                                <table style="width:100%; border-collapse:collapse;">
                                    @for (int idx = 0; idx < specList.Count; idx++)
                                    {
                                        var sp = specList[idx];
                                        <tr class="@(idx%2==0?"spec-row-even":"spec-row-odd")"
                                            style="border-bottom:1px solid #f4f4f4;">
                                            <td style="padding:12px 22px; color:#aaa; font-size:12px;
                                                   font-weight:700; width:40%;">
                                                @sp.SpecKey
                                            </td>
                                            <td style="padding:12px 22px; color:#111; font-size:13px;
                                                   font-weight:600;">
                                                @sp.SpecValue
                                            </td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align:center; padding:56px 0;">
                        <span class="material-symbols-outlined" style="font-size:44px; display:block;
                          margin-bottom:10px; color:#e0e0e0;">tune</span>
                        <p style="font-size:13px; color:#bbb;">Chưa có thông số kỹ thuật.</p>
                    </div>
                }
            </div>

            <!-- Panel: Đánh giá -->
            <div id="panel-reviews" style="display:@(showReviewForm ? "block" : "none");">

                @if (showReviewForm)
                {
                    <div class="review-form-wrap">
                        <h3 style="font-size:14px; font-weight:900; color:#111; margin:0 0 20px;
                               display:flex; align-items:center; gap:8px;">
                            <span class="material-symbols-outlined"
                                  style="color:#f97316; font-size:19px;">edit_note</span>
                            Viết đánh giá của bạn
                        </h3>
                        <form action="/Review/Create" method="post" id="reviewForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <input type="hidden" name="orderId" value="@reviewOrderId" />

                            <!-- Stars -->
                            <div style="margin-bottom:18px;">
                                <label style="color:#bbb; font-size:11px; font-weight:800;
                                          text-transform:uppercase; letter-spacing:.12em;
                                          display:block; margin-bottom:10px;">Đánh giá *</label>
                                <div id="starPicker" style="display:flex; gap:5px;">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <button type="button" onclick="setRating(@s)" data-star="@s"
                                                style="font-size:32px; background:none; border:none;
                                                   cursor:pointer; color:#e5e7eb;
                                                   transition:all .15s; line-height:1; padding:2px;">
                                            ★
                                        </button>
                                    }
                                </div>
                                <input type="hidden" name="rating" id="ratingInput" value="0" />
                                <p id="ratingError" style="color:#ef4444; font-size:12px;
                                                        margin:6px 0 0; display:none;">
                                    Vui lòng chọn số sao.
                                </p>
                            </div>

                            <div style="margin-bottom:12px;">
                                <label style="color:#bbb; font-size:11px; font-weight:800;
                                          text-transform:uppercase; letter-spacing:.12em;
                                          display:block; margin-bottom:8px;">Tiêu đề (tùy chọn)</label>
                                <input type="text" name="title" maxlength="200" class="review-input"
                                       placeholder="Tóm tắt nhận xét của bạn..." />
                            </div>

                            <div style="margin-bottom:18px;">
                                <label style="color:#bbb; font-size:11px; font-weight:800;
                                          text-transform:uppercase; letter-spacing:.12em;
                                          display:block; margin-bottom:8px;">Nội dung *</label>
                                <textarea name="comment" rows="4" maxlength="1000" required
                                          class="review-input" style="resize:vertical; min-height:100px;"
                                          placeholder="Chia sẻ trải nghiệm của bạn..."></textarea>
                            </div>

                            <button type="submit" onclick="return validateReview()"
                                    style="padding:12px 26px; background:#f97316; color:#fff;
                                       font-weight:800; font-size:13px; border:none;
                                       border-radius:12px; cursor:pointer; transition:all .2s;
                                       box-shadow:0 6px 20px rgba(249,115,22,.3);"
                                    onmouseover="this.style.transform='translateY(-1px)'"
                                    onmouseout="this.style.transform=''">
                                Gửi đánh giá
                            </button>
                        </form>
                    </div>
                }

                <!-- Review list -->
                <h3 style="font-size:14px; font-weight:900; color:#111; margin:0 0 14px;">
                    Đánh giá sản phẩm
                    @if (approvedCount > 0)
                    {
                        <span style="color:#bbb; font-weight:500; font-size:13px;
                                 margin-left:6px;">(@approvedCount đánh giá)</span>
                    }
                </h3>

                @if (Model.Reviews != null && Model.Reviews.Any(r => r.IsApproved))
                {
                    <div style="display:flex; flex-direction:column; gap:10px;">
                        @foreach (var review in Model.Reviews.Where(r => r.IsApproved)
                       .OrderByDescending(r => r.CreatedOn))
                        {
                            <div class="review-card">
                                <div style="display:flex; align-items:flex-start;
                                        justify-content:space-between; margin-bottom:10px;">
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <div style="width:36px; height:36px; border-radius:50%;
                                                background:#fff3e8; border:1px solid #fed7aa;
                                                display:flex; align-items:center; justify-content:center;
                                                flex-shrink:0;">
                                            <span class="material-symbols-outlined"
                                                  style="color:#f97316; font-size:17px;">person</span>
                                        </div>
                                        <div>
                                            <!-- Thay "Người dùng đã xác minh" -->
                                            <p style="color:#111827;font-weight:700;font-size:14px;margin:0 0 3px;">
                                                @(!string.IsNullOrEmpty(review.UserName) ? review.UserName : "Người dùng")
                                            </p>
                                            <div style="display:flex; align-items:center; gap:6px;">
                                                <div style="display:flex; gap:1px;">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <span style="font-size:11px; color:@(i<=review.Rating?"#f59e0b":"#e5e7eb");">★</span>
                                                    }
                                                </div>
                                                <span style="color:#bbb; font-size:11px;">
                                                    @review.CreatedOn.ToString("dd/MM/yyyy")
                                                </span>
                                                @if (review.IsVerifiedPurchase)
                                                {
                                                    <span style="background:#f0fdf4; color:#16a34a;
                                                             font-size:10px; font-weight:800;
                                                             padding:2px 8px; border-radius:100px;">
                                                        ✓ Đã mua hàng
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(review.Title))
                                {
                                    <p style="color:#111; font-weight:800; font-size:13px;
                                           margin:0 0 5px;">@review.Title</p>
                                }
                                <p style="color:#888; font-size:13px; line-height:1.7; margin:0;">
                                    @review.Comment
                                </p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align:center; padding:44px; background:#fff;
                            border-radius:16px; border:1px solid #ebebeb;">
                        <span style="font-size:26px; display:block; margin-bottom:10px;">💬</span>
                        <p style="color:#bbb; font-size:13px; margin:0;">
                            Chưa có đánh giá nào. Hãy là người đầu tiên!
                        </p>
                    </div>
                }
            </div>
        </div>

    </div>
</main>

<!-- Toast -->
<div id="cartToast">
    <div id="toastIconWrap"
         style="width:38px; height:38px; border-radius:50%; flex-shrink:0;
                background:#fff3e8; display:flex; align-items:center; justify-content:center;">
        <span class="material-symbols-outlined" id="toastIconSymbol"
              style="font-size:19px; color:#f97316;">check</span>
    </div>
    <span id="toastMsg" style="color:#111; font-size:13px; font-weight:600; flex:1;">
        Đã thêm vào giỏ!
    </span>
    <a href="/Cart"
       style="color:#f97316; font-size:12px; font-weight:800; text-decoration:none;
              padding:5px 12px; border:1.5px solid #fed7aa; border-radius:8px;
              white-space:nowrap; background:#fff3e8;">Xem giỏ →</a>
</div>

@section Scripts {
    <script>
        function switchTab(tab) {
            var isReview = tab === 'reviews';
            document.getElementById('tab-specs').classList.toggle('active', !isReview);
            document.getElementById('tab-reviews').classList.toggle('active', isReview);
            document.getElementById('panel-specs').style.display = isReview ? 'none' : 'block';
            document.getElementById('panel-reviews').style.display = isReview ? 'block' : 'none';
            var rb = document.getElementById('reviewBadge');
            if (rb) {
                rb.style.background = isReview ? '#fff3e8' : '#f0f0f0';
                rb.style.color = isReview ? '#f97316' : '#bbb';
            }
            var sb = document.getElementById('specsBadge');
            if (sb) {
                sb.style.background = !isReview ? '#fff3e8' : '#f0f0f0';
                sb.style.color = !isReview ? '#f97316' : '#bbb';
            }
        }

        @if (showReviewForm)
        {
            <text>document.addEventListener('DOMContentLoaded', function () { switchTab('reviews'); }); </text>
        }

                var currentRating = 0;
        function setRating(val) {
            currentRating = val;
            document.getElementById('ratingInput').value = val;
            document.getElementById('ratingError').style.display = 'none';
            renderStars(val);
        }
        function renderStars(val) {
            document.querySelectorAll('#starPicker button').forEach(function (btn) {
                var s = parseInt(btn.dataset.star);
                btn.style.color = s <= val ? '#f59e0b' : '#e5e7eb';
                btn.style.transform = s <= val ? 'scale(1.12)' : 'scale(1)';
            });
        }
        function validateReview() {
            if (currentRating === 0) {
                document.getElementById('ratingError').style.display = 'block';
                return false;
            }
            return true;
        }

        function changeImage(url, el) {
            var img = document.getElementById('mainImage');
            if (!img) return;
            img.style.opacity = '0';
            setTimeout(function () { img.src = url; img.style.opacity = '1'; }, 150);
            document.querySelectorAll('.pd-img-thumb').forEach(function (t) { t.classList.remove('active'); });
            if (el) el.classList.add('active');
        }

        var qty = 1;
        var maxStock = parseInt(document.getElementById('addToCartBtn')?.dataset.maxStock ?? '0');
        function changeQty(delta) {
            qty = Math.max(1, Math.min(maxStock, qty + delta));
            document.getElementById('qtyDisplay').textContent = qty;
            var minus = document.getElementById('btnMinus');
            var plus = document.getElementById('btnPlus');
            if (minus) minus.disabled = qty <= 1;
            if (plus) plus.disabled = qty >= maxStock;
        }
        changeQty(0);

        var toastTimer;
        function showToast(msg, type) {
            var toast = document.getElementById('cartToast');
            var symbol = document.getElementById('toastIconSymbol');
            var wrap = document.getElementById('toastIconWrap');
            var isOk = type === 'success';
            symbol.textContent = isOk ? 'check' : 'error';
            symbol.style.color = isOk ? '#f97316' : '#ef4444';
            wrap.style.background = isOk ? '#fff3e8' : '#fef2f2';
            toast.style.borderColor = isOk ? '#fed7aa' : '#fecaca';
            document.getElementById('toastMsg').textContent = msg;
            toast.style.opacity = '1';
            toast.style.transform = 'translateY(0)';
            toast.style.pointerEvents = 'auto';
            clearTimeout(toastTimer);
            toastTimer = setTimeout(function () {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(14px)';
                toast.style.pointerEvents = 'none';
            }, 3000);
        }

        var addBtn = document.getElementById('addToCartBtn');
        if (addBtn && !addBtn.disabled) {
            addBtn.addEventListener('click', async function () {
                var productId = this.dataset.productId;
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                var btnText = document.getElementById('addBtnText');
                var fd = new FormData();
                fd.append('productId', productId);
                fd.append('quantity', qty);
                fd.append('__RequestVerificationToken', token);
                var original = btnText.textContent;
                btnText.textContent = 'Đang thêm...';
                this.disabled = true;
                try {
                    var res = await fetch('/Cart/Add', { method: 'POST', body: fd });
                    var data = await res.json();
                    if (data.requireLogin) {
                        window.location.href = data.redirectUrl;
                        return;
                    }
                    if (data.success) {
                        var badge = document.getElementById('cartBadge');
                        if (badge) { badge.textContent = data.count; badge.classList.remove('hidden'); }
                        showToast('Đã thêm ' + qty + ' sản phẩm vào giỏ!', 'success');
                        btnText.textContent = '✓ Đã thêm!';
                        setTimeout(function () { btnText.textContent = original; addBtn.disabled = false; }, 1500);
                    } else {
                        showToast(data.message ?? 'Có lỗi xảy ra.', 'error');
                        btnText.textContent = original;
                        addBtn.disabled = false;
                    }
                } catch (e) {
                    showToast('Có lỗi xảy ra, vui lòng thử lại.', 'error');
                    btnText.textContent = original;
                    addBtn.disabled = false;
                }
            });
        }
    </script>
}
