@using Entities.ViewModel
@model Library.PaginatedList<ProductIndexModel>

@{
    var categories = ViewBag.Categories as List<Entities.Categories> ?? new();
    ViewData["Title"] = "Trang chủ";
}

<div class="bg-[#f0efed] min-h-screen font-sans text-[#111]">

    <!-- ══ HERO ══ -->
    <section class="max-w-[1280px] mx-auto px-10 pt-16 pb-10 grid grid-cols-2 gap-10 items-center">
        <div>
            <p class="flex items-center gap-2 text-[10px] font-black tracking-[.26em] uppercase text-orange-500 mb-4
                      before:content-[''] before:inline-block before:w-[22px] before:h-[2px] before:bg-orange-500">
                Next-gen performance
            </p>
            <h1 class="font-black leading-[.92] tracking-[-0.04em] mb-5"
                style="font-size:clamp(2.6rem,4.5vw,4.2rem);">
                Apex X-1<br />
                <span class="text-orange-500">Infinite Speed.</span>
            </h1>
            <p class="text-[13px] text-gray-400 leading-relaxed max-w-sm mb-8">
                Engineered with the new V3 Carbon chip — unprecedented power
                efficiency meets raw processing dominance.
            </p>
            <div class="flex gap-3">
                <a asp-controller="Products" asp-action="Index"
                   class="px-7 py-3.5 rounded-[14px] bg-orange-500 text-white text-[13px] font-black
                          shadow-[0_6px_20px_rgba(249,115,22,.38)] hover:bg-orange-600
                          hover:-translate-y-0.5 transition-all no-underline">
                    Pre-order Now
                </a>
                <a asp-controller="Products" asp-action="Index"
                   class="px-7 py-3.5 rounded-[14px] border-2 border-[#111] text-[13px] font-bold
                          hover:bg-[#111] hover:text-white transition-all no-underline">
                    Khám phá →
                </a>
            </div>
        </div>

        <div class="bg-[#e3e2df] rounded-3xl flex items-center justify-center overflow-hidden group"
             style="aspect-ratio:1.1/1;padding:36px 28px;">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuA8qRsVsTMsxREs42pcRJQv2S9EGzkXQ6WQyvfN01clu_zOlPZA8GVuTS0y-bn3Nug7DYItQwHc_2Pk4wttbfS0tdwu0llt6ly6YY7ByPzIsdejGw6E0BhrIOt2o7g5o9iQXb3ut687HIsC_oG8aiC-lzG-KuysxDX8Rlc7I2NqtdYSaPXJUPIAT0q6gc-R2UzFYGcOZZM9LOiX4wAIyXSSVJ8i3TuxHwMIHM2GvfOAq7yqkxUMUepwWva0fudZxZ-LpZGji5eHXWlv"
                 alt="Apex X-1"
                 class="w-full max-w-[340px] drop-shadow-2xl
                        group-hover:scale-[1.07] group-hover:-translate-y-3
                        transition-transform duration-500 ease-[cubic-bezier(.34,1.56,.64,1)]" />
        </div>
    </section>



    <!-- ══ CATEGORIES ══ -->
    @if (categories.Any())
    {
        <section class="max-w-[1280px] mx-auto px-10 pb-14">
            <div class="flex items-end justify-between mb-5">
                <div>
                    <p class="text-[10px] font-black tracking-[.26em] uppercase text-orange-500 mb-1">Curated Collections</p>
                    <h2 class="text-[1.65rem] font-black tracking-tight leading-tight">Specialized Tech Architectures</h2>
                </div>
                <a asp-controller="Products" asp-action="Index"
                   class="text-orange-500 text-[12px] font-bold inline-flex items-center gap-1 hover:gap-2 transition-all no-underline">
                    Explore All →
                </a>
            </div>
            @{
                var catList = categories.Take(6).ToList();
                var gridCols = catList.Count > 2 ? "grid-cols-3" : "grid-cols-2";
            }
            <div class="grid @gridCols gap-3">
                @foreach (var cat in catList)
                {
                    <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@cat.Id"
                       class="relative rounded-[20px] overflow-hidden block bg-[#222] aspect-video no-underline
                              group">
                        @if (!string.IsNullOrEmpty(cat.ImageUrl))
                        {
                            <img src="@cat.ImageUrl" alt="@cat.Name"
                                 class="absolute inset-0 w-full h-full object-cover opacity-75
                                        group-hover:opacity-90 group-hover:scale-105 transition-all duration-400" />
                        }
                        else
                        {
                            <div class="absolute inset-0 bg-gradient-to-br from-[#1a1a2e] to-[#16213e]"></div>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span class="material-symbols-outlined" style="font-size:56px;color:rgba(255,255,255,.06);">category</span>
                            </div>
                        }
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></div>
                        <div class="absolute bottom-0 left-0 right-0 p-5">
                            @if (!string.IsNullOrEmpty(cat.Description))
                            {
                                <p class="text-[9px] font-black uppercase tracking-[.2em] text-orange-400 mb-1">@cat.Description</p>
                            }
                            <p class="text-white font-black text-[1.15rem] tracking-tight mb-2 leading-tight">@cat.Name</p>
                            <span class="text-white/65 text-[11px] font-bold">Shop @cat.Name →</span>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <!-- ══ TRENDING ══ -->
    <section class="max-w-[1280px] mx-auto px-10 pb-16">
        <div class="flex items-start justify-between gap-6 mb-6">
            <div>
                <p class="text-[10px] font-black tracking-[.26em] uppercase text-orange-500 mb-1">Real-time Products</p>
                <h2 class="text-[2rem] font-black tracking-tight leading-tight">Trending Tech Gear</h2>
                <p class="text-gray-400 text-[12px] mt-1.5 leading-relaxed max-w-xs">
                    Lọc theo danh mục để tìm thiết bị phù hợp.
                </p>
            </div>
           
        </div>

        @if (Model != null && Model.Items.Any())
        {
            <div class="grid grid-cols-4 gap-3">
                @foreach (var item in Model.Items)
                {
                    var ri = (int)Math.Round(item.Rating);
                    <a asp-controller="Products" asp-action="Detail" asp-route-id="@item.Id"
                       class="bg-white rounded-[20px] border border-[#ebebeb] overflow-hidden flex flex-col
                              no-underline hover:-translate-y-[5px] hover:shadow-[0_18px_44px_rgba(0,0,0,.09)]
                              transition-all duration-[220ms] group">

                        <!-- Image -->
                        <div class="relative overflow-hidden bg-[#eeede9] aspect-square">
                            @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                            {
                                <img src="@item.ThumbnailUrl" alt="@item.Name"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[350ms]"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <span class="material-symbols-outlined text-gray-300" style="font-size:40px;">image_not_supported</span>
                                </div>
                            }
                            @if (item.Stock <= 0)
                            {
                                <span class="absolute top-2.5 left-2.5 bg-[#e5e7eb] text-[#6b7280]
                                            text-[10px] font-black px-2.5 py-1 rounded-full">Hết hàng</span>
                            }
                            else if (item.IsFeatured)
                            {
                                <span class="absolute top-2.5 left-2.5 bg-orange-500 text-white
                                            text-[10px] font-black px-2.5 py-1 rounded-full">New</span>
                            }
                            else if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                            {
                                var disc = (int)Math.Round((1 - (double)item.Price / (double)item.OriginalPrice.Value) * 100);
                                <span class="absolute top-2.5 left-2.5 bg-[#111] text-white
                                            text-[10px] font-black px-2.5 py-1 rounded-full">-@disc%</span>
                            }
                        </div>

                        <!-- Body -->
                        <div class="p-3.5 flex flex-col gap-1.5 flex-1">
                            @if (!string.IsNullOrEmpty(item.Brand))
                            {
                                <p class="text-[9px] text-gray-400 font-bold uppercase tracking-wider">@item.Brand</p>
                            }
                            <h4 class="text-[13px] font-black text-[#111] leading-snug line-clamp-2">@item.Name</h4>

                            <!-- Stars + rating + reviewCount -->
                            <div class="flex items-center gap-1">
                                <div class="flex gap-px">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <span style="font-size:11px;color:@(s<=ri?"#f59e0b":"#e5e7eb");">★</span>
                                    }
                                </div>
                                <span class="text-[10px] font-semibold text-gray-400 ml-0.5">@item.Rating.ToString("0.0")</span>
                                @if (item.ReviewCount > 0)
                                {
                                    <span class="text-[10px] text-gray-300">(@item.ReviewCount)</span>
                                }
                            </div>

                            <!-- Footer -->
                            <div class="flex items-end justify-between mt-auto pt-2.5 border-t border-[#f0f0f0]">
                                <div>
                                    <p class="text-[15px] font-black text-orange-500">@item.Price.ToString("N0")₫</p>
                                    @if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                                    {
                                        <p class="text-[10px] text-gray-300 line-through">@item.OriginalPrice.Value.ToString("N0")₫</p>
                                    }
                                </div>
                                <!-- Cart button: hover state dùng group-hover -->
                                <div class="w-8 h-8 rounded-[10px] bg-[#f0efed] border border-[#e5e5e5]
                                            flex items-center justify-center shrink-0 text-[#111]
                                            group-hover:bg-[#111] group-hover:border-[#111] group-hover:text-white
                                            transition-all duration-150">
                                    <span class="material-symbols-outlined" style="font-size:14px;">shopping_cart</span>
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>

            <div class="text-center mt-7">
                <a asp-controller="Products" asp-action="Index"
                   class="inline-flex items-center gap-2 px-8 py-3.5 rounded-[14px] border-2 border-[#111]
                          text-[13px] font-bold hover:bg-[#111] hover:text-white transition-all no-underline">
                    Xem tất cả sản phẩm →
                </a>
            </div>
        }
        else
        {
            <div class="text-center py-16 text-gray-400">
                <span class="material-symbols-outlined block mb-3 text-gray-200" style="font-size:44px;">inventory_2</span>
                <p class="text-[13px]">Chưa có sản phẩm nào.</p>
            </div>
        }
    </section>

    <!-- ══ PROMO BANNER ══ -->
    <div class="max-w-[1280px] mx-auto px-10 pb-20">
        <div class="bg-[#111] rounded-3xl grid grid-cols-[1fr_180px] items-center px-14 py-14 overflow-hidden relative">
            <div class="absolute -right-10 -top-10 w-72 h-72 rounded-full border border-white/[.04]"></div>
            <div class="absolute right-4 -bottom-10 w-44 h-44 rounded-full border border-white/[.04]"></div>
            <div class="relative z-10">
                <p class="text-[10px] font-black tracking-[.26em] uppercase text-[#444] mb-3">Sustainability & Performance</p>
                <h2 class="text-[2rem] font-black text-white leading-tight tracking-tight mb-3">
                    Upgrade Responsibly.<br />
                    <span class="text-orange-500">Trade &amp; Save.</span>
                </h2>
                <p class="text-[#555] text-[13px] leading-relaxed max-w-md mb-7">
                    Get up to $800 in credit toward your next device. Engineered to last, designed to be recycled.
                </p>
                <a asp-controller="Products" asp-action="Index"
                   class="inline-flex items-center gap-2 px-7 py-3.5 rounded-[14px] bg-orange-500 text-white
                          text-[13px] font-black shadow-[0_6px_20px_rgba(249,115,22,.38)]
                          hover:bg-orange-600 hover:-translate-y-0.5 transition-all no-underline">
                    Estimate Trade-in Value →
                </a>
            </div>
            <div class="relative z-10 flex items-center justify-center">
                <div class="w-36 h-36 rounded-full border border-white/[.08] bg-white/[.04] flex items-center justify-center">
                    <span class="material-symbols-outlined" style="font-size:72px;color:rgba(255,255,255,.1);">devices</span>
                </div>
            </div>
        </div>
    </div>

</div>
