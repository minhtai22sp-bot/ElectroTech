@using Entities
@model List<CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
    var total = Model?.Sum(i => i.Subtotal) ?? 0;
    var count = Model?.Sum(i => i.Quantity) ?? 0;
}

@Html.AntiForgeryToken()

<style>
    *, *::before, *::after { box-sizing: border-box; }

    .cart-root {
        background: #f7f6f3;
        min-height: 100vh;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #111;
    }

    /* Eyebrow line decoration (matches hero-eyebrow in Index) */
    .eyebrow {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #f97316;
        margin-bottom: 8px;
    }
    .eyebrow::before {
        content: '';
        width: 28px;
        height: 2px;
        background: #f97316;
        flex-shrink: 0;
    }

    /* Qty pill */
    .qty-pill {
        display: inline-flex;
        align-items: center;
        background: #fff;
        border: 1.5px solid #e2e2e2;
        border-radius: 100px;
        padding: 3px;
        gap: 2px;
    }

    .qty-btn {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: none;
        background: transparent;
        color: #555;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .15s;
        font-size: 16px;
    }
    .qty-btn:hover { background: #f0efed; }
    .qty-btn:disabled { opacity: .3; cursor: not-allowed; }

    .qty-val {
        width: 32px;
        text-align: center;
        font-weight: 800;
        font-size: 13px;
        color: #111;
    }

    /* Remove / clear buttons */
    .remove-btn {
        background: none;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 600;
        color: #bbb;
        padding: 6px 10px;
        border-radius: 8px;
        transition: color .15s, background .15s;
    }
    .remove-btn:hover { color: #ef4444; background: #fef2f2; }

    /* Promo input */
    .promo-input {
        flex: 1;
        border: 1.5px solid #e2e2e2;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 13px;
        background: #fff;
        color: #111;
        outline: none;
        transition: border-color .18s;
    }
    .promo-input:focus { border-color: #111; }
    .promo-input::placeholder { color: #bbb; }

    @@media (max-width: 900px) {
        .cart-layout { flex-direction: column !important; }
        .cart-summary-col { width: 100% !important; position: static !important; }
    }
</style>

<div class="cart-root">
<div class="max-w-[1200px] mx-auto px-10 pt-16 pb-20">

    <!-- ══ HEADER ══ -->
    <div class="mb-10">
        <p class="eyebrow">Your Selection</p>
        <h1 class="text-[2.6rem] font-black tracking-[-0.04em] leading-none mb-2">
            Shopping Cart
            <span class="text-orange-500">(@count)</span>
        </h1>
        <p class="text-[12px] text-gray-400 font-semibold uppercase tracking-widest">
            Review your curated technology selection
        </p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- ══ EMPTY STATE ══ -->
        <div class="flex flex-col items-center justify-center py-28 gap-5">
            <div class="w-24 h-24 rounded-3xl bg-white border border-[#ebebeb] flex items-center justify-center">
                <span class="material-symbols-outlined text-gray-200" style="font-size:48px;">shopping_cart</span>
            </div>
            <p class="text-[1.1rem] font-bold text-gray-400">Your cart is empty</p>
            <a asp-controller="Products" asp-action="Index"
               class="inline-flex items-center gap-2 px-7 py-3.5 rounded-[14px] bg-orange-500 text-white
                      text-[13px] font-black shadow-[0_6px_20px_rgba(249,115,22,.32)]
                      hover:bg-orange-600 hover:-translate-y-0.5 transition-all">
                <span class="material-symbols-outlined" style="font-size:18px;">arrow_back</span>
                Continue Shopping
            </a>
        </div>
    }
    else
    {
        <div class="cart-layout flex gap-8 items-start">

            <!-- ══ LEFT: Items ══ -->
            <div class="flex-1 min-w-0 flex flex-col gap-3" id="cartItemsList">

                @foreach (var item in Model)
                {
                    <div class="bg-white rounded-[20px] border border-[#ebebeb] p-5 flex gap-5 items-center
                                transition-shadow hover:shadow-[0_8px_30px_rgba(0,0,0,.07)]"
                         data-product-id="@item.ProductId">

                        <!-- Image -->
                        <div class="w-[110px] h-[110px] rounded-[14px] overflow-hidden bg-[#f0efed] flex-shrink-0">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.ProductName"
                                     class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <span class="material-symbols-outlined text-gray-200" style="font-size:36px;">image_not_supported</span>
                                </div>
                            }
                        </div>

                        <!-- Info -->
                        <div class="flex-1 min-w-0">
                            <div class="flex justify-between items-start gap-4 mb-3">
                                <div class="min-w-0">
                                    <h4 class="text-[14px] font-black text-[#111] truncate max-w-[340px]">
                                        @item.ProductName
                                    </h4>
                                    <div class="flex items-center gap-1 mt-1">
                                        <span class="material-symbols-outlined text-green-500"
                                              style="font-size:13px;font-variation-settings:'FILL' 1;">check_circle</span>
                                        <span class="text-[11px] font-bold text-green-500 uppercase tracking-wider">In Stock</span>
                                    </div>
                                </div>
                                <span class="text-[14px] font-black text-orange-500 whitespace-nowrap flex-shrink-0">
                                    @item.Price.ToString("N0")₫
                                </span>
                            </div>

                            <div class="flex items-center gap-4 flex-wrap">
                                <!-- Qty control -->
                                <div class="qty-pill">
                                    <button class="qty-btn" type="button"
                                            onclick="updateQty(@item.ProductId, @(item.Quantity - 1))"
                                            @(item.Quantity <= 1 ? "disabled" : "")>
                                        <span class="material-symbols-outlined" style="font-size:16px;">remove</span>
                                    </button>
                                    <span class="qty-val" id="qty-@item.ProductId">@item.Quantity</span>
                                    <button class="qty-btn" type="button"
                                            onclick="updateQty(@item.ProductId, @(item.Quantity + 1))">
                                        <span class="material-symbols-outlined" style="font-size:16px;">add</span>
                                    </button>
                                </div>

                                <!-- Subtotal -->
                                <span class="text-[13px] font-black text-[#111] ml-auto"
                                      id="subtotal-@item.ProductId">
                                    @item.Subtotal.ToString("N0")₫
                                </span>

                                <!-- Remove -->
                                <button class="remove-btn" type="button"
                                        onclick="removeItem(@item.ProductId)">
                                    <span class="material-symbols-outlined" style="font-size:16px;">delete</span>
                                    Xoá
                                </button>
                            </div>
                        </div>

                    </div>
                }

                <!-- Clear all -->
                <div class="flex justify-end mt-1">
                    <button class="remove-btn" type="button" onclick="clearCart()">
                        <span class="material-symbols-outlined" style="font-size:16px;">delete_sweep</span>
                        Xoá tất cả
                    </button>
                </div>
            </div>

            <!-- ══ RIGHT: Summary ══ -->
            <div class="cart-summary-col" style="width:360px; flex-shrink:0; position:sticky; top:7rem;">

                <!-- Summary card -->
                <div class="bg-white rounded-[20px] border border-[#ebebeb] overflow-hidden mb-3">
                    <div class="p-6">
                        <p class="text-[10px] font-black uppercase tracking-[.2em] text-orange-500 mb-1">Order</p>
                        <h2 class="text-[1.35rem] font-black tracking-tight mb-5">Tóm tắt đơn hàng</h2>

                        <!-- Per-item list -->
                        <div class="flex flex-col gap-2 mb-4" id="summaryList">
                            @foreach (var item in Model)
                            {
                                <div class="flex justify-between items-center text-[13px]"
                                     id="summary-@item.ProductId">
                                    <span class="text-gray-400 truncate max-w-[180px]">
                                        @item.ProductName
                                        <span class="font-bold" id="summaryQty-@item.ProductId">×@item.Quantity</span>
                                    </span>
                                    <span class="font-bold text-[#111]" id="summarySubtotal-@item.ProductId">
                                        @item.Subtotal.ToString("N0")₫
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="border-t border-[#f0f0f0] pt-4 flex flex-col gap-2 mb-4">
                            <div class="flex justify-between text-[13px]">
                                <span class="text-gray-400">Tạm tính</span>
                                <span class="font-bold" id="totalDisplay">@total.ToString("N0")₫</span>
                            </div>
                            <div class="flex justify-between text-[13px]">
                                <span class="text-gray-400">Vận chuyển</span>
                                <span class="font-bold text-green-500">Miễn phí</span>
                            </div>
                        </div>

                        <div class="border-t border-[#f0f0f0] pt-4 flex justify-between items-baseline mb-5">
                            <span class="text-[15px] font-black">Tổng cộng</span>
                            <span class="text-[1.7rem] font-black text-orange-500"
                                  id="grandTotal">@total.ToString("N0")₫</span>
                        </div>

                        <!-- Promo code -->
                        <div class="flex gap-2 mb-4">
                            <input class="promo-input" placeholder="Mã giảm giá" type="text" />
                            <button class="px-4 py-2 rounded-[10px] bg-[#f0efed] border border-[#e2e2e2]
                                           text-[12px] font-bold text-[#111] hover:bg-[#e5e4e1] transition-all">
                                Áp dụng
                            </button>
                        </div>

                        <!-- Checkout -->
                        <a asp-controller="Checkout" asp-action="Index"
                           class="flex items-center justify-center gap-2 w-full py-4 rounded-[14px]
                                  bg-orange-500 text-white text-[14px] font-black
                                  shadow-[0_6px_20px_rgba(249,115,22,.32)]
                                  hover:bg-orange-600 hover:-translate-y-0.5 transition-all mb-2">
                            <span class="material-symbols-outlined" style="font-size:18px;">payment</span>
                            Tiến hành thanh toán
                        </a>

                        <!-- Continue shopping -->
                        <a asp-controller="Products" asp-action="Index"
                           class="flex items-center justify-center gap-2 w-full py-3 rounded-[14px]
                                  border-2 border-[#ebebeb] text-[13px] font-bold text-gray-400
                                  hover:border-[#111] hover:text-[#111] transition-all">
                            <span class="material-symbols-outlined" style="font-size:16px;">arrow_back</span>
                            Tiếp tục mua sắm
                        </a>
                    </div>

                    <!-- Secure footer -->
                    <div class="px-6 py-3 bg-[#f7f6f3] border-t border-[#f0f0f0] flex items-center
                                justify-center gap-2 text-[10px] font-bold text-gray-300
                                uppercase tracking-[.15em]">
                        <span class="material-symbols-outlined"
                              style="font-size:14px;font-variation-settings:'FILL' 1;">verified_user</span>
                        Thanh toán mã hoá 256-bit
                    </div>
                </div>

                <!-- Bento chips -->
                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-white rounded-[16px] border border-[#ebebeb] p-4">
                        <span class="material-symbols-outlined text-orange-400" style="font-size:22px;">local_shipping</span>
                        <p class="text-[12px] font-black text-[#111] mt-2">Giao hàng nhanh</p>
                        <p class="text-[11px] text-gray-400 mt-0.5">2–3 ngày làm việc</p>
                    </div>
                    <div class="bg-white rounded-[16px] border border-[#ebebeb] p-4">
                        <span class="material-symbols-outlined text-orange-400" style="font-size:22px;">keyboard_return</span>
                        <p class="text-[12px] font-black text-[#111] mt-2">Đổi trả 30 ngày</p>
                        <p class="text-[11px] text-gray-400 mt-0.5">Không rắc rối</p>
                    </div>
                </div>

            </div><!-- /summary col -->
        </div>
    }

</div>
</div>

@section Scripts {
    <script>
        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        }

        function formatVnd(amount) {
            return new Intl.NumberFormat('vi-VN').format(amount) + '₫';
        }

        async function updateQty(productId, newQty) {
            if (newQty < 1) { removeItem(productId); return; }

            const fd = new FormData();
            fd.append('productId', productId);
            fd.append('quantity', newQty);
            fd.append('__RequestVerificationToken', getToken());

            const res = await fetch('/Cart/UpdateAjax', { method: 'POST', body: fd });
            if (!res.ok) { location.reload(); return; }
            const data = await res.json();
            if (!data.success) { location.reload(); return; }

            document.getElementById('qty-' + productId).textContent = newQty;
            document.getElementById('subtotal-' + productId).textContent = formatVnd(data.subtotal);
            document.getElementById('summaryQty-' + productId).textContent = '×' + newQty;
            document.getElementById('summarySubtotal-' + productId).textContent = formatVnd(data.subtotal);
            document.getElementById('totalDisplay').textContent = formatVnd(data.total);
            document.getElementById('grandTotal').textContent = formatVnd(data.total);

            const card = document.querySelector('[data-product-id="' + productId + '"]');
            if (card) {
                const btns = card.querySelectorAll('.qty-btn');
                btns[0].disabled = newQty <= 1;
                btns[0].setAttribute('onclick', 'updateQty(' + productId + ',' + (newQty - 1) + ')');
                btns[1].setAttribute('onclick', 'updateQty(' + productId + ',' + (newQty + 1) + ')');
            }
            updateCartBadge(data.count);
        }

        async function removeItem(productId) {
            const fd = new FormData();
            fd.append('productId', productId);
            fd.append('__RequestVerificationToken', getToken());

            const res = await fetch('/Cart/RemoveAjax', { method: 'POST', body: fd });
            if (!res.ok) { location.reload(); return; }
            const data = await res.json();

            document.querySelector('[data-product-id="' + productId + '"]')?.remove();
            document.getElementById('summary-' + productId)?.remove();
            document.getElementById('totalDisplay').textContent = formatVnd(data.total);
            document.getElementById('grandTotal').textContent = formatVnd(data.total);
            updateCartBadge(data.count);

            if (data.count === 0) location.reload();
        }

        async function clearCart() {
            const fd = new FormData();
            fd.append('__RequestVerificationToken', getToken());
            await fetch('/Cart/ClearAjax', { method: 'POST', body: fd });
            updateCartBadge(0);
            location.reload();
        }

        function updateCartBadge(count) {
            const badge = document.getElementById('cartBadge');
            if (!badge) return;
            if (count > 0) { badge.textContent = count; badge.classList.remove('hidden'); }
            else { badge.classList.add('hidden'); }
        }
    </script>
}
