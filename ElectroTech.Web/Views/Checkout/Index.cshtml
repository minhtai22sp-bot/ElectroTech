@using Entities
@model List<CartItem>
@{
    ViewData["Title"] = "Checkout";
    Layout = null;
    var total = Model?.Sum(i => i.Subtotal) ?? 0;
    var count = Model?.Sum(i => i.Quantity) ?? 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>ElectroTech | Thanh toán</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        * { font-family: 'Inter', system-ui, sans-serif; box-sizing: border-box; }

        body { background: #f7f6f3; color: #111; }

        /* Inputs */
        input, textarea, select {
            color: #111 !important;
            -webkit-text-fill-color: #111 !important;
            background-color: #fff !important;
        }
        input::placeholder, textarea::placeholder {
            color: #bbb !important;
            -webkit-text-fill-color: #bbb !important;
        }
        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus {
            -webkit-text-fill-color: #111 !important;
            box-shadow: inset 0 0 0px 1000px #fff !important;
        }
        select option { background: #fff; color: #111; }

        /* Select arrow */
        .select-wrap { position: relative; }
        .select-wrap::after {
            content: '▾';
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #bbb;
            pointer-events: none;
            font-size: 12px;
        }
        .select-wrap.loading::after {
            content: '⟳';
            animation: spin-sel 0.8s linear infinite;
        }
        @@keyframes spin-sel { to { transform: translateY(-50%) rotate(360deg); } }

        /* Step number */
        .step-num {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #f97316;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 900;
            flex-shrink: 0;
        }

        /* Form field */
        .field-input {
            width: 100%;
            background: #fff;
            border: 1.5px solid #e2e2e2;
            border-radius: 12px;
            padding: 11px 14px;
            font-size: 13px;
            outline: none;
            transition: border-color .18s;
        }
        .field-input:focus { border-color: #f97316; }
        .field-input::placeholder { color: #ccc; }
        .field-input:disabled { opacity: .45; cursor: not-allowed; }

        /* Payment card */
        .pay-card {
            padding: 16px 18px;
            border-radius: 14px;
            cursor: pointer;
            border: 1.5px solid #e2e2e2;
            transition: all .18s;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fff;
        }
        .pay-card:hover { border-color: #f97316; background: #fffbf8; }
        .pay-card.active { border-color: #f97316; background: #fff3e8; }

        .pay-radio {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 2px solid #e2e2e2;
            flex-shrink: 0;
            transition: all .18s;
        }
        .pay-radio.on { border: 5px solid #f97316; background: #fff; }

        /* Address preview */
        #address-preview {
            background: #fff3e8;
            border: 1px solid #fed7aa;
            border-radius: 12px;
            padding: 12px 14px;
            font-size: 13px;
            color: #111;
            line-height: 1.6;
        }

        /* Eyebrow */
        .eyebrow {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: #f97316;
        }
        .eyebrow::before { content: ''; width: 24px; height: 2px; background: #f97316; flex-shrink: 0; }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- ══ HEADER ══ -->
    <header class="bg-white border-b border-[#ebebeb] sticky top-0 z-50">
        <div class="max-w-[1200px] mx-auto px-10 py-4 flex justify-between items-center">
            <a asp-controller="Home" asp-action="Index"
               class="text-[1.1rem] font-black tracking-[-0.04em] text-[#111] uppercase">
                ElectroTech
            </a>
            <div class="flex items-center gap-2 text-orange-500">
                <span class="material-symbols-outlined" style="font-size:16px;">lock</span>
                <span class="text-[12px] font-bold">Thanh toán bảo mật</span>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-[1200px] mx-auto w-full px-10 py-14">

        <!-- Page title -->
        <div class="mb-10">
            <p class="eyebrow mb-2">Đơn hàng</p>
            <h1 class="text-[2.4rem] font-black tracking-[-0.04em] leading-none">
                Thanh toán
            </h1>
        </div>

        <form asp-controller="Checkout" asp-action="PlaceOrder"
              method="post" id="checkoutForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="paymentMethod" id="paymentMethodInput" value="COD" />
            <input type="hidden" name="shippingAddress" id="shippingAddressInput" />

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">

                <!-- ══ LEFT ══ -->
                <div class="lg:col-span-7 flex flex-col gap-10">

                    <!-- Step 1: Liên hệ -->
                    <section class="bg-white rounded-[20px] border border-[#ebebeb] p-7">
                        <div class="flex items-center gap-3 mb-6">
                            <span class="step-num">01</span>
                            <div>
                                <p class="text-[10px] font-800 uppercase tracking-[.18em] text-gray-400 leading-none mb-0.5">Bước 1</p>
                                <h2 class="text-[15px] font-black tracking-tight">Thông tin liên hệ</h2>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="md:col-span-2 flex flex-col gap-1.5">
                                <label class="text-[10px] font-800 uppercase tracking-[.14em] text-gray-400">Họ và tên *</label>
                                <input name="fullName" type="text" required
                                       placeholder="Nguyễn Văn A"
                                       class="field-input" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] font-800 uppercase tracking-[.14em] text-gray-400">Số điện thoại *</label>
                                <input name="phone" type="tel" required
                                       placeholder="0912 345 678"
                                       class="field-input" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] font-800 uppercase tracking-[.14em] text-gray-400">Email xác nhận *</label>
                                <input name="email" type="email" required
                                       placeholder="example@gmail.com"
                                       value="@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "")"
                                       class="field-input" />
                            </div>
                        </div>
                    </section>

                    <!-- Step 2: Địa chỉ -->
                    <section class="bg-white rounded-[20px] border border-[#ebebeb] p-7">
                        <div class="flex items-center gap-3 mb-6">
                            <span class="step-num">02</span>
                            <div>
                                <p class="text-[10px] uppercase tracking-[.18em] text-gray-400 leading-none mb-0.5">Bước 2</p>
                                <h2 class="text-[15px] font-black tracking-tight">Địa chỉ giao hàng</h2>
                            </div>
                        </div>

                        <div class="flex flex-col gap-4">
                            <!-- Tỉnh -->
                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] uppercase tracking-[.14em] text-gray-400">Tỉnh / Thành phố *</label>
                                <div class="select-wrap" id="wrap-tinh">
                                    <select id="sel-tinh" onchange="loadHuyen(this)"
                                            class="field-input appearance-none cursor-pointer pr-9">
                                        <option value="">-- Chọn tỉnh / thành phố --</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Huyện -->
                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] uppercase tracking-[.14em] text-gray-400">Quận / Huyện *</label>
                                <div class="select-wrap" id="wrap-huyen">
                                    <select id="sel-huyen" disabled onchange="loadXa(this)"
                                            class="field-input appearance-none cursor-pointer pr-9 disabled:opacity-40 disabled:cursor-not-allowed">
                                        <option value="">-- Chọn quận / huyện --</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Xã -->
                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] uppercase tracking-[.14em] text-gray-400">Phường / Xã *</label>
                                <div class="select-wrap" id="wrap-xa">
                                    <select id="sel-xa" disabled onchange="updateAddress()"
                                            class="field-input appearance-none cursor-pointer pr-9 disabled:opacity-40 disabled:cursor-not-allowed">
                                        <option value="">-- Chọn phường / xã --</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Số nhà -->
                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] uppercase tracking-[.14em] text-gray-400">Số nhà, tên đường *</label>
                                <input type="text" id="inp-sonha"
                                       placeholder="VD: 123 Nguyễn Huệ"
                                       oninput="updateAddress()"
                                       class="field-input" />
                            </div>

                            <!-- Address preview -->
                            <div id="address-preview" class="hidden">
                                <div class="flex items-start gap-2">
                                    <span class="material-symbols-outlined text-orange-400 mt-0.5" style="font-size:15px;">location_on</span>
                                    <span id="address-text" class="text-[13px] font-semibold"></span>
                                </div>
                            </div>

                            <!-- Note -->
                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] uppercase tracking-[.14em] text-gray-400">Ghi chú</label>
                                <textarea name="note" rows="3"
                                          placeholder="Yêu cầu đặc biệt, hướng dẫn giao hàng..."
                                          class="field-input resize-none"></textarea>
                            </div>
                        </div>
                    </section>

                    <!-- Step 3: Thanh toán -->
                    <section class="bg-white rounded-[20px] border border-[#ebebeb] p-7">
                        <div class="flex items-center gap-3 mb-6">
                            <span class="step-num">03</span>
                            <div>
                                <p class="text-[10px] uppercase tracking-[.18em] text-gray-400 leading-none mb-0.5">Bước 3</p>
                                <h2 class="text-[15px] font-black tracking-tight">Phương thức thanh toán</h2>
                            </div>
                        </div>

                        <div class="flex flex-col gap-3">
                            <!-- COD -->
                            <div class="pay-card active" id="pay-COD" onclick="selectPayment('COD')">
                                <div class="flex items-center gap-3">
                                    <div id="radio-COD" class="pay-radio on"></div>
                                    <div>
                                        <p class="font-black text-[13px] text-[#111]">Thanh toán khi nhận hàng (COD)</p>
                                        <p class="text-[11px] text-gray-400 mt-0.5">Trả tiền mặt khi nhận được hàng</p>
                                    </div>
                                </div>
                                <span class="material-symbols-outlined text-orange-400" style="font-size:20px;">local_shipping</span>
                            </div>

                            <!-- Bank -->
                            <div class="pay-card" id="pay-BankTransfer" onclick="selectPayment('BankTransfer')">
                                <div class="flex items-center gap-3">
                                    <div id="radio-BankTransfer" class="pay-radio"></div>
                                    <div>
                                        <p class="font-bold text-[13px] text-gray-500">Chuyển khoản ngân hàng</p>
                                        <p class="text-[11px] text-gray-400 mt-0.5">Chuyển khoản trước khi giao hàng</p>
                                    </div>
                                </div>
                                <span class="material-symbols-outlined text-gray-300" style="font-size:20px;">account_balance</span>
                            </div>

                            <!-- VNPay -->
                            <div class="pay-card" id="pay-VNPay" onclick="selectPayment('VNPay')">
                                <div class="flex items-center gap-3">
                                    <div id="radio-VNPay" class="pay-radio"></div>
                                    <div>
                                        <p class="font-bold text-[13px] text-gray-500">VNPay</p>
                                        <p class="text-[11px] text-gray-400 mt-0.5">Thanh toán qua cổng VNPay</p>
                                    </div>
                                </div>
                                <span class="material-symbols-outlined text-gray-300" style="font-size:20px;">qr_code</span>
                            </div>

                            <!-- MoMo -->
                            <div class="pay-card" id="pay-MoMo" onclick="selectPayment('MoMo')">
                                <div class="flex items-center gap-3">
                                    <div id="radio-MoMo" class="pay-radio"></div>
                                    <div>
                                        <p class="font-bold text-[13px] text-gray-500">MoMo</p>
                                        <p class="text-[11px] text-gray-400 mt-0.5">Ví điện tử MoMo</p>
                                    </div>
                                </div>
                                <span class="material-symbols-outlined text-gray-300" style="font-size:20px;">account_balance_wallet</span>
                            </div>
                        </div>
                    </section>
                </div>

                <!-- ══ RIGHT: Summary ══ -->
                <div class="lg:col-span-5">
                    <div class="sticky top-24 flex flex-col gap-3">

                        <div class="bg-white rounded-[20px] border border-[#ebebeb] overflow-hidden">
                            <div class="p-6">
                                <!-- Header -->
                                <div class="flex items-center justify-between mb-5">
                                    <div>
                                        <p class="text-[10px] font-black uppercase tracking-[.2em] text-orange-500 mb-1">Order</p>
                                        <h2 class="text-[1.2rem] font-black tracking-tight">Tóm tắt đơn hàng</h2>
                                    </div>
                                    <span class="bg-[#f0fdf4] text-green-600 text-[10px] font-black
                                                 uppercase tracking-wider px-3 py-1 rounded-full
                                                 border border-green-100">
                                        @count sản phẩm
                                    </span>
                                </div>

                                <!-- Items -->
                                <div class="flex flex-col gap-4 mb-5 max-h-64 overflow-y-auto pr-1">
                                    @foreach (var item in Model ?? new List<CartItem>())
                                    {
                                        <div class="flex gap-3">
                                            <div class="w-14 h-14 rounded-[10px] bg-[#f0efed]
                                                        overflow-hidden flex-shrink-0 border border-[#ebebeb]">
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" alt="@item.ProductName"
                                                         class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full flex items-center justify-center">
                                                        <span class="material-symbols-outlined text-gray-200" style="font-size:18px;">image_not_supported</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="flex-1 min-w-0 flex flex-col justify-center">
                                                <h4 class="font-black text-[12px] text-[#111] truncate leading-tight">
                                                    @item.ProductName
                                                </h4>
                                                <p class="text-[11px] text-gray-400 mt-0.5">SL: @item.Quantity</p>
                                                <p class="text-[13px] font-black text-orange-500 mt-0.5">
                                                    @item.Subtotal.ToString("N0")₫
                                                </p>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Totals -->
                                <div class="border-t border-[#f0f0f0] pt-4 flex flex-col gap-2 mb-5">
                                    <div class="flex justify-between text-[13px]">
                                        <span class="text-gray-400">Tạm tính</span>
                                        <span class="font-bold">@total.ToString("N0")₫</span>
                                    </div>
                                    <div class="flex justify-between text-[13px]">
                                        <span class="text-gray-400">Vận chuyển</span>
                                        <span class="font-black text-green-500">Miễn phí</span>
                                    </div>
                                    <div class="flex justify-between text-[13px]">
                                        <span class="text-gray-400">Thuế</span>
                                        <span class="font-bold">0₫</span>
                                    </div>
                                </div>

                                <div class="border-t border-[#f0f0f0] pt-4 flex justify-between
                                            items-baseline mb-6">
                                    <span class="text-[14px] font-black">Tổng cộng</span>
                                    <span class="text-[1.75rem] font-black text-orange-500">
                                        @total.ToString("N0")₫
                                    </span>
                                </div>

                                <!-- Submit -->
                                <button type="submit" id="placeOrderBtn"
                                        class="w-full py-4 rounded-[14px] font-black text-[14px]
                                               uppercase tracking-wider bg-orange-500 text-white
                                               shadow-[0_6px_20px_rgba(249,115,22,.32)]
                                               hover:bg-orange-600 hover:-translate-y-0.5
                                               active:scale-[0.98] transition-all cursor-pointer border-none">
                                    Đặt hàng ngay →
                                </button>
                            </div>

                            <!-- Secure footer -->
                            <div class="px-6 py-3 bg-[#f7f6f3] border-t border-[#f0f0f0]
                                        flex items-center justify-center gap-2
                                        text-[10px] font-bold text-gray-300 uppercase tracking-[.15em]">
                                <span class="material-symbols-outlined"
                                      style="font-size:14px; font-variation-settings:'FILL' 1;">verified_user</span>
                                Giao dịch mã hoá 256-bit
                            </div>
                        </div>

                        <!-- Back to cart -->
                        <a asp-controller="Cart" asp-action="Index"
                           class="flex items-center justify-center gap-2 text-[12px]
                                  font-bold text-gray-400 hover:text-[#111] transition-colors py-2">
                            <span class="material-symbols-outlined" style="font-size:15px;">arrow_back</span>
                            Quay lại giỏ hàng
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </main>

    <!-- ══ FOOTER ══ -->
    <footer class="bg-white border-t border-[#ebebeb] py-6 mt-10">
        <div class="max-w-[1200px] mx-auto px-10 flex flex-col md:flex-row
                    justify-between items-center gap-3">
            <span class="text-[13px] font-black tracking-tight">ElectroTech</span>
            <p class="text-[11px] text-gray-400">&copy; @DateTime.Now.Year ElectroTech. All rights reserved.</p>
            <div class="flex gap-5">
                <a href="#" class="text-[11px] text-gray-400 hover:text-orange-500 transition-colors">Privacy Policy</a>
                <a href="#" class="text-[11px] text-gray-400 hover:text-orange-500 transition-colors">Terms of Service</a>
            </div>
        </div>
    </footer>

    <script>
        const API = 'https://provinces.open-api.vn/api';

        window.addEventListener('DOMContentLoaded', async () => {
            document.getElementById('wrap-tinh').classList.add('loading');
            try {
                const res = await fetch(`${API}/p/`);
                const list = await res.json();
                const sel = document.getElementById('sel-tinh');
                list.forEach(p => sel.appendChild(new Option(p.name, p.code)));
            } catch (e) { console.error('Lỗi load tỉnh:', e); }
            finally { document.getElementById('wrap-tinh').classList.remove('loading'); }
        });

        async function loadHuyen(sel) {
            const code = sel.value;
            const selH = document.getElementById('sel-huyen');
            const selX = document.getElementById('sel-xa');
            resetSelect(selH, '-- Chọn quận / huyện --');
            resetSelect(selX, '-- Chọn phường / xã --');
            selH.disabled = selX.disabled = true;
            updateAddress();
            if (!code) return;
            document.getElementById('wrap-huyen').classList.add('loading');
            try {
                const res = await fetch(`${API}/p/${code}?depth=2`);
                const data = await res.json();
                data.districts.forEach(d => selH.appendChild(new Option(d.name, d.code)));
                selH.disabled = false;
            } catch (e) { console.error(e); }
            finally { document.getElementById('wrap-huyen').classList.remove('loading'); }
        }

        async function loadXa(sel) {
            const code = sel.value;
            const selX = document.getElementById('sel-xa');
            resetSelect(selX, '-- Chọn phường / xã --');
            selX.disabled = true;
            updateAddress();
            if (!code) return;
            document.getElementById('wrap-xa').classList.add('loading');
            try {
                const res = await fetch(`${API}/d/${code}?depth=2`);
                const data = await res.json();
                data.wards.forEach(w => selX.appendChild(new Option(w.name, w.code)));
                selX.disabled = false;
            } catch (e) { console.error(e); }
            finally { document.getElementById('wrap-xa').classList.remove('loading'); }
        }

        function updateAddress() {
            const tinh  = document.getElementById('sel-tinh');
            const huyen = document.getElementById('sel-huyen');
            const xa    = document.getElementById('sel-xa');
            const soNha = document.getElementById('inp-sonha').value.trim();
            const parts = [
                soNha,
                xa.selectedIndex    > 0 ? xa.options[xa.selectedIndex].text       : '',
                huyen.selectedIndex > 0 ? huyen.options[huyen.selectedIndex].text  : '',
                tinh.selectedIndex  > 0 ? tinh.options[tinh.selectedIndex].text    : '',
            ].filter(Boolean);
            const full = parts.join(', ');
            document.getElementById('shippingAddressInput').value = full;
            document.getElementById('address-text').textContent = full;
            document.getElementById('address-preview').classList.toggle('hidden', !full);
        }

        function resetSelect(sel, placeholder) {
            sel.innerHTML = '';
            sel.appendChild(new Option(placeholder, ''));
        }

        const payMethods = ['COD', 'BankTransfer', 'VNPay', 'MoMo'];

        function selectPayment(method) {
            payMethods.forEach(m => {
                const card  = document.getElementById('pay-' + m);
                const radio = document.getElementById('radio-' + m);
                card.classList.remove('active');
                radio.classList.remove('on');
                const label = card.querySelector('p');
                label.className = 'font-bold text-[13px] text-gray-500';
                const icon = card.querySelector('.material-symbols-outlined');
                icon.style.color = '#d1d5db';
            });
            const card  = document.getElementById('pay-' + method);
            const radio = document.getElementById('radio-' + method);
            card.classList.add('active');
            radio.classList.add('on');
            card.querySelector('p').className = 'font-black text-[13px] text-[#111]';
            card.querySelector('.material-symbols-outlined').style.color = '#fb923c';
            document.getElementById('paymentMethodInput').value = method;
        }

        document.getElementById('checkoutForm').addEventListener('submit', function (e) {
            const tinh  = document.getElementById('sel-tinh').value;
            const huyen = document.getElementById('sel-huyen').value;
            const xa    = document.getElementById('sel-xa').value;
            const soNha = document.getElementById('inp-sonha').value.trim();
            if (!tinh || !huyen || !xa || !soNha) {
                e.preventDefault();
                alert('Vui lòng chọn đầy đủ địa chỉ giao hàng.');
                return;
            }
            const btn = document.getElementById('placeOrderBtn');
            btn.textContent = 'Đang xử lý...';
            btn.disabled = true;
            btn.style.opacity = '0.7';
        });
    </script>
</body>
</html>
