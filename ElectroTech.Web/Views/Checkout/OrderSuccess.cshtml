@model Entities.Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<style>
    .step-done {
        background: #22c55e;
        border-color: #22c55e;
    }

    .step-active {
        background: #f97316;
        border-color: #f97316;
    }

    .step-wait {
        background: #fff;
        border: 2px solid #e8e8e6;
    }

    .step-line-done {
        background: #22c55e;
    }

    .step-line-wait {
        background: #e8e8e6;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        padding: 10px 0;
        border-bottom: 1px solid #f5f4f1;
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-label {
        font-size: 12px;
        color: #aaa;
        flex-shrink: 0;
    }

    .info-val {
        font-size: 13px;
        font-weight: 700;
        color: #111;
        text-align: right;
    }
</style>

<div class="max-w-[640px] mx-auto px-6 py-12">

    <!-- ══ SUCCESS CARD ══ -->
    <div class="bg-white rounded-3xl border border-[#e8e8e6] overflow-hidden
                shadow-[0_24px_64px_rgba(0,0,0,.07)]">

        <!-- Green top strip -->
        <div class="h-1.5 w-full" style="background:linear-gradient(90deg,#f97316,#fb923c);"></div>

        <div class="px-10 py-10 text-center">

            <!-- Icon -->
            <div class="w-20 h-20 rounded-full mx-auto mb-6 flex items-center justify-center
                        bg-green-50 border-2 border-green-200">
                <span class="material-symbols-outlined text-green-500"
                      style="font-size:44px;font-variation-settings:'FILL' 1;">check_circle</span>
            </div>

            <!-- Title -->
            <p class="text-[10px] font-black uppercase tracking-[.26em] text-orange-500 mb-2">
                Xác nhận đơn hàng
            </p>
            <h1 class="text-[2rem] font-black tracking-tight text-[#111] mb-2">
                Đặt hàng thành công!
            </h1>
            <p class="text-[13px] text-gray-400 mb-1">Cảm ơn bạn đã tin tưởng ElectroTech</p>
            <p class="text-[13px] text-gray-400 mb-8">
                Mã đơn:
                <span class="text-orange-500 font-black text-[15px]">#@Model.OrderCode</span>
            </p>

            <!-- ══ STEPS ══ -->
            <div class="flex items-start mb-8">

                <!-- Step 1: Đặt hàng — done -->
                <div class="flex flex-col items-center flex-1">
                    <div class="step-done w-9 h-9 rounded-full flex items-center justify-center mb-2">
                        <span class="material-symbols-outlined text-white"
                              style="font-size:17px;font-variation-settings:'FILL' 1;">check</span>
                    </div>
                    <p class="text-[10px] font-black uppercase tracking-wide text-[#111] mb-0.5">Đặt hàng</p>
                    <p class="text-[10px] font-bold text-green-500">✓ Xong</p>
                </div>

                <div class="step-line-done h-0.5 flex-1 mt-[18px]"></div>

                <!-- Step 2: Xác nhận — active -->
                <div class="flex flex-col items-center flex-1">
                    <div class="step-active w-9 h-9 rounded-full flex items-center justify-center mb-2">
                        <span class="material-symbols-outlined text-white" style="font-size:17px;">verified</span>
                    </div>
                    <p class="text-[10px] font-black uppercase tracking-wide text-[#111] mb-0.5">Xác nhận</p>
                    <p class="text-[10px] font-bold text-orange-500">Đang xử lý</p>
                </div>

                <div class="step-line-wait h-0.5 flex-1 mt-[18px]"></div>

                <!-- Step 3: Vận chuyển — wait -->
                <div class="flex flex-col items-center flex-1">
                    <div class="step-wait w-9 h-9 rounded-full flex items-center justify-center mb-2">
                        <span class="material-symbols-outlined text-gray-300" style="font-size:17px;">local_shipping</span>
                    </div>
                    <p class="text-[10px] font-black uppercase tracking-wide text-gray-400 mb-0.5">Vận chuyển</p>
                    <p class="text-[10px] font-bold text-gray-300">Chờ xác nhận</p>
                </div>

                <div class="step-line-wait h-0.5 flex-1 mt-[18px]"></div>

                <!-- Step 4: Nhận hàng — wait -->
                <div class="flex flex-col items-center flex-1">
                    <div class="step-wait w-9 h-9 rounded-full flex items-center justify-center mb-2">
                        <span class="material-symbols-outlined text-gray-300" style="font-size:17px;">home</span>
                    </div>
                    <p class="text-[10px] font-black uppercase tracking-wide text-gray-400 mb-0.5">Nhận hàng</p>
                    <p class="text-[10px] font-bold text-gray-300">Chờ xác nhận</p>
                </div>

            </div>

            <!-- ══ ORDER INFO ══ -->
            <div class="bg-[#f5f4f1] rounded-2xl p-5 mb-4 text-left">
                <p class="text-[9px] font-black uppercase tracking-[.24em] text-[#bbb] mb-3">
                    Thông tin đơn hàng
                </p>
                <div>
                    <div class="info-row">
                        <span class="info-label">Người nhận</span>
                        <span class="info-val">@Model.FullName</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Số điện thoại</span>
                        <span class="info-val">@Model.Phone</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Địa chỉ</span>
                        <span class="info-val">@Model.ShippingAddress</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Thanh toán</span>
                        <span class="info-val @(Model.PaymentMethod == Enums.PaymentMethod.BankTransfer ? "text-orange-500" : "text-green-600")">
                            @(Model.PaymentMethod == Enums.PaymentMethod.BankTransfer ? "🏦 Chuyển khoản" : "💵 Thanh toán khi nhận hàng")
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <div class="info-row">
                            <span class="info-label">Ghi chú</span>
                            <span class="info-val font-normal text-gray-500">@Model.Note</span>
                        </div>
                    }
                </div>
            </div>

            <!-- ══ ORDER ITEMS ══ -->
            <div class="bg-[#f5f4f1] rounded-2xl overflow-hidden mb-4 text-left">
                <div class="px-5 py-3 border-b border-[#ece9e6]">
                    <p class="text-[9px] font-black uppercase tracking-[.24em] text-[#bbb]">
                        Sản phẩm (@Model.OrderItems?.Count)
                    </p>
                </div>

                @if (Model.OrderItems != null)
                {
                    foreach (var item in Model.OrderItems)
                    {
                        <div class="flex items-center gap-3 px-5 py-3.5 border-b border-[#ece9e6] last:border-0">
                            @if (!string.IsNullOrEmpty(item.ProductImage))
                            {
                                <img src="@item.ProductImage" alt="@item.ProductName"
                                     class="w-12 h-12 rounded-xl object-cover shrink-0 border border-[#e8e8e6]" />
                            }
                            else
                            {
                                <div class="w-12 h-12 rounded-xl shrink-0 bg-white border border-[#e8e8e6]
                                            flex items-center justify-center">
                                    <span class="material-symbols-outlined text-gray-300" style="font-size:20px;">image_not_supported</span>
                                </div>
                            }
                            <div class="flex-1 min-w-0">
                                <p class="text-[13px] font-black text-[#111] truncate">@item.ProductName</p>
                                <p class="text-[11px] text-gray-400 mt-0.5">x@item.Quantity</p>
                            </div>
                            <div class="text-right shrink-0">
                                <p class="text-[13px] font-black text-[#111]">@item.TotalPrice.ToString("N0")₫</p>
                                <p class="text-[10px] text-gray-400">@item.UnitPrice.ToString("N0")₫/sp</p>
                            </div>
                        </div>
                    }
                }

                <!-- Total -->
                <div class="flex justify-between items-center px-5 py-4 bg-white">
                    <span class="text-[13px] font-bold text-gray-500">Tổng cộng</span>
                    <span class="text-[20px] font-black text-orange-500">@Model.TotalAmount.ToString("N0")₫</span>
                </div>
            </div>

            <!-- ══ EMAIL NOTICE ══ -->
            <div class="flex items-start gap-3 text-left p-4 rounded-2xl mb-6
                        bg-orange-50 border border-orange-100">
                <span class="material-symbols-outlined text-orange-400 shrink-0 mt-0.5"
                      style="font-size:20px;font-variation-settings:'FILL' 1;">mark_email_read</span>
                <div>
                    <p class="text-[13px] font-black text-[#111] mb-0.5">Email xác nhận đã được gửi</p>
                    <p class="text-[12px] text-gray-400 leading-relaxed">
                        Đã gửi tới <strong class="text-[#111]">@Model.Email</strong>.
                        Vui lòng kiểm tra hộp thư (kể cả Spam).
                    </p>
                </div>
            </div>

            <!-- ══ INFO CHIPS ══ -->
            <div class="grid grid-cols-2 gap-3 mb-8">
                <div class="bg-[#f5f4f1] rounded-2xl p-4 text-left border border-[#e8e8e6]">
                    <span class="material-symbols-outlined text-orange-500 block mb-2" style="font-size:20px;">support_agent</span>
                    <p class="text-[12px] font-black text-[#111] mb-0.5">Hỗ trợ 24/7</p>
                    <p class="text-[11px] text-gray-400">Hotline: 1800 1234</p>
                </div>
                <div class="bg-[#f5f4f1] rounded-2xl p-4 text-left border border-[#e8e8e6]">
                    <span class="material-symbols-outlined text-orange-500 block mb-2" style="font-size:20px;">local_shipping</span>
                    <p class="text-[12px] font-black text-[#111] mb-0.5">Giao hàng nhanh</p>
                    <p class="text-[11px] text-gray-400">2–3 ngày làm việc</p>
                </div>
            </div>

            <!-- ══ CTA ══ -->
            <div class="flex gap-3 justify-center">
                <a asp-controller="Home" asp-action="Index"
                   class="px-7 py-3.5 rounded-[14px] border-2 border-[#111] text-[13px] font-bold
                          text-[#111] no-underline hover:bg-[#111] hover:text-white transition-all">
                    ← Trang chủ
                </a>
                <a asp-controller="Products" asp-action="Index"
                   class="px-7 py-3.5 rounded-[14px] bg-orange-500 text-white text-[13px] font-black
                          no-underline shadow-[0_6px_20px_rgba(249,115,22,.35)]
                          hover:bg-orange-600 hover:-translate-y-0.5 transition-all
                          flex items-center gap-2">
                    <span class="material-symbols-outlined" style="font-size:16px;">shopping_bag</span>
                    Tiếp tục mua sắm
                </a>
            </div>

        </div>
    </div>

</div>
