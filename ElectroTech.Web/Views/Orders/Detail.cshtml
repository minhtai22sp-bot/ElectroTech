@using Entities
@using Enums
@model Order
@{
    ViewData["Title"] = $"Đơn hàng #{Model.OrderCode}";

    var (statusCls, statusLabel) = Model.Status switch
    {
        OrderStatus.Pending => ("status-pending", "⏳ Chờ xác nhận"),
        OrderStatus.Confirmed => ("status-confirmed", "✅ Đã xác nhận"),
        OrderStatus.Processing => ("status-processing", "⚙️ Đang xử lý"),
        OrderStatus.Shipped => ("status-shipped", "🚚 Đang giao hàng"),
        OrderStatus.Delivered => ("status-delivered", "📦 Đã giao hàng"),
        OrderStatus.Cancelled => ("status-cancelled", "❌ Đã hủy"),
        _ => ("status-cancelled", "Không xác định")
    };

    var paymentMethodLabel = Model.PaymentMethod switch
    {
        PaymentMethod.COD => "💵 Thanh toán khi nhận hàng (COD)",
        PaymentMethod.BankTransfer => "🏦 Chuyển khoản ngân hàng",
        PaymentMethod.VNPay => "📱 VNPay",
        PaymentMethod.MoMo => "🌸 MoMo",
        _ => Model.PaymentMethod.ToString()
    };

    var steps = new (OrderStatus Status, string Icon, string Label)[]
    {
        (OrderStatus.Pending,    "pending",        "Chờ xác nhận"),
        (OrderStatus.Confirmed,  "verified",       "Đã xác nhận"),
        (OrderStatus.Processing, "manufacturing",  "Đang xử lý"),
        (OrderStatus.Shipped,    "local_shipping", "Đang giao"),
        (OrderStatus.Delivered,  "inventory",      "Đã giao"),
    };

    int StepIndex(OrderStatus s) => s switch
    {
        OrderStatus.Pending => 0,
        OrderStatus.Confirmed => 1,
        OrderStatus.Processing => 2,
        OrderStatus.Shipped => 3,
        OrderStatus.Delivered => 4,
        _ => -1
    };

    var currentStep = StepIndex(Model.Status);
    var isCancelled = Model.Status == OrderStatus.Cancelled;
    var isDelivered = Model.Status == OrderStatus.Delivered;
    var isShipped = Model.Status == OrderStatus.Shipped;
    var canCancel = Model.Status == OrderStatus.Pending || Model.Status == OrderStatus.Processing;
    var pct = currentStep > 0 ? (int)((double)currentStep / (steps.Length - 1) * 100) : 0;

    var reviewed = ViewBag.ReviewedKeys as HashSet<string> ?? new HashSet<string>();
}

<style>
    .status-pending {
        background: rgba(251,191,36,.1);
        color: #d97706;
        border-color: rgba(251,191,36,.25);
    }

    .status-confirmed {
        background: rgba(96,165,250,.1);
        color: #2563eb;
        border-color: rgba(96,165,250,.25);
    }

    .status-processing {
        background: rgba(249,115,22,.1);
        color: #ea6c0a;
        border-color: rgba(249,115,22,.25);
    }

    .status-shipped {
        background: rgba(167,139,250,.1);
        color: #7c3aed;
        border-color: rgba(167,139,250,.25);
    }

    .status-delivered {
        background: rgba(74,222,128,.1);
        color: #16a34a;
        border-color: rgba(74,222,128,.25);
    }

    .status-cancelled {
        background: rgba(248,113,113,.1);
        color: #dc2626;
        border-color: rgba(248,113,113,.25);
    }
</style>

<div class="max-w-3xl mx-auto px-6 py-10">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 mb-6 text-xs text-gray-400">
        <a asp-controller="Orders" asp-action="Index"
           class="hover:text-orange-500 transition-colors font-semibold text-gray-500 no-underline">
            Đơn hàng của tôi
        </a>
        <span class="material-symbols-outlined" style="font-size:14px;">chevron_right</span>
        <span class="font-bold text-gray-400">#@Model.OrderCode</span>
    </nav>

    <!-- Header -->
    <div class="mb-8">
        <p class="text-[11px] font-bold uppercase tracking-[.25em] text-orange-500 mb-2">
            Chi tiết đơn hàng
        </p>
        <div class="flex items-start justify-between flex-wrap gap-3">
            <div>
                <h1 class="text-3xl font-black text-[#111] tracking-tight font-mono mb-1">
                    #@Model.OrderCode
                </h1>
                <p class="text-gray-400 text-sm">
                    Đặt lúc @Model.CreatedOn.ToString("HH:mm") — @Model.CreatedOn.ToString("dd/MM/yyyy")
                </p>
            </div>
            <span class="inline-flex items-center px-3 py-1.5 rounded-full text-[11px] font-bold border @statusCls">
                @statusLabel
            </span>
        </div>
    </div>

    <div class="flex flex-col gap-4">

        <!-- Progress Tracker -->
        <div class="bg-white rounded-2xl border border-gray-100 p-5
                    hover:border-orange-200 hover:shadow-[0_8px_32px_rgba(0,0,0,.06)] transition-all">
            <p class="text-[10px] font-bold uppercase tracking-[.2em] text-gray-400 mb-4">Trạng thái đơn hàng</p>

            @if (!isCancelled)
            {
                <div class="relative flex items-start justify-between">
                    <div class="absolute h-[2px] bg-gray-100"
                         style="top:15px;left:10%;right:10%;"></div>
                    <div class="absolute h-[2px] bg-gradient-to-r from-orange-400 to-orange-300 transition-all duration-700"
                         style="top:15px;left:10%;width:calc(@(pct)% * 0.8);"></div>

                    @for (int i = 0; i < steps.Length; i++)
                    {
                        var step = steps[i];
                        var isDone = currentStep > i;
                        var isCur = currentStep == i;
                        var dotBg = isDone ? "background:#f97316;border-color:#f97316;"
                        : isCur ? "background:#fff7ed;border-color:#f97316;box-shadow:0 0 10px rgba(249,115,22,.3);"
                        : "background:#f9fafb;border-color:#e5e7eb;";
                        var iconCl = isDone ? "#fff" : isCur ? "#f97316" : "#d1d5db";
                        var lblCl = isDone ? "text-gray-400" : isCur ? "text-orange-500 font-bold" : "text-gray-300";
                        var fillVal = isDone ? "1" : "0";

                        <div class="relative flex flex-col items-center gap-1.5 z-10" style="width:20%">
                            <div class="w-[30px] h-[30px] rounded-full border-2 flex items-center justify-center flex-shrink-0 transition-all duration-300"
                                 style="@dotBg">
                                <span class="material-symbols-outlined"
                                      style="font-size:13px;color:@iconCl;font-variation-settings:'FILL' @fillVal;">
                                    @(isDone ? "check" : step.Icon)
                                </span>
                            </div>
                            <p class="text-[9px] text-center leading-tight @lblCl transition-colors">
                                @step.Label
                            </p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex items-center gap-2.5 px-4 py-3 bg-red-50 border border-red-100 rounded-xl">
                    <span class="material-symbols-outlined text-red-400" style="font-size:16px;">cancel</span>
                    <p class="text-xs text-red-500 font-semibold">Đơn hàng đã bị hủy</p>
                </div>
            }
        </div>

        <!-- Sản phẩm đã đặt -->
        <div class="bg-white rounded-2xl border border-gray-100
                    hover:border-orange-200 hover:shadow-[0_8px_32px_rgba(0,0,0,.06)] transition-all overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-50 flex items-center gap-2">
                <span class="material-symbols-outlined text-orange-400" style="font-size:18px;">shopping_bag</span>
                <h2 class="text-sm font-bold text-[#111]">Sản phẩm đã đặt</h2>
                <span class="ml-1 text-[10px] font-bold text-gray-400 bg-gray-50 px-2 py-0.5 rounded-full border border-gray-100">
                    @(Model.OrderItems?.Count ?? 0) sản phẩm
                </span>
            </div>
            <div class="divide-y divide-gray-50">
                @foreach (var item in Model.OrderItems ?? new List<OrderItem>())
                {
                    <div class="flex items-center gap-4 px-5 py-4">
                        <div class="w-14 h-14 rounded-xl overflow-hidden flex-shrink-0 bg-gray-50 border border-gray-100">
                            @if (!string.IsNullOrEmpty(item.ProductImage))
                            {
                                <img src="@item.ProductImage" alt="@item.ProductName" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <span class="material-symbols-outlined text-gray-300" style="font-size:22px;">inventory_2</span>
                                </div>
                            }
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="font-bold text-[#111] text-sm truncate">@item.ProductName</p>
                            <p class="text-gray-400 text-xs mt-0.5">@item.UnitPrice.ToString("N0")₫ × @item.Quantity</p>
                        </div>
                        <p class="font-extrabold text-[#111] text-sm whitespace-nowrap">
                            @item.TotalPrice.ToString("N0")₫
                        </p>
                    </div>
                }
            </div>
        </div>

        <!-- Thông tin giao hàng -->
        <div class="bg-white rounded-2xl border border-gray-100
                    hover:border-orange-200 hover:shadow-[0_8px_32px_rgba(0,0,0,.06)] transition-all overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-50 flex items-center gap-2">
                <span class="material-symbols-outlined text-orange-400" style="font-size:18px;">local_shipping</span>
                <h2 class="text-sm font-bold text-[#111]">Thông tin giao hàng</h2>
            </div>
            <div class="px-5 py-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1">Người nhận</p>
                    <p class="text-sm font-semibold text-[#111]">@(Model.FullName ?? "—")</p>
                </div>
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1">Số điện thoại</p>
                    <p class="text-sm font-semibold text-[#111]">@(Model.Phone ?? "—")</p>
                </div>
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1">Email</p>
                    <p class="text-sm font-semibold text-[#111]">@(Model.Email ?? "—")</p>
                </div>
                <div class="sm:col-span-2">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1">Địa chỉ giao hàng</p>
                    <p class="text-sm font-semibold text-[#111]">@(Model.ShippingAddress ?? "—")</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="sm:col-span-2">
                        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1">Ghi chú</p>
                        <p class="text-sm text-gray-500">@Model.Note</p>
                    </div>
                }
            </div>
        </div>

        <!-- Thanh toán + Tóm tắt -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

            <!-- Tóm tắt -->
            <div class="bg-white rounded-2xl border border-gray-100
                        hover:border-orange-200 hover:shadow-[0_8px_32px_rgba(0,0,0,.06)] transition-all overflow-hidden">
                <div class="px-5 py-4 border-b border-gray-50 flex items-center gap-2">
                    <span class="material-symbols-outlined text-orange-400" style="font-size:18px;">receipt_long</span>
                    <h2 class="text-sm font-bold text-[#111]">Tóm tắt</h2>
                </div>
                <div class="px-5 py-5 space-y-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-400">Tạm tính</span>
                        <span class="text-[#111] font-medium">@Model.SubTotal.ToString("N0")₫</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="flex justify-between">
                            <span class="text-gray-400">Giảm giá</span>
                            <span class="text-green-500 font-semibold">-@Model.DiscountAmount.ToString("N0")₫</span>
                        </div>
                    }
                    <div class="flex justify-between">
                        <span class="text-gray-400">Vận chuyển</span>
                        <span class="text-green-500 font-semibold">
                            @(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("N0") + "₫")
                        </span>
                    </div>
                    <div class="h-px bg-gray-100 my-1"></div>
                    <div class="flex justify-between items-center pt-1">
                        <span class="font-bold text-[#111]">Tổng cộng</span>
                        <span class="font-black text-xl text-orange-500">@Model.TotalAmount.ToString("N0")₫</span>
                    </div>
                </div>
            </div>

            <!-- Thanh toán -->
            <div class="bg-white rounded-2xl border border-gray-100
                        hover:border-orange-200 hover:shadow-[0_8px_32px_rgba(0,0,0,.06)] transition-all overflow-hidden">
                <div class="px-5 py-4 border-b border-gray-50 flex items-center gap-2">
                    <span class="material-symbols-outlined text-orange-400" style="font-size:18px;">credit_card</span>
                    <h2 class="text-sm font-bold text-[#111]">Thanh toán</h2>
                </div>
                <div class="px-5 py-5 space-y-4">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1.5">Phương thức</p>
                        <p class="text-sm font-bold text-[#111]">@paymentMethodLabel</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1.5">Trạng thái</p>
                        @if (Model.PaymentStatus == PaymentStatus.Paid)
                        {
                            <span class="inline-flex items-center gap-1.5 text-xs font-bold
                                         text-green-600 bg-green-50 px-3 py-1.5 rounded-full border border-green-100">
                                <span class="material-symbols-outlined text-[13px]" style="font-variation-settings:'FILL' 1;">check_circle</span>
                                Đã thanh toán
                            </span>
                        }
                        else if (Model.PaymentStatus == PaymentStatus.Refunded)
                        {
                            <span class="inline-flex items-center gap-1.5 text-xs font-bold
                                         text-violet-600 bg-violet-50 px-3 py-1.5 rounded-full border border-violet-100">
                                <span class="material-symbols-outlined text-[13px]">undo</span>
                                Đã hoàn tiền
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 text-xs font-bold
                                         text-amber-600 bg-amber-50 px-3 py-1.5 rounded-full border border-amber-100">
                                <span class="material-symbols-outlined text-[13px]">schedule</span>
                                Chưa thanh toán
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3 flex-wrap pt-1">

            <!-- Quay lại -->
            <a asp-controller="Orders" asp-action="Index"
               class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold
                      bg-gray-50 border border-gray-200 text-gray-500
                      hover:bg-gray-100 transition-all no-underline">
                <span class="material-symbols-outlined" style="font-size:15px;">arrow_back</span>
                Quay lại
            </a>

            <!-- Hủy đơn: Pending hoặc Processing -->
            @if (canCancel)
            {
                <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@Model.Id"
                      method="post" style="display:inline;"
                      onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này?')">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold
                                   bg-red-50 border border-red-100 text-red-500
                                   hover:bg-red-100 transition-all cursor-pointer">
                        <span class="material-symbols-outlined" style="font-size:15px;">cancel</span>
                        Hủy đơn hàng
                    </button>
                </form>
            }

            <!-- Đã nhận hàng: Shipped -->
            @if (isShipped)
            {
                <form asp-controller="Orders" asp-action="ConfirmReceived" asp-route-id="@Model.Id"
                      method="post" style="display:inline;"
                      onsubmit="return confirm('Xác nhận bạn đã nhận được hàng?')">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold
                                   bg-green-50 border border-green-100 text-green-600
                                   hover:bg-green-100 transition-all cursor-pointer">
                        <span class="material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 1;">check_circle</span>
                        Đã nhận hàng
                    </button>
                </form>
            }

            <!-- Đánh giá: Delivered -->
            @if (isDelivered)
            {
                @foreach (var orderItem in Model.OrderItems ?? new List<OrderItem>())
                {
                    var pid = orderItem.ProductId ?? 0;
                    var key = $"{pid}_{Model.Id}";
                    var alreadyReviewed = reviewed.Contains(key);

                    if (alreadyReviewed)
                    {
                        <span class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold
                                     bg-green-50 border border-green-100 text-green-600 cursor-default"
                              title="@orderItem.ProductName">
                            <span class="material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 1;">check_circle</span>
                            Đã đánh giá
                        </span>
                    }
                    else
                    {
                        <a asp-controller="Products" asp-action="Detail"
                           asp-route-id="@orderItem.ProductId"
                           asp-route-orderId="@Model.Id"
                           class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold
                                  bg-amber-50 border border-amber-100 text-amber-600
                                  hover:bg-amber-100 transition-all no-underline"
                           title="@orderItem.ProductName">
                            <span class="material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 1;">star</span>
                            Đánh giá: @orderItem.ProductName
                        </a>
                    }
                }
            }
        </div>

    </div>
</div>
