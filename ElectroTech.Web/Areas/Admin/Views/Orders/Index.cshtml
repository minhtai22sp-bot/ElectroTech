@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Admin/_LayoutAdmin.cshtml";
}

@Html.AntiForgeryToken()

<div style="padding: 0; width: 100%;">

    <!-- Header -->
    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;">
        <div>
            <p style="font-size:10px;font-weight:700;text-transform:uppercase;
                      letter-spacing:.2em;color:#f97316;margin:0 0 4px;">Admin Panel</p>
            <h1 style="font-size:1.6rem;font-weight:900;color:#111;margin:0 0 4px;letter-spacing:-.02em;">
                Quản lý đơn hàng
            </h1>
            <p style="font-size:13px;color:#9ca3af;margin:0;">Xem và cập nhật trạng thái đơn hàng</p>
        </div>
    </div>

    <!-- Stat cards -->
    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:20px;">
        @foreach (var s in new (string Id, string Label, string Color)[]
        {
        ("statAll",       "Tất cả",       "#111"),
        ("statPending",   "Chờ xác nhận", "#f59e0b"),
        ("statConfirmed", "Đã xác nhận",  "#3b82f6"),
        ("statProcessing","Đang xử lý",   "#f97316"),
        ("statShipped",   "Đang giao",    "#8b5cf6"),
        ("statDelivered", "Đã giao",      "#16a34a"),
        })
        {
            <div style="background:#fff;border:1px solid #f0f0ee;border-radius:14px;padding:14px 16px;">
                <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#bbb;margin:0 0 5px;">@s.Label</p>
                <p id="@s.Id" style="font-size:1.3rem;font-weight:900;color:@s.Color;margin:0;">—</p>
            </div>
        }
    </div>

    <!-- Filter tabs -->
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;">
        @foreach (var tab in new (string Val, string Label, string Color)[]
        {
        ("",           "Tất cả",       "#1f2937"),
        ("Pending",    "Chờ xác nhận", "#f59e0b"),
        ("Confirmed",  "Đã xác nhận",  "#3b82f6"),
        ("Processing", "Đang xử lý",   "#f97316"),
        ("Shipped",    "Đang giao",    "#8b5cf6"),
        ("Delivered",  "Đã giao",      "#16a34a"),
        ("Cancelled",  "Đã hủy",       "#ef4444"),
        })
        {
            <button onclick="filterStatus('@tab.Val')"
                    id="tab-@tab.Val"
                    data-color="@tab.Color"
                    class="tab-btn"
                    style="padding:6px 16px;border-radius:10px;font-size:12px;font-weight:700;
                           cursor:pointer;border:1.5px solid #e5e7eb;background:#fff;
                           color:#6b7280;transition:all .15s;">
                @tab.Label
            </button>
        }
    </div>

    <!-- Table Card -->
    <div style="background:#fff;border:1px solid #e5e7eb;border-radius:16px;overflow:hidden;">

        <!-- Toolbar -->
        <div style="display:flex;align-items:center;justify-content:space-between;
                    padding:16px 20px;border-bottom:1px solid #f3f4f6;">
            <div style="position:relative;width:320px;">
                <i data-lucide="search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);
                   width:15px;height:15px;color:#9ca3af;"></i>
                <input id="searchInput" type="text" placeholder="Tìm mã đơn, khách hàng..."
                       style="width:100%;padding:8px 12px 8px 36px;font-size:13px;
                              border:1px solid #e5e7eb;border-radius:10px;background:#f9fafb;
                              color:#374151;outline:none;" />
            </div>
            <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:#9ca3af;font-weight:600;">
                <i data-lucide="arrow-down-narrow-wide" style="width:14px;height:14px;"></i>
                Mới nhất trước
            </div>
        </div>

        <!-- Table -->
        <div style="overflow-x:auto;width:100%;">
            <table id="ordersTable" style="width:100%;text-align:left;font-size:12px;color:#4b5563;border-collapse:collapse;">
                <thead>
                    <tr style="background:#f9fafb;border-bottom:1px solid #f3f4f6;">
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;white-space:nowrap;">Mã đơn</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;white-space:nowrap;">Khách hàng</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;white-space:nowrap;">Thanh toán</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;white-space:nowrap;">Tổng tiền</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;text-align:center;white-space:nowrap;">Trạng thái</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;text-align:center;white-space:nowrap;">Thanh toán</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;white-space:nowrap;">Ngày đặt</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;text-align:right;white-space:nowrap;">Thao tác</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal cập nhật -->
<div id="statusModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/40 backdrop-blur-sm">
    <div style="background:#fff;border-radius:20px;padding:28px;width:100%;max-width:480px;margin:0 16px;box-shadow:0 32px 64px rgba(0,0,0,.15);">

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
            <div>
                <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.2em;color:#f97316;margin:0 0 3px;">Cập nhật</p>
                <h3 style="font-size:16px;font-weight:900;color:#111;margin:0;">Đơn hàng</h3>
            </div>
            <button onclick="closeModal()"
                    style="width:32px;height:32px;background:#f3f4f6;border:none;border-radius:10px;
                           cursor:pointer;display:flex;align-items:center;justify-content:center;">
                <i data-lucide="x" style="width:15px;height:15px;color:#6b7280;"></i>
            </button>
        </div>

        <div style="background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:12px 16px;margin-bottom:20px;">
            <p style="font-size:10px;color:#f97316;font-weight:700;text-transform:uppercase;letter-spacing:.12em;margin:0 0 2px;">Mã đơn hàng</p>
            <p id="modalOrderId" style="font-size:14px;font-weight:900;color:#111;margin:0;font-family:monospace;"></p>
        </div>

        <p style="font-size:10px;font-weight:800;color:#9ca3af;text-transform:uppercase;letter-spacing:.12em;margin:0 0 10px;">Trạng thái đơn hàng</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:18px;">
            @foreach (var s in new (string Val, string Label, string Border, string Bg)[]
            {
            ("Pending",    "⏳ Chờ xác nhận", "#f59e0b", "#fffbeb"),
            ("Confirmed",  "✅ Đã xác nhận",  "#3b82f6", "#eff6ff"),
            ("Processing", "⚙️ Đang xử lý",   "#f97316", "#fff7ed"),
            ("Shipped",    "🚚 Đang giao",     "#8b5cf6", "#f5f3ff"),
            ("Delivered",  "📦 Đã giao",       "#16a34a", "#f0fdf4"),
            ("Cancelled",  "❌ Đã hủy",        "#ef4444", "#fef2f2"),
            })
            {
                <label id="slabel-@s.Val" data-border="@s.Border" data-bg="@s.Bg"
                       class="status-label"
                       style="display:flex;align-items:center;gap:10px;padding:10px 12px;
                              border-radius:12px;border:2px solid #e5e7eb;cursor:pointer;
                              background:#fff;transition:all .15s;">
                    <input type="radio" name="orderStatus" value="@s.Val" style="display:none;" onchange="selectStatus(this.value)" />
                    <div class="radio-dot" style="width:16px;height:16px;border-radius:50%;border:2px solid #d1d5db;
                                display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <div class="radio-fill" style="width:8px;height:8px;border-radius:50%;display:none;"></div>
                    </div>
                    <span style="font-size:12px;font-weight:700;color:#374151;">@s.Label</span>
                </label>
            }
        </div>

        <p style="font-size:10px;font-weight:800;color:#9ca3af;text-transform:uppercase;letter-spacing:.12em;margin:0 0 10px;">Trạng thái thanh toán</p>
        <div style="display:flex;gap:8px;margin-bottom:24px;">
            @foreach (var p in new (string Val, string Label, string Border, string Bg)[]
            {
            ("Unpaid",    "⏳ Chưa TT", "#f59e0b", "#fffbeb"),
            ("Paid",      "✅ Đã TT",   "#16a34a", "#f0fdf4"),
            ("Cancelled", "❌ Đã hủy",  "#ef4444", "#fef2f2"),
            })
            {
                <label id="plabel-@p.Val" data-border="@p.Border" data-bg="@p.Bg"
                       class="pay-label"
                       style="flex:1;display:flex;align-items:center;justify-content:center;
                              padding:10px;border-radius:12px;border:2px solid #e5e7eb;
                              cursor:pointer;background:#fff;transition:all .15s;">
                    <input type="radio" name="payStatus" value="@p.Val" style="display:none;" onchange="selectPayment(this.value)" />
                    <span style="font-size:12px;font-weight:700;color:#374151;">@p.Label</span>
                </label>
            }
        </div>

        <div style="display:flex;gap:10px;padding-top:16px;border-top:1px solid #f3f4f6;">
            <button onclick="closeModal()"
                    style="flex:1;padding:10px;border:1.5px solid #e5e7eb;border-radius:12px;
                           background:#fff;color:#6b7280;font-weight:700;font-size:13px;cursor:pointer;">
                Hủy
            </button>
            <button onclick="saveStatus()"
                    style="flex:1;padding:10px;border:none;border-radius:12px;
                           background:#f97316;color:#fff;font-weight:800;font-size:13px;
                           cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;">
                <i data-lucide="save" style="width:15px;height:15px;"></i>
                Lưu thay đổi
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <style>
        #ordersTable_wrapper .dataTables_length,
        #ordersTable_wrapper .dataTables_filter {
            display: none;
        }

        #ordersTable_wrapper .dataTables_info {
            font-size: 12px;
            color: #9ca3af;
            padding: 14px 20px;
        }

        #ordersTable_wrapper .dataTables_paginate {
            padding: 14px 20px;
            display: flex;
            justify-content: flex-end;
            gap: 4px;
        }

        #ordersTable_wrapper .paginate_button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 32px;
            height: 32px;
            padding: 0 8px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #6b7280;
            cursor: pointer;
            transition: all .15s;
        }

            #ordersTable_wrapper .paginate_button:hover {
                background: #fff7ed;
                color: #f97316;
            }

            #ordersTable_wrapper .paginate_button.current {
                background: #f97316 !important;
                color: #fff !important;
                border: none !important;
            }

            #ordersTable_wrapper .paginate_button.disabled {
                opacity: .35;
                cursor: not-allowed;
            }

        #ordersTable_wrapper .dataTables_info,
        #ordersTable_wrapper .dataTables_paginate {
            border-top: 1px solid #f3f4f6;
        }

        #ordersTable_wrapper > div:last-child {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        #ordersTable tbody tr {
            border-bottom: 1px solid #f9fafb;
            transition: background .12s;
        }

            #ordersTable tbody tr:hover td {
                background: #fffbf7;
            }

        #ordersTable thead th {
            border-bottom: none !important;
        }

        #ordersTable td, #ordersTable th {
            white-space: nowrap;
        }

        #ordersTable_wrapper {
            width: 100% !important;
        }

        .dataTables_wrapper {
            width: 100% !important;
        }
    </style>

    <script>
        var token = $('input[name="__RequestVerificationToken"]').first().val();
        var currentOrder = null;
        var currentFilter = '';
        var table;

        const statusMap = {
            'Pending': { label: 'Chờ xác nhận', dot: '#f59e0b', bg: '#fffbeb', color: '#b45309' },
            'Confirmed': { label: 'Đã xác nhận', dot: '#3b82f6', bg: '#eff6ff', color: '#1d4ed8' },
            'Processing': { label: 'Đang xử lý', dot: '#f97316', bg: '#fff7ed', color: '#c2410c' },
            'Shipped': { label: 'Đang giao', dot: '#8b5cf6', bg: '#f5f3ff', color: '#6d28d9' },
            'Delivered': { label: 'Đã giao', dot: '#16a34a', bg: '#f0fdf4', color: '#15803d' },
            'Cancelled': { label: 'Đã hủy', dot: '#ef4444', bg: '#fef2f2', color: '#b91c1c' },
        };
        const payMap = {
            'Unpaid': { label: 'Chưa TT', dot: '#f59e0b', bg: '#fffbeb', color: '#b45309' },
            'Paid': { label: 'Đã TT', dot: '#16a34a', bg: '#f0fdf4', color: '#15803d' },
            'Cancelled': { label: 'Đã hủy', dot: '#ef4444', bg: '#fef2f2', color: '#b91c1c' },
        };

        function statusBadge(map, key) {
            const s = map[key] || { label: key, dot: '#aaa', bg: '#f5f5f5', color: '#666' };
            return `<span style="display:inline-flex;align-items:center;gap:5px;padding:3px 10px;
                                border-radius:100px;font-size:11px;font-weight:700;
                                background:${s.bg};color:${s.color};">
                                <span style="width:5px;height:5px;border-radius:50%;background:${s.dot};display:inline-block;flex-shrink:0;"></span>
                                ${s.label}
                            </span>`;
        }

        function updateStats(data) {
            document.getElementById('statAll').textContent = data.length;
            document.getElementById('statPending').textContent = data.filter(r => r.status === 'Pending').length;
            document.getElementById('statConfirmed').textContent = data.filter(r => r.status === 'Confirmed').length;
            document.getElementById('statProcessing').textContent = data.filter(r => r.status === 'Processing').length;
            document.getElementById('statShipped').textContent = data.filter(r => r.status === 'Shipped').length;
            document.getElementById('statDelivered').textContent = data.filter(r => r.status === 'Delivered').length;
        }

        // ✅ Parse "dd/MM/yyyy HH:mm" → sortable string
        function parseDateSort(d) {
            if (!d) return '';
            const parts = d.trim().split(' ');
            const dp = parts[0].split('/');
            if (dp.length !== 3) return d;
            return `${dp[2]}-${dp[1]}-${dp[0]} ${parts[1] || '00:00'}`;
        }

        $(document).ready(function () {
            lucide.createIcons();
            table = $('#ordersTable').DataTable({
                processing: false,
                serverSide: false,
                ajax: {
                    url: '@Url.Action("LoadAll", "Orders", new { area = "Admin" })',
                    type: 'POST',
                    data: d => { d.__RequestVerificationToken = token; d.status = currentFilter; },
                    dataSrc: function (json) {
                        const data = json.data || [];
                        updateStats(data);
                        return data;
                    }
                },
                order: [[6, 'desc']],
                columns: [
                    {
                        data: 'orderCode',
                        render: (d, t, row) =>
                            `<span style="font-family:monospace;font-weight:900;font-size:12px;color:#111;">#${d || 'ET' + String(row.id).padStart(6, '0')}</span>`
                    },
                    {
                        data: 'fullName',
                        render: (d, t, row) =>
                            `<div>
                                        <p style="font-weight:700;color:#111;font-size:12px;margin:0 0 2px;">${d || '—'}</p>
                                        <p style="color:#9ca3af;font-size:11px;margin:0;">${row.phone || ''}</p>
                                        <p style="color:#9ca3af;font-size:11px;margin:0;">${row.email || ''}</p>
                                    </div>`
                    },
                    {
                        data: 'paymentMethod',
                        render: d => d === 'COD'
                            ? `<span style="font-size:11px;font-weight:700;color:#6b7280;">🚚 COD</span>`
                            : `<span style="font-size:11px;font-weight:700;color:#6b7280;">🏦 Bank</span>`
                    },
                    {
                        data: 'totalAmount',
                        render: d => `<span style="font-weight:900;font-size:13px;color:#f97316;">${new Intl.NumberFormat('vi-VN').format(d)}₫</span>`
                    },
                    { data: 'status', render: d => statusBadge(statusMap, d), className: 'text-center' },
                    { data: 'paymentStatus', render: d => statusBadge(payMap, d), className: 'text-center' },
                    {
                        data: 'createdOn',
                        render: function (d, type) {
                            if (type === 'sort' || type === 'type') return parseDateSort(d);
                            return `<span style="color:#9ca3af;font-size:11px;">${d}</span>`;
                        }
                    },
                    {
                        data: null, orderable: false,
                        render: (d, t, row) =>
                            `<div style="display:flex;align-items:center;justify-content:flex-end;gap:6px;">
                                        <a href="/Admin/Orders/Detail/${row.id}"
                                           style="padding:5px 12px;background:#fff7ed;border:1px solid #fed7aa;
                                                  border-radius:8px;color:#f97316;font-size:11px;font-weight:700;
                                                  text-decoration:none;white-space:nowrap;">
                                            Chi tiết
                                        </a>
                                        <button onclick='openModal(${JSON.stringify(row)})'
                                                style="padding:5px 12px;background:#f9fafb;border:1px solid #e5e7eb;
                                                       border-radius:8px;color:#6b7280;font-size:11px;font-weight:700;
                                                       cursor:pointer;white-space:nowrap;">
                                            Cập nhật
                                        </button>
                                    </div>`
                    }
                ],
                language: {
                    processing: '',
                    info: 'Hiển thị _START_ – _END_ / _TOTAL_ đơn hàng',
                    infoEmpty: 'Không có dữ liệu',
                    zeroRecords: 'Không tìm thấy kết quả',
                    paginate: { next: '›', previous: '‹', first: '«', last: '»' }
                },
                columnDefs: [
                    { targets: 0, width: '120px' },
                    { targets: 1, width: '180px' },
                    { targets: 2, width: '80px' },
                    { targets: 3, width: '130px' },
                    { targets: 4, width: '120px' },
                    { targets: 5, width: '100px' },
                    { targets: 6, width: '130px' },
                    { targets: 7, width: '160px', orderable: false },
                ],
                autoWidth: false,
                drawCallback: function () { lucide.createIcons(); }
            });

            $('#searchInput').on('keyup', function () { table.search(this.value).draw(); });
        });

        function filterStatus(status) {
            currentFilter = status;
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.style.background = '#fff';
                b.style.color = '#6b7280';
                b.style.borderColor = '#e5e7eb';
            });
            const active = document.getElementById('tab-' + status);
            if (active) {
                const color = active.dataset.color;
                active.style.background = color;
                active.style.color = '#fff';
                active.style.borderColor = color;
            }
            table.ajax.reload();
        }

        function openModal(order) {
            currentOrder = order;
            document.getElementById('modalOrderId').textContent =
                '#' + (order.orderCode || 'ET' + String(order.id).padStart(6, '0')) + ' — ' + (order.fullName || '');
            resetLabels();
            selectStatus(order.status);
            selectPayment(order.paymentStatus);
            const modal = document.getElementById('statusModal');
            modal.classList.remove('hidden'); modal.classList.add('flex');
            lucide.createIcons();
        }

        function closeModal() {
            document.getElementById('statusModal').classList.add('hidden');
            document.getElementById('statusModal').classList.remove('flex');
            currentOrder = null;
        }

        function resetLabels() {
            document.querySelectorAll('.status-label').forEach(l => {
                l.style.borderColor = '#e5e7eb'; l.style.background = '#fff';
                l.querySelector('.radio-fill').style.display = 'none';
                l.querySelector('.radio-dot').style.borderColor = '#d1d5db';
            });
            document.querySelectorAll('.pay-label').forEach(l => {
                l.style.borderColor = '#e5e7eb'; l.style.background = '#fff';
            });
        }

        function selectStatus(value) {
            resetLabels();
            const label = document.getElementById('slabel-' + value);
            if (label) {
                label.style.borderColor = label.dataset.border;
                label.style.background = label.dataset.bg;
                const dot = label.querySelector('.radio-dot');
                const fill = label.querySelector('.radio-fill');
                dot.style.borderColor = label.dataset.border;
                fill.style.display = 'block';
                fill.style.background = label.dataset.border;
                label.querySelector('input').checked = true;
            }
        }

        function selectPayment(value) {
            document.querySelectorAll('.pay-label').forEach(l => {
                l.style.borderColor = '#e5e7eb'; l.style.background = '#fff';
            });
            const label = document.getElementById('plabel-' + value);
            if (label) {
                label.style.borderColor = label.dataset.border;
                label.style.background = label.dataset.bg;
                label.querySelector('input').checked = true;
            }
        }

        async function saveStatus() {
            if (!currentOrder) return;
            const newStatus = document.querySelector('input[name="orderStatus"]:checked')?.value;
            const newPayment = document.querySelector('input[name="payStatus"]:checked')?.value;
            try {
                if (newStatus && newStatus !== currentOrder.status)
                    await $.ajax({ url: '/Admin/Orders/UpdateStatus', type: 'POST', data: { id: currentOrder.id, status: newStatus, __RequestVerificationToken: token } });
                if (newPayment && newPayment !== currentOrder.paymentStatus)
                    await $.ajax({ url: '/Admin/Orders/UpdatePayment', type: 'POST', data: { id: currentOrder.id, paymentStatus: newPayment, __RequestVerificationToken: token } });
                closeModal();
                table.ajax.reload(null, false);
            } catch (err) { alert('Lỗi: ' + err.message); }
        }

        document.getElementById('statusModal').addEventListener('click', function (e) {
            if (e.target === this) closeModal();
        });
    </script>
}