@using Entities
@using Enums
@model Order
@{
    ViewData["Title"] = $"Đơn hàng #ET{Model.Id:D6}";
    Layout = "~/Areas/Admin/Views/Admin/_LayoutAdmin.cshtml";

    string StatusColor(string s) => s switch
    {
        "Pending" => "bg-amber-50 text-amber-500 border-amber-200",
        "Confirmed" => "bg-blue-50 text-blue-500 border-blue-200",
        "Shipping" => "bg-violet-50 text-violet-500 border-violet-200",
        "Delivered" => "bg-green-50 text-green-600 border-green-200",
        "Cancelled" => "bg-red-50 text-red-500 border-red-200",
        _ => "bg-gray-100 text-gray-500 border-gray-200"
    };
    string StatusLabel(string s) => s switch
    {
        "Pending" => "⏳ Chờ xác nhận",
        "Confirmed" => "✅ Đã xác nhận",
        "Shipping" => "🚚 Đang giao",
        "Delivered" => "📦 Đã giao",
        "Cancelled" => "❌ Đã hủy",
        _ => s
    };

    var statusStr = Model.Status.ToString();
    var sc = StatusColor(statusStr);
    var sl = StatusLabel(statusStr);
}

<div class="min-h-screen bg-gray-100 font-sans">
    <div class="max-w-7xl mx-auto px-10 py-8 pb-16 space-y-7">

        <!-- Header -->
        <div class="flex items-start justify-between">
            <div>
                <p class="text-[10px] font-black uppercase tracking-[.22em] text-orange-500 mb-1.5">Admin Panel</p>
                <a href="/Admin/Orders"
                   class="inline-flex items-center gap-1 text-xs text-gray-400
                          hover:text-gray-600 transition-colors mb-2 no-underline">
                    ← Đơn hàng
                </a>
                <h1 class="text-3xl font-black text-gray-900 tracking-tight font-mono">
                    #@Model.OrderCode
                </h1>
                <p class="text-xs text-gray-400 mt-1.5">
                    Đặt lúc @Model.CreatedOn.ToString("HH:mm") — @Model.CreatedOn.ToString("dd/MM/yyyy")
                </p>
            </div>
            <span class="px-5 py-2 rounded-full text-[13px] font-bold border @sc">
                @sl
            </span>
        </div>

        <div class="grid grid-cols-3 gap-6">

            <!-- ── LEFT ── -->
            <div class="col-span-2 space-y-6">

                <!-- Sản phẩm -->
                <div class="bg-white border border-gray-100 rounded-2xl overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100">
                        <p class="text-[13px] font-extrabold text-gray-900">
                            🛍️ Sản phẩm đã đặt
                            <span class="text-gray-400 font-normal text-xs ml-2">
                                (@(Model.OrderItems?.Count ?? 0) sản phẩm)
                            </span>
                        </p>
                    </div>
                    <div class="p-6 space-y-4">
                        @foreach (var item in Model.OrderItems ?? new List<OrderItem>())
                        {
                            <div class="flex items-center gap-4 pb-4
                                        border-b border-gray-50 last:border-0 last:pb-0">
                                <div class="w-14 h-14 bg-gray-50 rounded-xl overflow-hidden
                                            flex-shrink-0 border border-gray-100">
                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                    {
                                        <img src="@item.ProductImage" class="w-full h-full object-cover" />
                                    }
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="font-bold text-gray-900 text-sm truncate">@item.ProductName</p>
                                    <p class="text-xs text-gray-400 mt-0.5">
                                        @item.UnitPrice.ToString("N0")₫ × @item.Quantity
                                    </p>
                                </div>
                                <p class="font-extrabold text-orange-500 whitespace-nowrap">
                                    @item.TotalPrice.ToString("N0")₫
                                </p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Giao hàng -->
                <div class="bg-white border border-gray-100 rounded-2xl overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100">
                        <p class="text-[13px] font-extrabold text-gray-900">📦 Thông tin giao hàng</p>
                    </div>
                    <div class="p-6 grid grid-cols-2 gap-5">
                        <div>
                            <p class="text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-1.5">Người nhận</p>
                            <p class="font-semibold text-gray-900 text-sm">@Model.FullName</p>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-1.5">Điện thoại</p>
                            <p class="font-semibold text-gray-900 text-sm">@Model.Phone</p>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-1.5">Email</p>
                            <p class="font-semibold text-gray-900 text-sm">@Model.Email</p>
                        </div>
                        <div class="col-span-2">
                            <p class="text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-1.5">Địa chỉ</p>
                            <p class="font-semibold text-gray-900 text-sm">@Model.ShippingAddress</p>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Note))
                        {
                            <div class="col-span-2">
                                <p class="text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-1.5">Ghi chú</p>
                                <p class="text-gray-600 text-sm">@Model.Note</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ── RIGHT ── -->
            <div class="space-y-6">

                <!-- Tóm tắt -->
                <div class="bg-white border border-gray-100 rounded-2xl overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100">
                        <p class="text-[13px] font-extrabold text-gray-900">💰 Tóm tắt</p>
                    </div>
                    <div class="p-6 space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="text-xs text-gray-400 font-semibold">Tạm tính</span>
                            <span class="font-semibold text-gray-900 text-sm">@Model.SubTotal.ToString("N0")₫</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-xs text-gray-400 font-semibold">Giảm giá</span>
                            <span class="font-semibold text-green-600 text-sm">-@Model.DiscountAmount.ToString("N0")₫</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-xs text-gray-400 font-semibold">Vận chuyển</span>
                            <span class="font-semibold text-green-600 text-sm">Miễn phí</span>
                        </div>
                        <div class="flex justify-between items-center pt-3 border-t border-gray-100">
                            <span class="font-extrabold text-gray-900 text-sm">Tổng cộng</span>
                            <span class="font-black text-lg text-orange-500">
                                @Model.TotalAmount.ToString("N0")₫
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Thanh toán -->
                <div class="bg-white border border-gray-100 rounded-2xl overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100">
                        <p class="text-[13px] font-extrabold text-gray-900">💳 Thanh toán</p>
                    </div>
                    <div class="p-6 space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="text-xs text-gray-400 font-semibold">Phương thức</span>
                            <span class="font-bold text-gray-900 text-sm">
                                @(Model.PaymentMethod == PaymentMethod.COD ? "🚚 COD" : "🏦 Chuyển khoản")
                            </span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-xs text-gray-400 font-semibold">Trạng thái</span>
                            @{
                                var ps = Model.PaymentStatus.ToString();
                                var pClass = ps == "Paid" ? "text-green-600"
                                : ps == "Cancelled" ? "text-red-500"
                                : "text-amber-500";
                                var plabel = ps == "Paid" ? "✅ Đã thanh toán"
                                : ps == "Cancelled" ? "❌ Đã hủy"
                                : "⏳ Chưa thanh toán";
                            }
                            <span class="font-bold text-sm @pClass">@plabel</span>
                        </div>
                    </div>
                </div>

                <!-- Cập nhật nhanh -->
                <div class="bg-white border border-gray-100 rounded-2xl overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100">
                        <p class="text-[13px] font-extrabold text-gray-900">⚡ Cập nhật nhanh</p>
                    </div>
                    <div class="p-6 space-y-2">
                        @foreach (var s in new (string Val, string Label, string Cls)[]
                        {
                        ("Confirmed", "✅ Xác nhận đơn",  "border-blue-200 bg-blue-50 text-blue-600 hover:bg-blue-100"),
                        ("Shipping",  "🚚 Bắt đầu giao",  "border-violet-200 bg-violet-50 text-violet-600 hover:bg-violet-100"),
                        ("Delivered", "📦 Đã giao xong",  "border-green-200 bg-green-50 text-green-600 hover:bg-green-100"),
                        ("Cancelled", "❌ Hủy đơn hàng",  "border-red-200 bg-red-50 text-red-500 hover:bg-red-100"),
                        })
                        {
                            if (Model.Status.ToString() != s.Val)
                            {
                                <button onclick="quickUpdate('@s.Val')"
                                        class="w-full py-2.5 rounded-xl font-extrabold text-xs
                                               border transition-colors cursor-pointer @s.Cls">
                                    @s.Label
                                </button>
                            }
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var token = $('input[name="__RequestVerificationToken"]').val();

        function quickUpdate(status) {
            if (!confirm('Cập nhật trạng thái đơn hàng?')) return;
            $.post({
                url: '/Admin/Orders/UpdateStatus',
                data: { id: @Model.Id, status: status },
                headers: { 'RequestVerificationToken': token },
                success: function (res) {
                    if (res.success) location.reload();
                    else alert('Lỗi: ' + res.message);
                }
            });
        }
    </script>
    @Html.AntiForgeryToken()
}