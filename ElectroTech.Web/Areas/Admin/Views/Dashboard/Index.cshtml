@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Admin/_LayoutAdmin.cshtml";
    var todayRevenue = ViewBag.TodayRevenue as decimal? ?? 0m;
    var pendingOrders = ViewBag.PendingOrders as int? ?? 0;
    var lowStockCount = ViewBag.LowStockCount as int? ?? 0;
    var pendingReviews = ViewBag.PendingReviews as int? ?? 0;
}

<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

<div class="min-h-screen bg-gray-100 font-sans text-gray-900">
    <div class="max-w-7xl mx-auto px-10 py-8 pb-16">

        
        <div class="flex items-center justify-between mb-7">
            <div>
                <p class="text-[10px] font-black uppercase tracking-[.22em] text-orange-500 mb-1.5">Admin Panel</p>
                <h1 class="text-3xl font-black text-gray-900 tracking-tight">Dashboard</h1>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs text-gray-400">@DateTime.Now.ToString("dddd, dd/MM/yyyy")</span>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                   class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-orange-500 text-white text-xs font-extrabold no-underline shadow-[0_4px_14px_rgba(249,115,22,.32)] hover:bg-orange-600 transition-colors">
                    <span class="material-symbols-outlined text-base leading-none">receipt_long</span>
                    Xem đơn hàng
                </a>
            </div>
        </div>

      
        <div class="grid grid-cols-4 gap-4 mb-6">

            <div class="bg-white rounded-2xl p-6 border border-gray-100 flex items-start justify-between gap-3 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-1.5">Doanh thu hôm nay</p>
                    <p class="text-[1.65rem] font-black text-gray-900 leading-none">@((todayRevenue / 1_000_000m).ToString("0.0"))M₫</p>
                    <p class="text-[11px] text-gray-300 mt-1.5">Từ đơn đã giao</p>
                </div>
                <div class="w-11 h-11 rounded-xl bg-orange-50 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-orange-500 text-[22px]">payments</span>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-gray-100 flex items-start justify-between gap-3 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-1.5">Đơn chờ xử lý</p>
                    <p class="text-[1.65rem] font-black leading-none @(pendingOrders > 0 ? "text-amber-400" : "text-gray-900")">@pendingOrders</p>
                    <p class="text-[11px] text-gray-300 mt-1.5">Cần xác nhận ngay</p>
                </div>
                <div class="w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-amber-400 text-[22px]">pending_actions</span>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-gray-100 flex items-start justify-between gap-3 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-1.5">Sắp hết hàng</p>
                    <p class="text-[1.65rem] font-black leading-none @(lowStockCount > 0 ? "text-red-500" : "text-gray-900")">@lowStockCount</p>
                    <p class="text-[11px] text-gray-300 mt-1.5">Dưới 5 sản phẩm</p>
                </div>
                <div class="w-11 h-11 rounded-xl bg-red-50 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-red-500 text-[22px]">inventory_2</span>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-gray-100 flex items-start justify-between gap-3 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-1.5">Đánh giá chờ duyệt</p>
                    <p class="text-[1.65rem] font-black leading-none @(pendingReviews > 0 ? "text-violet-500" : "text-gray-900")">@pendingReviews</p>
                    <p class="text-[11px] text-gray-300 mt-1.5">Chưa được duyệt</p>
                </div>
                <div class="w-11 h-11 rounded-xl bg-violet-50 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-violet-500 text-[22px]">rate_review</span>
                </div>
            </div>

        </div>

        
        <div class="grid grid-cols-[2fr_1fr] gap-4 mb-6">

            <div class="bg-white rounded-2xl p-6 border border-gray-100">
                <div class="flex items-center justify-between mb-[18px]">
                    <span class="text-[13px] font-extrabold text-gray-900">Doanh thu 7 ngày gần nhất</span>
                    <span id="total7" class="text-xs font-extrabold text-orange-500"></span>
                </div>
                <canvas id="revenueChart" height="95"></canvas>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-gray-100">
                <div class="text-[13px] font-extrabold text-gray-900 mb-[18px]">Trạng thái đơn hàng</div>
                <canvas id="statusChart" height="220"></canvas>
            </div>

        </div>

  
        <div class="grid grid-cols-2 gap-4">

            <div class="bg-white rounded-2xl p-6 border border-gray-100">
                <div class="flex items-center justify-between mb-[18px]">
                    <span class="text-[13px] font-extrabold text-gray-900">Top 5 sản phẩm bán chạy</span>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                       class="text-[11px] font-bold text-orange-500 no-underline hover:text-orange-600">Xem tất cả →</a>
                </div>
                <table class="w-full border-collapse">
                    <thead>
                        <tr>
                            <th class="text-[10px] font-extrabold uppercase tracking-[.14em] text-gray-300 pb-2.5 border-b border-gray-100 text-left">#</th>
                            <th class="text-[10px] font-extrabold uppercase tracking-[.14em] text-gray-300 pb-2.5 border-b border-gray-100 text-left">Sản phẩm</th>
                            <th class="text-[10px] font-extrabold uppercase tracking-[.14em] text-gray-300 pb-2.5 border-b border-gray-100 text-right">Đã bán</th>
                            <th class="text-[10px] font-extrabold uppercase tracking-[.14em] text-gray-300 pb-2.5 border-b border-gray-100 text-right">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody id="topTbody">
                        <tr>
                            <td colspan="4" class="text-center text-gray-300 py-7">
                                <span class="material-symbols-outlined text-[28px] block mb-1.5">hourglass_empty</span>
                                Đang tải...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-gray-100">
                <div class="flex items-center justify-between mb-[18px]">
                    <span class="text-[13px] font-extrabold text-gray-900">Đơn hàng mới nhất</span>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                       class="text-[11px] font-bold text-orange-500 no-underline hover:text-orange-600">Xem tất cả →</a>
                </div>
                <table class="w-full border-collapse">
                    <thead>
                        <tr>
                            <th class="text-[10px] font-extrabold uppercase tracking-[.14em] text-gray-300 pb-2.5 border-b border-gray-100 text-left">Mã đơn</th>
                            <th class="text-[10px] font-extrabold uppercase tracking-[.14em] text-gray-300 pb-2.5 border-b border-gray-100 text-left">Trạng thái</th>
                            <th class="text-[10px] font-extrabold uppercase tracking-[.14em] text-gray-300 pb-2.5 border-b border-gray-100 text-right">Tổng tiền</th>
                        </tr>
                    </thead>
                    <tbody id="recentTbody">
                        <tr>
                            <td colspan="3" class="text-center text-gray-300 py-7">
                                <span class="material-symbols-outlined text-[28px] block mb-1.5">hourglass_empty</span>
                                Đang tải...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // ── 1. Revenue chart ──────────────────────────────────────────────────────
        fetch('/Admin/Dashboard/Stats')
            .then(r => r.json())
            .then(data => {
                const days = data.last7 || [];
                const labels = days.map(d => d.label);
                const revenues = days.map(d => d.revenue);
                const total = revenues.reduce((a, b) => a + b, 0);

                document.getElementById('total7').textContent =
                    (total / 1_000_000).toFixed(1) + 'M₫';

                new Chart(document.getElementById('revenueChart'), {
                    type: 'line',
                    data: {
                        labels,
                        datasets: [{
                            label: 'Doanh thu',
                            data: revenues,
                            borderColor: '#f97316',
                            backgroundColor: 'rgba(249,115,22,.08)',
                            borderWidth: 2.5,
                            pointBackgroundColor: '#f97316',
                            pointRadius: 4,
                            tension: 0.4,
                            fill: true,
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false }, ticks: { font: { size: 11 } } },
                            y: {
                                grid: { color: '#f8f8f6' },
                                ticks: { font: { size: 11 }, callback: v => (v / 1_000_000).toFixed(1) + 'M' }
                            }
                        }
                    }
                });

                const dist = data.statusDist || [];
                const colorMap = {
                    'Pending': '#f59e0b', 'Confirmed': '#3b82f6', 'Processing': '#f97316',
                    'Shipped': '#8b5cf6', 'Delivered': '#22c55e', 'Cancelled': '#ef4444',
                };
                const labelMap = {
                    'Pending': 'Chờ xác nhận', 'Confirmed': 'Đã xác nhận', 'Processing': 'Đang xử lý',
                    'Shipped': 'Đang giao', 'Delivered': 'Đã giao', 'Cancelled': 'Đã hủy',
                };
                if (dist.length) {
                    new Chart(document.getElementById('statusChart'), {
                        type: 'doughnut',
                        data: {
                            labels: dist.map(s => labelMap[s.status] || s.status),
                            datasets: [{
                                data: dist.map(s => s.count),
                                backgroundColor: dist.map(s => colorMap[s.status] || '#aaa'),
                                borderWidth: 0,
                                hoverOffset: 6,
                            }]
                        },
                        options: {
                            responsive: true,
                            cutout: '68%',
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: { font: { size: 11 }, padding: 14, usePointStyle: true }
                                }
                            }
                        }
                    });
                }
            });

       
        fetch('/Admin/Dashboard/TopProducts')
            .then(r => r.json())
            .then(data => {
                const tbody = document.getElementById('topTbody');
                if (!data || !data.length) {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-gray-300 py-5">Chưa có dữ liệu</td></tr>';
                    return;
                }
                tbody.innerHTML = data.map((p, i) => `
                            <tr class="border-b border-gray-50 last:border-0">
                                <td class="py-3 text-gray-300 font-bold text-xs w-6">${i + 1}</td>
                                <td class="py-3">
                                    <div class="flex items-center gap-2.5">
                                        ${p.thumbnailUrl
                        ? `<img src="${p.thumbnailUrl}" class="w-9 h-9 rounded-lg object-cover shrink-0" />`
                        : `<div class="w-9 h-9 rounded-lg bg-gray-100 flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-[15px] text-gray-300">image_not_supported</span></div>`
                    }
                                        <span class="text-[13px] font-semibold text-gray-900 line-clamp-1">${p.name}</span>
                                    </div>
                                </td>
                                <td class="py-3 text-right text-[13px] font-bold text-gray-900">${p.soldCount}</td>
                                <td class="py-3 text-right text-[13px] font-extrabold text-orange-500">
                                    ${(p.revenue / 1_000_000).toFixed(1)}M₫
                                </td>
                            </tr>
                        `).join('');
            });


        fetch('/Admin/Orders/Recent')
            .then(r => { if (!r.ok) throw new Error(); return r.json(); })
            .then(orders => {
                const statusMap = {
                    'Pending': { label: 'Chờ xác nhận', color: '#f59e0b' },
                    'Confirmed': { label: 'Đã xác nhận', color: '#3b82f6' },
                    'Processing': { label: 'Đang xử lý', color: '#f97316' },
                    'Shipped': { label: 'Đang giao', color: '#8b5cf6' },
                    'Delivered': { label: 'Đã giao', color: '#22c55e' },
                    'Cancelled': { label: 'Đã hủy', color: '#ef4444' },
                };
                const tbody = document.getElementById('recentTbody');
                if (!orders || !orders.length) {
                    tbody.innerHTML = '<tr><td colspan="3" class="text-center text-gray-300 py-5">Chưa có dữ liệu</td></tr>';
                    return;
                }
                tbody.innerHTML = orders.map(o => {
                    const st = statusMap[o.status] || { label: o.status, color: '#aaa' };
                    return `
                                <tr class="border-b border-gray-50 last:border-0">
                                    <td class="py-3">
                                        <a href="/Admin/Orders/Detail/${o.id}"
                                           class="text-xs font-extrabold text-gray-900 no-underline font-mono hover:text-orange-500 transition-colors">
                                            #${o.orderCode}
                                        </a>
                                    </td>
                                    <td class="py-3">
                                        <span class="text-[11px] font-bold" style="color:${st.color};">${st.label}</span>
                                    </td>
                                    <td class="py-3 text-right text-[13px] font-extrabold text-orange-500">
                                        ${(o.totalAmount / 1_000_000).toFixed(1)}M₫
                                    </td>
                                </tr>
                            `;
                }).join('');
            })
            .catch(() => {
                document.getElementById('recentTbody').innerHTML =
                    '<tr><td colspan="3" class="text-center text-gray-300 py-5">Chưa có dữ liệu</td></tr>';
            });
    </script>
}