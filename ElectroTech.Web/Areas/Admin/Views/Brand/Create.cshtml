@model Entities.Brand
@{
    ViewData["Title"] = "Thêm thương hiệu";
    Layout = "~/Areas/Admin/Views/Admin/_LayoutAdmin.cshtml";
}

<form action="/Admin/Brand/Create" method="post" id="brandForm">
    @Html.AntiForgeryToken()

    <div class="min-h-screen bg-gray-100 font-sans">
        <div class="max-w-7xl mx-auto px-10 py-8 pb-16 space-y-7">

            @if (ViewBag.DebugErrors != null)
            {
                <div class="bg-red-50 border border-red-200 rounded-2xl p-5">
                    <p class="text-[10px] font-black uppercase tracking-[.14em] text-red-600 mb-3">⚠️ Lỗi validation:</p>
                    @foreach (var kvp in (Dictionary<string, List<string>>)ViewBag.DebugErrors)
                    {
                        <div class="mb-1">
                            <span class="text-xs font-bold text-red-600 font-mono">[@kvp.Key]</span>
                            @foreach (var err in kvp.Value)
                            {
                                <span class="text-xs text-red-500 ml-2">→ @err</span>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Header -->
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[10px] font-black uppercase tracking-[.22em] text-orange-500 mb-1.5">Admin Panel</p>
                    <h1 class="text-3xl font-black text-gray-900 tracking-tight">Thêm thương hiệu mới</h1>
                    <p class="text-xs text-gray-400 mt-1.5">Điền thông tin thương hiệu sản phẩm</p>
                </div>
                <div class="flex items-center gap-3">
                    <span class="text-xs text-gray-400">@DateTime.Now.ToString("dddd, dd/MM/yyyy")</span>
                    <a href="/Admin/Brand"
                       class="px-4 py-2.5 bg-white border border-gray-200 rounded-xl
                              text-gray-500 text-xs font-bold hover:bg-gray-50 transition-colors no-underline">
                        ← Hủy
                    </a>
                    <button type="submit"
                            class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-orange-500 hover:bg-orange-600
                                   rounded-xl text-white text-xs font-extrabold cursor-pointer
                                   border-none transition-colors shadow-[0_4px_14px_rgba(249,115,22,.32)]">
                        💾 Lưu thương hiệu
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-6">

                <!-- LEFT -->
                <div class="col-span-2 space-y-6">
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
                        <div class="px-6 py-4 border-b border-gray-100">
                            <p class="text-[10px] font-bold uppercase tracking-[.14em] text-orange-500 mb-0.5">Bước 1</p>
                            <p class="text-[13px] font-extrabold text-gray-900">📋 Thông tin cơ bản</p>
                        </div>
                        <div class="p-6 space-y-4">

                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-2">
                                    Tên thương hiệu *
                                </label>
                                <input type="text" name="Name" id="Name"
                                       placeholder="VD: Samsung, Apple, Sony..."
                                       class="w-full px-4 py-2.5 border border-gray-200 rounded-xl
                                              text-sm text-gray-900 bg-gray-50 focus:outline-none
                                              focus:border-orange-400 focus:ring-2 focus:ring-orange-100 transition-all" />
                            </div>

                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-2">
                                    Mô tả
                                </label>
                                <textarea name="Description" rows="4"
                                          placeholder="Mô tả ngắn về thương hiệu..."
                                          class="w-full px-4 py-2.5 border border-gray-200 rounded-xl
                                                 text-sm text-gray-900 bg-gray-50 focus:outline-none
                                                 focus:border-orange-400 focus:ring-2 focus:ring-orange-100
                                                 transition-all resize-y"></textarea>
                            </div>

                          

                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-2">
                                    Thứ tự hiển thị
                                </label>
                                <input type="number" name="DisplayOrder" value="0" min="0"
                                       class="w-full px-4 py-2.5 border border-gray-200 rounded-xl
                                              text-sm text-gray-900 bg-gray-50 focus:outline-none
                                              focus:border-orange-400 focus:ring-2 focus:ring-orange-100 transition-all" />
                                <p class="text-xs text-gray-400 mt-1.5">Số nhỏ hơn hiển thị trước</p>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- RIGHT -->
                <div class="space-y-6">

                    <!-- Logo -->
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
                        <div class="px-6 py-4 border-b border-gray-100">
                            <p class="text-[13px] font-extrabold text-gray-900">🖼️ Logo thương hiệu</p>
                        </div>
                        <div class="p-6 space-y-4">

                            <div id="imgPreview"
                                 onclick="document.getElementById('fileInput').click()"
                                 class="w-full aspect-video bg-gray-50 border-2 border-dashed
                                        border-gray-200 rounded-2xl flex items-center
                                        justify-center overflow-hidden cursor-pointer
                                        hover:border-orange-400 transition-colors">
                                <div class="text-center text-gray-300">
                                    <div class="text-4xl mb-2">🏷️</div>
                                    <div class="text-xs font-semibold">Click để chọn logo</div>
                                </div>
                            </div>

                            <input type="file" id="fileInput" accept="image/*" class="hidden"
                                   onchange="uploadImage(this)" />
                            <input type="hidden" name="LogoUrl" id="LogoUrl" />

                            <div class="relative">
                                <input type="text" id="LogoUrlDisplay"
                                       placeholder="URL logo hoặc upload từ máy"
                                       oninput="syncUrl(this.value)"
                                       class="w-full px-4 py-2.5 pr-20 border border-gray-200 rounded-xl
                                              text-xs text-gray-900 bg-gray-50 focus:outline-none
                                              focus:border-orange-400 focus:ring-2 focus:ring-orange-100 transition-all" />
                                <button type="button"
                                        onclick="document.getElementById('fileInput').click()"
                                        class="absolute right-2 top-1/2 -translate-y-1/2
                                               px-2.5 py-1 bg-orange-50 hover:bg-orange-100
                                               border border-orange-200 rounded-lg text-orange-500
                                               text-[10px] font-extrabold cursor-pointer transition-colors">
                                    📁 Upload
                                </button>
                            </div>

                            <div id="uploadStatus" class="hidden">
                                <div class="flex items-center gap-2 p-2.5 bg-orange-50 rounded-xl border border-orange-200">
                                    <div style="animation:spin 1s linear infinite;font-size:14px;">⏳</div>
                                    <span class="text-xs text-orange-500 font-semibold">Đang tải lên...</span>
                                </div>
                            </div>

                            <p class="text-[11px] text-gray-300 text-center">JPG, PNG, WebP — tối đa 5MB</p>
                        </div>
                    </div>

                    <!-- Trạng thái -->
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
                        <div class="px-6 py-4 border-b border-gray-100">
                            <p class="text-[13px] font-extrabold text-gray-900">📌 Trạng thái</p>
                        </div>
                        <div class="p-6">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-extrabold text-gray-900">Kích hoạt</p>
                                    <p class="text-xs text-gray-400 mt-0.5">Hiển thị trên store</p>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" name="IsActive" value="true" checked
                                           class="sr-only peer" />
                                    <div class="w-11 h-6 bg-gray-200 rounded-full
                                                peer peer-checked:bg-orange-500
                                                after:content-[''] after:absolute
                                                after:top-[2px] after:left-[2px]
                                                after:bg-white after:rounded-full
                                                after:h-5 after:w-5 after:transition-all
                                                peer-checked:after:translate-x-full
                                                cursor-pointer"></div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full py-3.5 bg-orange-500 hover:bg-orange-600 rounded-2xl
                                   text-white font-extrabold text-sm transition-colors
                                   border-none cursor-pointer shadow-[0_4px_14px_rgba(249,115,22,.32)]">
                        💾 Lưu thương hiệu
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <style>
        @@keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }
    </style>
    <script>
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        function syncUrl(val) {
            document.getElementById('LogoUrl').value = val;
            previewFromUrl(val);
        }

        function previewFromUrl(url) {
            var preview = document.getElementById('imgPreview');
            if (url) {
                preview.innerHTML = '<img src="' + url + '" class="w-full h-full object-cover" />';
            } else {
                preview.innerHTML =
                    '<div class="text-center text-gray-300">' +
                    '<div class="text-4xl mb-2">🏷️</div>' +
                    '<div class="text-xs font-semibold">Click để chọn logo</div></div>';
            }
        }

        async function uploadImage(input) {
            var file = input.files[0];
            if (!file) return;
            var status = document.getElementById('uploadStatus');
            status.classList.remove('hidden');
            var fd = new FormData();
            fd.append('file', file);
            try {
                var res = await fetch('/Admin/Brand/UploadImage', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: fd
                });
                var data = await res.json();
                status.classList.add('hidden');
                if (data.success) {
                    document.getElementById('LogoUrl').value = data.url;
                    document.getElementById('LogoUrlDisplay').value = data.url;
                    previewFromUrl(data.url);
                    showToast('✅ Upload thành công', 'green');
                } else {
                    showToast('Upload thất bại: ' + data.message, 'red');
                }
            } catch (e) {
                status.classList.add('hidden');
                showToast('Lỗi kết nối', 'red');
            } finally { input.value = ''; }
        }

        function showToast(msg, color) {
            var t = document.createElement('div');
            var isGreen = color === 'green';
            t.className = 'fixed bottom-6 right-6 z-[99999] px-5 py-3 rounded-2xl text-xs font-bold ' +
                'shadow-xl transition-opacity ' +
                (isGreen ? 'bg-green-50 text-green-700 border border-green-200'
                    : 'bg-red-50 text-red-600 border border-red-200');
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(function () { t.style.opacity = '0'; }, 3000);
            setTimeout(function () { t.remove(); }, 3400);
        }
    </script>
}