@model Entities.ViewModel.CreateProductViewModel
@{
    ViewData["Title"] = "Thêm sản phẩm";
    Layout = "~/Areas/Admin/Views/Admin/_LayoutAdmin.cshtml";
}

<form action="/Admin/Product/Create" method="post" id="productForm">
    @Html.AntiForgeryToken()

    <div class="min-h-screen bg-gray-100 font-sans">
        <div class="max-w-7xl mx-auto px-10 py-8 pb-16 space-y-7">

            @if (ViewBag.DebugErrors != null)
            {
                <div class="bg-red-50 border border-red-200 rounded-2xl p-5">
                    <p class="text-[10px] font-black uppercase tracking-[.14em] text-red-600 mb-3">
                        ⚠️ Lỗi validation — vui lòng kiểm tra:
                    </p>
                    @foreach (var kvp in (Dictionary<string, List<string>>)ViewBag.DebugErrors)
                    {
                        <div class="mb-1">
                            <span class="text-xs font-bold text-red-600 font-mono">[@kvp.Key]</span>
                            @foreach (var err in kvp.Value)
                            {
                                <span class="text-xs text-red-500 ml-2">→ @err</span>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Header -->
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[10px] font-black uppercase tracking-[.22em] text-orange-500 mb-1.5">Admin Panel</p>
                    <h1 class="text-3xl font-black text-gray-900 tracking-tight">Thêm sản phẩm mới</h1>
                    <p class="text-xs text-gray-400 mt-1.5">Điền đầy đủ thông tin và thông số kỹ thuật.</p>
                </div>
                <div class="flex items-center gap-3">
                    <span class="text-xs text-gray-400">@DateTime.Now.ToString("dddd, dd/MM/yyyy")</span>
                    <a href="/Admin/Product"
                       class="px-4 py-2.5 bg-white border border-gray-200 rounded-xl
                              text-gray-500 text-xs font-bold hover:bg-gray-50 transition-colors no-underline">
                        ← Hủy
                    </a>
                    <button type="submit"
                            class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-orange-500 hover:bg-orange-600
                                   rounded-xl text-white text-xs font-extrabold cursor-pointer
                                   border-none transition-colors shadow-[0_4px_14px_rgba(249,115,22,.32)]">
                        💾 Lưu sản phẩm
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-6">

                <!-- LEFT -->
                <div class="col-span-2 space-y-6">

                    <!-- Thông tin cơ bản -->
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
                        <div class="px-6 py-4 border-b border-gray-100">
                            <p class="text-[10px] font-bold uppercase tracking-[.14em] text-orange-500 mb-0.5">Bước 1</p>
                            <p class="text-[13px] font-extrabold text-gray-900">📋 Thông tin cơ bản</p>
                        </div>

                        <div class="p-6 grid grid-cols-2 gap-4">

                            <!-- Tên -->
                            <div class="col-span-2">
                                <label class="block text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-2">
                                    Tên sản phẩm *
                                </label>
                                <input type="text" id="Name" name="Name" value="@Model.Name"
                                       placeholder="iPhone 15 Pro Max"
                                       class="w-full px-4 py-2.5 border border-gray-200 rounded-xl
                                              text-sm text-gray-900 bg-gray-50
                                              focus:outline-none focus:border-orange-400
                                              focus:ring-2 focus:ring-orange-100 transition-all" />
                                @if (ViewData.ModelState["Name"]?.Errors.Any() == true)
                                {
                                    <span class="text-red-500 text-xs mt-1 block">
                                        @ViewData.ModelState["Name"].Errors[0].ErrorMessage
                                    </span>
                                }
                            </div>

                            <!-- SKU -->
                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-2">
                                    Mã SKU
                                </label>
                                <input type="text" id="Code" name="Code" value="@Model.Code"
                                       placeholder="IP15PM-256"
                                       class="w-full px-4 py-2.5 border border-gray-200 rounded-xl
                                              text-sm font-mono text-gray-900 bg-gray-50
                                              focus:outline-none focus:border-orange-400
                                              focus:ring-2 focus:ring-orange-100 transition-all" />
                            </div>

                            <!-- Brand -->
                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-2">
                                    Thương hiệu
                                </label>
                                <input type="text" id="Brand" name="Brand" value="@Model.Brand"
                                       placeholder="Apple"
                                       class="w-full px-4 py-2.5 border border-gray-200 rounded-xl
                                              text-sm text-gray-900 bg-gray-50
                                              focus:outline-none focus:border-orange-400
                                              focus:ring-2 focus:ring-orange-100 transition-all" />
                            </div>

                            <!-- Category -->
                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-2">
                                    Danh mục *
                                </label>
                                <select id="CategoryId" name="CategoryId"
                                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl
                                               text-sm text-gray-900 bg-gray-50
                                               focus:outline-none focus:border-orange-400
                                               focus:ring-2 focus:ring-orange-100 transition-all">
                                    <option value="0">-- Chọn danh mục --</option>
                                    @foreach (var cat in ViewBag.Categories as List<Entities.Categories> ?? new())
                                    {
                                        <option value="@cat.Id" @(cat.Id == Model.CategoryId ? "selected" : "")>
                                            @cat.Name
                                        </option>
                                    }
                                </select>
                                @if (ViewData.ModelState["CategoryId"]?.Errors.Any() == true)
                                {
                                    <span class="text-red-500 text-xs mt-1 block">
                                        @ViewData.ModelState["CategoryId"].Errors[0].ErrorMessage
                                    </span>
                                }
                            </div>

                            <!-- Stock -->
                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-2">
                                    Tồn kho
                                </label>
                                <input type="number" id="Stock" name="Stock" value="@Model.Stock"
                                       min="0" placeholder="100"
                                       class="w-full px-4 py-2.5 border border-gray-200 rounded-xl
                                              text-sm text-gray-900 bg-gray-50
                                              focus:outline-none focus:border-orange-400
                                              focus:ring-2 focus:ring-orange-100 transition-all" />
                            </div>

                            <!-- Giá bán -->
                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-2">
                                    Giá bán *
                                </label>
                                <div class="relative">
                                    <input type="text" id="PriceInput" name="PriceInput"
                                           value="@Model.PriceInput" inputmode="numeric"
                                           placeholder="29,990,000" oninput="formatPrice(this)"
                                           class="w-full px-4 py-2.5 pr-8 border border-gray-200 rounded-xl
                                                  text-sm text-gray-900 bg-gray-50
                                                  focus:outline-none focus:border-orange-400
                                                  focus:ring-2 focus:ring-orange-100 transition-all" />
                                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-gray-300 font-extrabold">₫</span>
                                </div>
                                @if (ViewData.ModelState["PriceInput"]?.Errors.Any() == true)
                                {
                                    <span class="text-red-500 text-xs mt-1 block">
                                        @ViewData.ModelState["PriceInput"].Errors[0].ErrorMessage
                                    </span>
                                }
                            </div>

                            <!-- Giá gốc -->
                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-2">
                                    Giá gốc
                                    <span class="text-gray-300 font-normal normal-case tracking-normal">(gạch ngang)</span>
                                </label>
                                <div class="relative">
                                    <input type="text" id="OriginalPriceInput" name="OriginalPriceInput"
                                           value="@Model.OriginalPriceInput" inputmode="numeric"
                                           placeholder="34,990,000" oninput="formatPrice(this)"
                                           class="w-full px-4 py-2.5 pr-8 border border-gray-200 rounded-xl
                                                  text-sm text-gray-900 bg-gray-50
                                                  focus:outline-none focus:border-orange-400
                                                  focus:ring-2 focus:ring-orange-100 transition-all" />
                                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-gray-300 font-extrabold">₫</span>
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="col-span-2">
                                <label class="block text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 mb-2">
                                    Mô tả sản phẩm
                                </label>
                                <textarea id="Description" name="Description" rows="4"
                                          placeholder="Mô tả chi tiết về sản phẩm..."
                                          class="w-full px-4 py-2.5 border border-gray-200 rounded-xl
                                                 text-sm text-gray-900 bg-gray-50
                                                 focus:outline-none focus:border-orange-400
                                                 focus:ring-2 focus:ring-orange-100
                                                 transition-all resize-y">@Model.Description</textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Thông số kỹ thuật -->
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
                        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
                            <div>
                                <p class="text-[10px] font-bold uppercase tracking-[.14em] text-orange-500 mb-0.5">Bước 2</p>
                                <p class="text-[13px] font-extrabold text-gray-900">⚙️ Thông số kỹ thuật</p>
                            </div>
                            <button type="button" onclick="addSpec()"
                                    class="inline-flex items-center gap-1.5 px-3.5 py-2
                                           bg-orange-50 hover:bg-orange-100 text-orange-500
                                           text-[11px] font-extrabold rounded-xl
                                           border border-orange-200 cursor-pointer transition-colors">
                                + Thêm thông số
                            </button>
                        </div>

                        <div class="p-6 space-y-4">
                            <!-- Preset bar -->
                            <div class="flex flex-wrap gap-2 pb-4 border-b border-gray-100">
                                <span class="text-[10px] font-bold uppercase tracking-[.14em] text-gray-400 self-center">
                                    Preset:
                                </span>
                                @foreach (var p in new[] {
                                ("phone","📱 Smartphone"),("laptop","💻 Laptop"),
                                ("tablet","📟 Tablet"),("headphone","🎧 Tai nghe")
                                })
                                {
                                    <button type="button" onclick="loadPreset('@p.Item1')"
                                            class="px-3 py-1.5 bg-orange-50 hover:bg-orange-100
                                                   border border-orange-200 rounded-lg text-orange-500
                                                   text-[11px] font-extrabold cursor-pointer transition-colors">
                                        @p.Item2
                                    </button>
                                }
                                <span class="text-gray-200 self-center">|</span>
                                @foreach (var g in new[] {
                                "Overview","Display","Performance",
                                "Camera","Battery & Charging","Connectivity","Design"
                                })
                                {
                                    <button type="button" onclick="addSpecGroup('@g')"
                                            class="px-3 py-1.5 bg-gray-50 hover:bg-gray-100
                                                   border border-gray-200 rounded-lg
                                                   text-gray-500 text-[11px] font-semibold cursor-pointer transition-colors">
                                        @g
                                    </button>
                                }
                            </div>

                            <!-- Column headers -->
                            <div class="grid grid-cols-12 gap-2 px-3">
                                <div class="col-span-3 text-[10px] font-bold text-gray-300 uppercase tracking-[.14em]">Nhóm</div>
                                <div class="col-span-4 text-[10px] font-bold text-gray-300 uppercase tracking-[.14em]">Thuộc tính</div>
                                <div class="col-span-4 text-[10px] font-bold text-gray-300 uppercase tracking-[.14em]">Giá trị</div>
                            </div>

                            <div id="specsContainer" class="space-y-2"></div>
                            <p id="noSpecsMsg"
                               class="text-center text-gray-300 text-sm py-10
                                      border-2 border-dashed border-gray-100 rounded-2xl">
                                Chọn Preset hoặc bấm "+ Thêm thông số"
                            </p>
                        </div>
                    </div>

                    <!-- Hình ảnh bổ sung -->
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
                        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
                            <div>
                                <p class="text-[10px] font-bold uppercase tracking-[.14em] text-orange-500 mb-0.5">Bước 3</p>
                                <p class="text-[13px] font-extrabold text-gray-900">🖼️ Hình ảnh bổ sung</p>
                            </div>
                            <span class="text-[11px] text-gray-400">Click ô ảnh để upload</span>
                        </div>
                        <div class="p-6">
                            <div id="imagesContainer" class="flex flex-wrap gap-3 min-h-[6rem]"></div>
                        </div>
                    </div>
                </div>

                <!-- RIGHT Sidebar -->
                <div class="space-y-6">

                    <!-- Thumbnail -->
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
                        <div class="px-6 py-4 border-b border-gray-100">
                            <p class="text-[13px] font-extrabold text-gray-900">🖼️ Ảnh đại diện</p>
                        </div>
                        <div class="p-6 space-y-4">
                            <div id="thumbnailPreview"
                                 onclick="document.getElementById('thumbnailFileInput').click()"
                                 class="w-full aspect-square bg-gray-50 border-2 border-dashed
                                        border-gray-200 rounded-2xl flex items-center
                                        justify-center overflow-hidden cursor-pointer
                                        hover:border-orange-400 transition-colors">
                                <div class="text-center text-gray-300">
                                    <div class="text-4xl mb-2">📷</div>
                                    <div class="text-xs font-semibold">Click để chọn ảnh</div>
                                </div>
                            </div>

                            <input type="file" id="thumbnailFileInput" accept="image/*" class="hidden"
                                   onchange="uploadThumbnail(this)" />

                            <div class="relative">
                                <input type="text" id="ThumbnailUrl" name="ThumbnailUrl"
                                       value="@Model.ThumbnailUrl"
                                       placeholder="URL ảnh hoặc upload từ máy"
                                       oninput="previewThumbnail(this.value)"
                                       class="w-full px-4 py-2.5 pr-20 border border-gray-200 rounded-xl
                                              text-xs text-gray-900 bg-gray-50
                                              focus:outline-none focus:border-orange-400
                                              focus:ring-2 focus:ring-orange-100 transition-all" />
                                <button type="button"
                                        onclick="document.getElementById('thumbnailFileInput').click()"
                                        class="absolute right-2 top-1/2 -translate-y-1/2
                                               px-2.5 py-1 bg-orange-50 hover:bg-orange-100
                                               border border-orange-200 rounded-lg text-orange-500
                                               text-[10px] font-extrabold cursor-pointer transition-colors">
                                    📁 Upload
                                </button>
                            </div>

                            <div id="thumbnailStatus" class="hidden">
                                <div class="flex items-center gap-2 p-2.5 bg-orange-50
                                            rounded-xl border border-orange-200">
                                    <div style="animation:spin 1s linear infinite;font-size:14px;">⏳</div>
                                    <span id="thumbnailStatusText" class="text-xs text-orange-500 font-semibold">
                                        Đang tải lên...
                                    </span>
                                </div>
                            </div>

                            <p class="text-[11px] text-gray-300 text-center">JPG, PNG, WebP — tối đa 5MB</p>
                        </div>
                    </div>

                    <!-- Trạng thái -->
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
                        <div class="px-6 py-4 border-b border-gray-100">
                            <p class="text-[13px] font-extrabold text-gray-900">📌 Trạng thái</p>
                        </div>
                        <div class="p-6 space-y-5">

                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-extrabold text-gray-900">Kích hoạt</p>
                                    <p class="text-xs text-gray-400 mt-0.5">Hiển thị trên store</p>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="IsActive" name="IsActive"
                                           value="true" @(Model.IsActive ? "checked" : "")
                                           class="sr-only peer" />
                                    <div class="w-11 h-6 bg-gray-200 rounded-full
                                                peer peer-checked:bg-orange-500
                                                after:content-[''] after:absolute
                                                after:top-[2px] after:left-[2px]
                                                after:bg-white after:rounded-full
                                                after:h-5 after:w-5 after:transition-all
                                                peer-checked:after:translate-x-full
                                                cursor-pointer"></div>
                                </label>
                            </div>

                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-extrabold text-gray-900">Nổi bật</p>
                                    <p class="text-xs text-gray-400 mt-0.5">Hiển thị trang chủ</p>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="IsFeatured" name="IsFeatured"
                                           value="true" @(Model.IsFeatured ? "checked" : "")
                                           class="sr-only peer" />
                                    <div class="w-11 h-6 bg-gray-200 rounded-full
                                                peer peer-checked:bg-orange-500
                                                after:content-[''] after:absolute
                                                after:top-[2px] after:left-[2px]
                                                after:bg-white after:rounded-full
                                                after:h-5 after:w-5 after:transition-all
                                                peer-checked:after:translate-x-full
                                                cursor-pointer"></div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Tóm tắt -->
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
                        <div class="px-6 py-4 border-b border-gray-100">
                            <p class="text-[13px] font-extrabold text-gray-900">📊 Tóm tắt</p>
                        </div>
                        <div class="p-6 space-y-1">
                            <div class="flex justify-between items-center py-2.5 border-b border-gray-50">
                                <span class="text-xs text-gray-400 font-semibold">Thông số</span>
                                <span id="specCount"
                                      class="font-extrabold bg-orange-50 text-orange-500
                                             px-2.5 py-0.5 rounded-full text-xs">0</span>
                            </div>
                            <div class="flex justify-between items-center py-2.5">
                                <span class="text-xs text-gray-400 font-semibold">Hình ảnh</span>
                                <span id="imageCount"
                                      class="font-extrabold bg-orange-50 text-orange-500
                                             px-2.5 py-0.5 rounded-full text-xs">0</span>
                            </div>
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full py-3.5 bg-orange-500 hover:bg-orange-600 rounded-2xl
                                   text-white font-extrabold text-sm transition-colors
                                   border-none cursor-pointer shadow-[0_4px_14px_rgba(249,115,22,.32)]">
                        💾 Lưu sản phẩm
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <style>
        @@keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }
    </style>
    <script>
        var specIndex = 0;
        var imageIndex = 0;
        var token = '';

        document.addEventListener('DOMContentLoaded', function () {
            token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

            var dl = document.createElement('datalist');
            dl.id = 'groupList';
            ['Overview', 'Display', 'Performance', 'Camera',
                'Battery and Charging', 'Connectivity', 'Design', 'Audio', 'Features']
                .forEach(function (g) {
                    var o = document.createElement('option'); o.value = g; dl.appendChild(o);
                });
            document.body.appendChild(dl);

            addImage();
            updateCounts();
        });

        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('productForm').addEventListener('submit', function () {
                ['PriceInput', 'OriginalPriceInput'].forEach(function (name) {
                    var el = document.querySelector('input[name="' + name + '"]');
                    if (el) el.value = el.value.replace(/,/g, '');
                });
            });
        });

        var presets = {
            phone: [
                { group: 'Overview', key: 'Brand', value: '' }, { group: 'Overview', key: 'Model', value: '' },
                { group: 'Overview', key: 'Operating System', value: '' },
                { group: 'Display', key: 'Screen Size', value: '' }, { group: 'Display', key: 'Resolution', value: '' },
                { group: 'Display', key: 'Refresh Rate', value: '' },
                { group: 'Performance', key: 'Processor', value: '' }, { group: 'Performance', key: 'RAM', value: '' },
                { group: 'Performance', key: 'Storage', value: '' },
                { group: 'Camera', key: 'Rear Camera', value: '' }, { group: 'Camera', key: 'Front Camera', value: '' },
                { group: 'Battery and Charging', key: 'Battery Capacity', value: '' },
                { group: 'Battery and Charging', key: 'Charging Technology', value: '' },
                { group: 'Connectivity', key: '5G / 4G', value: '' }, { group: 'Connectivity', key: 'WiFi', value: '' },
                { group: 'Connectivity', key: 'Bluetooth', value: '' },
                { group: 'Design', key: 'Dimensions', value: '' }, { group: 'Design', key: 'Weight', value: '' },
                { group: 'Design', key: 'Colors', value: '' }
            ],
            laptop: [
                { group: 'Overview', key: 'Brand', value: '' }, { group: 'Overview', key: 'Model', value: '' },
                { group: 'Overview', key: 'Operating System', value: '' },
                { group: 'Display', key: 'Screen Size', value: '' }, { group: 'Display', key: 'Resolution', value: '' },
                { group: 'Display', key: 'Panel Type', value: '' },
                { group: 'Performance', key: 'CPU', value: '' }, { group: 'Performance', key: 'RAM', value: '' },
                { group: 'Performance', key: 'Storage', value: '' }, { group: 'Performance', key: 'GPU', value: '' },
                { group: 'Battery and Charging', key: 'Battery Capacity', value: '' },
                { group: 'Connectivity', key: 'Ports', value: '' }, { group: 'Connectivity', key: 'WiFi', value: '' },
                { group: 'Design', key: 'Weight', value: '' }
            ],
            tablet: [
                { group: 'Overview', key: 'Brand', value: '' },
                { group: 'Display', key: 'Screen Size', value: '' }, { group: 'Display', key: 'Resolution', value: '' },
                { group: 'Performance', key: 'Processor', value: '' }, { group: 'Performance', key: 'RAM', value: '' },
                { group: 'Performance', key: 'Storage', value: '' },
                { group: 'Camera', key: 'Rear Camera', value: '' },
                { group: 'Battery and Charging', key: 'Battery Capacity', value: '' },
                { group: 'Connectivity', key: 'Connectivity', value: '' }
            ],
            headphone: [
                { group: 'Overview', key: 'Type', value: '' }, { group: 'Overview', key: 'Connection', value: '' },
                { group: 'Audio', key: 'Driver Size', value: '' }, { group: 'Audio', key: 'Frequency Response', value: '' },
                { group: 'Audio', key: 'Impedance', value: '' },
                { group: 'Features', key: 'Noise Cancellation (ANC)', value: '' },
                { group: 'Features', key: 'Battery Life', value: '' }, { group: 'Features', key: 'Water Resistance', value: '' },
                { group: 'Design', key: 'Weight', value: '' }
            ]
        };

        function formatPrice(input) {
            var raw = input.value.replace(/[^0-9]/g, '');
            input.value = raw ? parseInt(raw, 10).toLocaleString('en-US') : '';
        }

        function loadPreset(type) {
            if (!presets[type]) return;
            document.getElementById('specsContainer').innerHTML = '';
            specIndex = 0;
            presets[type].forEach(function (s) { addSpecRow(s.group, s.key, s.value); });
            updateCounts();
        }

        function addSpec() { addSpecRow('', '', ''); }
        function addSpecGroup(group) { addSpecRow(group, '', ''); }

        function addSpecRow(group, key, value) {
            var i = specIndex++;
            var div = document.createElement('div');
            div.id = 'spec-' + i;
            div.className = 'grid grid-cols-12 gap-2 items-center p-2.5 bg-gray-50 ' +
                'rounded-xl border border-gray-100 group hover:border-gray-200 transition-colors';
            var inputCls = 'w-full px-3 py-2 border border-gray-200 rounded-lg ' +
                'text-xs text-gray-900 bg-white focus:outline-none focus:border-orange-400 transition-all';
            div.innerHTML =
                '<div class="col-span-3"><input type="text" name="Specs[' + i + '].GroupName" value="' + h(group) + '" ' +
                'placeholder="Group" list="groupList" class="' + inputCls + '" /></div>' +
                '<div class="col-span-4"><input type="text" name="Specs[' + i + '].SpecKey" value="' + h(key) + '" ' +
                'placeholder="Attribute" class="' + inputCls + '" /></div>' +
                '<div class="col-span-4"><input type="text" name="Specs[' + i + '].SpecValue" value="' + h(value) + '" ' +
                'placeholder="Value" class="' + inputCls + '" /></div>' +
                '<div class="col-span-1 flex justify-center">' +
                '<button type="button" onclick="removeSpec(' + i + ')" ' +
                'class="w-7 h-7 bg-red-50 hover:bg-red-100 rounded-lg text-red-400 ' +
                'border-none cursor-pointer font-bold text-base transition-colors ' +
                'opacity-0 group-hover:opacity-100">×</button></div>';
            document.getElementById('specsContainer').appendChild(div);
            updateCounts();
        }

        function removeSpec(i) {
            var el = document.getElementById('spec-' + i);
            if (el) el.remove();
            updateCounts();
        }

        function addImage() {
            var i = imageIndex++;
            var div = document.createElement('div');
            div.id = 'image-' + i;
            div.className = 'relative w-24 h-24 rounded-xl overflow-hidden flex-shrink-0 ' +
                'border-2 border-dashed border-gray-200 bg-gray-50 cursor-pointer ' +
                'hover:border-orange-400 transition-colors';
            div.innerHTML =
                '<input type="file" id="fileInput-' + i + '" accept="image/*" class="hidden" ' +
                'onchange="uploadImageFile(this,' + i + ')" />' +
                '<input type="hidden" name="ImageUrls[' + i + ']" id="urlInput-' + i + '" />' +
                '<div id="imgPreview-' + i + '" onclick="triggerImgUpload(' + i + ')" ' +
                'class="w-full h-full flex flex-col items-center justify-center text-gray-300 select-none">' +
                '<span class="text-3xl leading-none">📷</span>' +
                '<span class="text-[10px] text-gray-300 mt-1 font-semibold">Thêm ảnh</span></div>' +
                '<button type="button" id="removeBtn-' + i + '" onclick="removeImage(' + i + ')" ' +
                'class="absolute top-1 right-1 w-5 h-5 bg-red-500 text-white rounded-full ' +
                'text-xs font-bold border-none cursor-pointer hidden items-center justify-center z-10">×</button>' +
                '<div id="spinner-' + i + '" class="absolute inset-0 bg-white/70 hidden items-center justify-center text-orange-500 text-2xl">⏳</div>';
            document.getElementById('imagesContainer').appendChild(div);
            updateCounts();
        }

        function removeImage(i) {
            var el = document.getElementById('image-' + i);
            if (el) el.remove();
            ensureEmptySlot();
            updateCounts();
        }

        function triggerImgUpload(i) {
            var el = document.getElementById('fileInput-' + i);
            if (el) el.click();
        }

        function ensureEmptySlot() {
            var container = document.getElementById('imagesContainer');
            var empties = Array.from(container.children).filter(function (el) {
                var hidden = el.querySelector('input[type=hidden]');
                return hidden && !hidden.value;
            });
            if (empties.length === 0) addImage();
        }

        async function uploadImageFile(input, i) {
            var file = input.files[0];
            if (!file) return;
            var spinner = document.getElementById('spinner-' + i);
            var preview = document.getElementById('imgPreview-' + i);
            var urlInput = document.getElementById('urlInput-' + i);
            var removeBtn = document.getElementById('removeBtn-' + i);
            if (spinner) { spinner.classList.remove('hidden'); spinner.classList.add('flex'); }
            var fd = new FormData();
            fd.append('file', file);
            try {
                var res = await fetch('/Admin/Product/UploadImage', {
                    method: 'POST', headers: { 'RequestVerificationToken': token }, body: fd
                });
                var data = await res.json();
                if (spinner) { spinner.classList.add('hidden'); spinner.classList.remove('flex'); }
                if (data.success) {
                    urlInput.value = data.url;
                    preview.innerHTML = '<img src="' + data.url + '" class="w-full h-full object-cover" onclick="triggerImgUpload(' + i + ')" />';
                    if (removeBtn) { removeBtn.classList.remove('hidden'); removeBtn.classList.add('flex'); }
                    var wrapper = document.getElementById('image-' + i);
                    if (wrapper) { wrapper.style.borderStyle = 'solid'; wrapper.style.borderColor = '#fdba74'; }
                    addImage();
                } else {
                    if (preview) preview.innerHTML = '<span class="text-red-400 text-2xl">❌</span>';
                    alert('Upload thất bại: ' + data.message);
                }
            } catch (err) {
                if (spinner) { spinner.classList.add('hidden'); spinner.classList.remove('flex'); }
                if (preview) preview.innerHTML = '<span class="text-red-400 text-2xl">❌</span>';
                alert('Lỗi: ' + err.message);
            } finally { input.value = ''; }
        }

        async function uploadThumbnail(input) {
            var file = input.files[0];
            if (!file) return;
            var preview = document.getElementById('thumbnailPreview');
            var urlInput = document.getElementById('ThumbnailUrl');
            var status = document.getElementById('thumbnailStatus');
            var statusTxt = document.getElementById('thumbnailStatusText');
            preview.innerHTML = '<div class="text-center text-orange-500"><div style="font-size:32px;animation:spin 1s linear infinite;">⏳</div><div class="text-xs mt-1.5">Đang tải lên...</div></div>';
            if (status) status.classList.remove('hidden');
            if (statusTxt) statusTxt.textContent = 'Đang tải ' + file.name + '...';
            var fd = new FormData();
            fd.append('file', file);
            try {
                var res = await fetch('/Admin/Product/UploadImage', {
                    method: 'POST', headers: { 'RequestVerificationToken': token }, body: fd
                });
                var data = await res.json();
                if (status) status.classList.add('hidden');
                if (data.success) {
                    urlInput.value = data.url;
                    previewThumbnail(data.url);
                    showToast('✅ Upload thành công: ' + file.name, 'green');
                } else {
                    preview.innerHTML = '<div class="text-center text-red-400 p-4"><div class="text-3xl mb-2">❌</div><div class="text-xs">' + data.message + '</div></div>';
                }
            } catch (err) {
                if (status) status.classList.add('hidden');
                preview.innerHTML = '<div class="text-center text-red-400 p-4"><div class="text-3xl mb-2">❌</div><div class="text-xs">Lỗi kết nối</div></div>';
            } finally { input.value = ''; }
        }

        function previewThumbnail(url) {
            var preview = document.getElementById('thumbnailPreview');
            if (!preview) return;
            preview.innerHTML = url
                ? '<img src="' + url + '" class="w-full h-full object-cover" />'
                : '<div class="text-center text-gray-300"><div class="text-4xl mb-2">📷</div><div class="text-xs font-semibold">Click để chọn ảnh</div></div>';
        }

        function updateCounts() {
            var container = document.getElementById('imagesContainer');
            var filled = Array.from(container.children).filter(function (el) {
                var hidden = el.querySelector('input[type=hidden]');
                return hidden && hidden.value;
            }).length;
            var sc = document.getElementById('specsContainer').children.length;
            document.getElementById('specCount').textContent = sc;
            document.getElementById('imageCount').textContent = filled;
            document.getElementById('noSpecsMsg').style.display = sc > 0 ? 'none' : 'block';
        }

        function h(s) {
            if (!s) return '';
            return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;')
                .replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function showToast(msg, color) {
            var t = document.createElement('div');
            var isGreen = color === 'green';
            t.className = 'fixed bottom-6 right-6 z-[99999] px-5 py-3 rounded-2xl text-xs font-bold ' +
                'shadow-xl transition-opacity ' +
                (isGreen ? 'bg-green-50 text-green-700 border border-green-200'
                    : 'bg-red-50 text-red-600 border border-red-200');
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(function () { t.style.opacity = '0'; }, 3000);
            setTimeout(function () { t.remove(); }, 3400);
        }
    </script>
}