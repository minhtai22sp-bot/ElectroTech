@{
    ViewData["Title"] = "Quản lý đánh giá";
    Layout = "~/Areas/Admin/Views/Admin/_LayoutAdmin.cshtml";
}

@Html.AntiForgeryToken()

<div style="padding:0;width:100%;">

    <!-- Header -->
    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;">
        <div>
            <p style="font-size:10px;font-weight:700;text-transform:uppercase;
                      letter-spacing:.2em;color:#f97316;margin:0 0 4px;">Admin Panel</p>
            <h1 style="font-size:1.6rem;font-weight:900;color:#111;margin:0 0 4px;letter-spacing:-.02em;">
                Quản lý đánh giá
            </h1>
            <p style="font-size:13px;color:#9ca3af;margin:0;">Duyệt, ẩn và xóa đánh giá sản phẩm</p>
        </div>
    </div>

    <!-- Stat cards -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px;">
        <div style="background:#fff;border:1px solid #f0f0ee;border-radius:14px;padding:14px 16px;">
            <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#bbb;margin:0 0 5px;">Tất cả</p>
            <p id="statAll" style="font-size:1.3rem;font-weight:900;color:#111;margin:0;">—</p>
        </div>
        <div style="background:#fff;border:1px solid #f0f0ee;border-radius:14px;padding:14px 16px;">
            <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#bbb;margin:0 0 5px;">Đã duyệt</p>
            <p id="statApproved" style="font-size:1.3rem;font-weight:900;color:#16a34a;margin:0;">—</p>
        </div>
        <div style="background:#fff;border:1px solid #f0f0ee;border-radius:14px;padding:14px 16px;">
            <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#bbb;margin:0 0 5px;">Chờ duyệt</p>
            <p id="statPending" style="font-size:1.3rem;font-weight:900;color:#f59e0b;margin:0;">—</p>
        </div>
    </div>

    <!-- Filter tabs -->
    <div style="display:flex;gap:8px;margin-bottom:16px;">
        @foreach (var tab in new (string Val, string Label, string Color)[]
        {
        ("all",      "Tất cả",    "#1f2937"),
        ("approved", "Đã duyệt",  "#16a34a"),
        ("pending",  "Chờ duyệt", "#f59e0b"),
        })
        {
            <button onclick="filterTab('@tab.Val')"
                    id="tab-@tab.Val"
                    data-color="@tab.Color"
                    class="tab-btn"
                    style="padding:6px 16px;border-radius:10px;font-size:12px;font-weight:700;
                           cursor:pointer;border:1.5px solid #e5e7eb;background:#fff;
                           color:#6b7280;transition:all .15s;">
                @tab.Label
            </button>
        }
    </div>

    <!-- Table Card -->
    <div style="background:#fff;border:1px solid #e5e7eb;border-radius:16px;overflow:hidden;">

        <!-- Toolbar -->
        <div style="display:flex;align-items:center;justify-content:space-between;
                    padding:16px 20px;border-bottom:1px solid #f3f4f6;">
            <div style="position:relative;width:320px;">
                <i data-lucide="search" style="position:absolute;left:12px;top:50%;
                   transform:translateY(-50%);width:15px;height:15px;color:#9ca3af;"></i>
                <input id="searchInput" type="text" placeholder="Tìm sản phẩm, người dùng..."
                       style="width:100%;padding:8px 12px 8px 36px;font-size:13px;
                              border:1px solid #e5e7eb;border-radius:10px;background:#f9fafb;
                              color:#374151;outline:none;" />
            </div>
            <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:#9ca3af;font-weight:600;">
                <i data-lucide="arrow-down-narrow-wide" style="width:14px;height:14px;"></i>
                Mới nhất trước
            </div>
        </div>

        <!-- Table -->
        <div style="overflow-x:auto;width:100%;">
            <table id="reviewsTable" style="width:100%;text-align:left;font-size:12px;color:#4b5563;border-collapse:collapse;">
                <thead>
                    <tr style="background:#f9fafb;border-bottom:1px solid #f3f4f6;">
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;white-space:nowrap;">Sản phẩm</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;white-space:nowrap;">Người mua</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;text-align:center;white-space:nowrap;">Sao</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;white-space:nowrap;">Nội dung</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;text-align:center;white-space:nowrap;">Trạng thái</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;white-space:nowrap;">Ngày</th>
                        <th style="padding:12px 20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;text-align:right;white-space:nowrap;">Thao tác</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <style>
        #reviewsTable_wrapper .dataTables_length,
        #reviewsTable_wrapper .dataTables_filter {
            display: none;
        }

        #reviewsTable_wrapper .dataTables_info {
            font-size: 12px;
            color: #9ca3af;
            padding: 14px 20px;
        }

        #reviewsTable_wrapper .dataTables_paginate {
            padding: 14px 20px;
            display: flex;
            justify-content: flex-end;
            gap: 4px;
        }

        #reviewsTable_wrapper .paginate_button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 32px;
            height: 32px;
            padding: 0 8px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #6b7280;
            cursor: pointer;
            transition: all .15s;
        }

            #reviewsTable_wrapper .paginate_button:hover {
                background: #fff7ed;
                color: #f97316;
            }

            #reviewsTable_wrapper .paginate_button.current {
                background: #f97316 !important;
                color: #fff !important;
                border: none !important;
            }

            #reviewsTable_wrapper .paginate_button.disabled {
                opacity: .35;
                cursor: not-allowed;
            }

        #reviewsTable_wrapper .dataTables_info,
        #reviewsTable_wrapper .dataTables_paginate {
            border-top: 1px solid #f3f4f6;
        }

        #reviewsTable_wrapper > div:last-child {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        #reviewsTable tbody tr {
            border-bottom: 1px solid #f9fafb;
            transition: background .12s;
        }

            #reviewsTable tbody tr:hover td {
                background: #fffbf7;
            }

        #reviewsTable thead th {
            border-bottom: none !important;
        }

        #reviewsTable td, #reviewsTable th {
            white-space: nowrap;
        }

        #reviewsTable_wrapper {
            width: 100% !important;
        }

        .dataTables_wrapper {
            width: 100% !important;
        }
    </style>

    <script>
        var token = $('input[name="__RequestVerificationToken"]').first().val();
        var table;
        var currentFilter = 'all';

        function parseDateSort(d) {
            if (!d) return '';
            const parts = d.trim().split(' ');
            const dp = parts[0].split('/');
            if (dp.length !== 3) return d;
            return `${dp[2]}-${dp[1]}-${dp[0]} ${parts[1] || '00:00'}`;
        }

        function stars(rating) {
            let s = '';
            for (let i = 1; i <= 5; i++)
                s += `<span style="color:${i <= rating ? '#f59e0b' : '#e5e7eb'};font-size:14px;">★</span>`;
            return `<div style="display:flex;justify-content:center;gap:1px;">${s}</div>`;
        }

        $(document).ready(function () {
            lucide.createIcons();
            table = $('#reviewsTable').DataTable({
                processing: false,
                serverSide: false,
                ajax: {
                    url: '@Url.Action("LoadAll", "Reviews", new { area = "Admin" })',
                    type: 'POST',
                    contentType: 'application/x-www-form-urlencoded',
                    headers: { 'RequestVerificationToken': token },
                    dataSrc: function (json) {
                        const data = json.data || [];
                        document.getElementById('statAll').textContent = data.length;
                        document.getElementById('statApproved').textContent = data.filter(r => r.isApproved).length;
                        document.getElementById('statPending').textContent = data.filter(r => !r.isApproved).length;
                        return data;
                    }
                },
                order: [[5, 'desc']],
                columns: [
                    {
                        data: 'productName',
                        render: d => `<span style="font-weight:700;color:#111;font-size:12px;
                                                max-width:160px;display:block;overflow:hidden;
                                                text-overflow:ellipsis;" title="${d}">${d}</span>`
                    },
                    {
                        data: 'userName',
                        render: d => `<span style="color:#374151;font-size:12px;">${d || '—'}</span>`
                    },
                    {
                        data: 'rating',
                        className: 'text-center',
                        render: (d, type) => type === 'sort' ? d : stars(d)
                    },
                    {
                        data: null,
                        render: (d, t, row) => {
                            const title = row.title ? `<p style="font-weight:700;color:#111;font-size:12px;margin:0 0 2px;">${row.title}</p>` : '';
                            const comment = (row.comment || '—').length > 80
                                ? row.comment.substring(0, 80) + '...' : (row.comment || '—');
                            return `<div style="max-width:260px;">
                                                ${title}
                                                <p style="color:#9ca3af;font-size:11px;margin:0;">${comment}</p>
                                            </div>`;
                        }
                    },
                    {
                        data: 'isApproved',
                        className: 'text-center',
                        render: d => d
                            ? `<span style="display:inline-flex;align-items:center;gap:5px;padding:3px 10px;
                                          border-radius:100px;font-size:11px;font-weight:700;
                                          background:#f0fdf4;color:#15803d;">
                                          <span style="width:5px;height:5px;border-radius:50%;background:#16a34a;display:inline-block;"></span>
                                          Đã duyệt</span>`
                            : `<span style="display:inline-flex;align-items:center;gap:5px;padding:3px 10px;
                                          border-radius:100px;font-size:11px;font-weight:700;
                                          background:#fffbeb;color:#b45309;">
                                          <span style="width:5px;height:5px;border-radius:50%;background:#f59e0b;display:inline-block;"></span>
                                          Chờ duyệt</span>`
                    },
                    {
                        data: 'createdOn',
                        render: (d, type) => {
                            if (type === 'sort' || type === 'type') return parseDateSort(d);
                            return `<span style="color:#9ca3af;font-size:11px;">${d}</span>`;
                        }
                    },
                    {
                        data: null, orderable: false,
                        render: (d, t, row) => {
                            const approveBtn = !row.isApproved
                                ? `<button onclick="approveReview(${row.id})"
                                                   style="padding:5px 10px;background:#f0fdf4;border:1px solid #bbf7d0;
                                                          border-radius:8px;color:#15803d;font-size:11px;font-weight:700;cursor:pointer;">
                                                       ✓ Duyệt
                                                   </button>` : '';
                            const rejectBtn = row.isApproved
                                ? `<button onclick="rejectReview(${row.id})"
                                                   style="padding:5px 10px;background:#fffbeb;border:1px solid #fde68a;
                                                          border-radius:8px;color:#b45309;font-size:11px;font-weight:700;cursor:pointer;">
                                                       Ẩn
                                                   </button>` : '';
                            return `<div style="display:flex;align-items:center;justify-content:flex-end;gap:6px;">
                                                <a href="/Admin/Reviews/Detail/${row.id}"
                                                   style="padding:5px 10px;background:#fff7ed;border:1px solid #fed7aa;
                                                          border-radius:8px;color:#f97316;font-size:11px;font-weight:700;
                                                          text-decoration:none;white-space:nowrap;">
                                                    Chi tiết
                                                </a>
                                                ${approveBtn}${rejectBtn}
                                                <button onclick="deleteReview(${row.id})"
                                                        style="padding:5px 10px;background:#fef2f2;border:1px solid #fecaca;
                                                               border-radius:8px;color:#b91c1c;font-size:11px;font-weight:700;cursor:pointer;">
                                                    Xóa
                                                </button>
                                            </div>`;
                        }
                    }
                ],
                language: {
                    processing: '',
                    info: 'Hiển thị _START_ – _END_ / _TOTAL_ đánh giá',
                    infoEmpty: 'Không có dữ liệu',
                    zeroRecords: 'Không tìm thấy kết quả',
                    paginate: { next: '›', previous: '‹', first: '«', last: '»' }
                },
                columnDefs: [
                    { targets: 0, width: '160px' },
                    { targets: 1, width: '120px' },
                    { targets: 2, width: '90px' },
                    { targets: 3, width: '260px' },
                    { targets: 4, width: '110px' },
                    { targets: 5, width: '120px' },
                    { targets: 6, width: '180px', orderable: false },
                ],
                autoWidth: false,
                drawCallback: function () { lucide.createIcons(); }
            });

            $('#searchInput').on('keyup', function () { table.search(this.value).draw(); });

            // Active tab mặc định
            filterTab('all');
        });

        function filterTab(filter) {
            currentFilter = filter;
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.style.background = '#fff';
                b.style.color = '#6b7280';
                b.style.borderColor = '#e5e7eb';
            });
            const active = document.getElementById('tab-' + filter);
            if (active) {
                active.style.background = active.dataset.color;
                active.style.color = '#fff';
                active.style.borderColor = active.dataset.color;
            }
            if (filter === 'all') table.column(4).search('').draw();
            else if (filter === 'approved') table.column(4).search('Đã duyệt').draw();
            else table.column(4).search('Chờ duyệt').draw();
        }

        async function approveReview(id) {
            try {
                const res = await $.post({ url: '/Admin/Reviews/Approve', data: { id }, headers: { 'RequestVerificationToken': token } });
                if (res.success) table.ajax.reload(null, false);
                else alert(res.message);
            } catch (e) { alert('Lỗi: ' + e.statusText); }
        }

        async function rejectReview(id) {
            try {
                const res = await $.post({ url: '/Admin/Reviews/Reject', data: { id }, headers: { 'RequestVerificationToken': token } });
                if (res.success) table.ajax.reload(null, false);
                else alert(res.message);
            } catch (e) { alert('Lỗi: ' + e.statusText); }
        }

        function deleteReview(id) {
            if (!confirm('Xóa đánh giá này?')) return;
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Admin/Reviews/Delete';
            form.innerHTML = `<input name="id" value="${id}" /><input name="__RequestVerificationToken" value="${token}" />`;
            document.body.appendChild(form);
            form.submit();
        }
    </script>
}